    (hro1 : rOff.toNat ≤ sEnd.memory.size)
    (hretbelow : rOff.toNat + rSz.toNat ≤ (lg.foldl
        (fun acc x => (acc.1 ++ (gp x.1 acc.2).1, (gp x.1 acc.2).2)) ([], ps0)).2.alloc.fnEom)
    (hfnEom0 : (lg.foldl (fun acc x => (acc.1 ++ (gp x.1 acc.2).1, (gp x.1 acc.2).2))
