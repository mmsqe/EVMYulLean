               { (callWriteback out rOff.toNat rSz.toNat success newAccs ret sEnd) with instIdx := front.length + 1 })
               { (callWriteback out rOff.toNat rSz.toNat success newAccs ret sEnd) with instIdx := front.length + 1 })) as' := by
