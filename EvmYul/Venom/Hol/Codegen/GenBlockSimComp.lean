  obtain ⟨hbpre, hbcall⟩ := asmBlockAt_append hbCallSeg
  obtain ⟨asMid, hbrun, hbrel, hbpc, hbsd, hbsv⟩ :=
    genBlockPrefixBodyHSVP_sim_inv 7 l gp lg front S0 M0 ps0 vs0 sEnd as0
