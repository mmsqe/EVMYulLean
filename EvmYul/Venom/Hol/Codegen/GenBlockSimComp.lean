    ∃ (h1 : pcOfLabel (asmResolve (executePlan ops)).1 bb.label + (executePlan ([StackOp.SOLabel bb.label] ++ (lg.foldl
          (fun acc x => (acc.1 ++ (gp x.1 acc.2).1, (gp x.1 acc.2).2))
