      obtain ⟨ww, hww⟩ := hsd.defined z (by rw [hstack0]; exact h)
      exact ⟨ww, by rw [lookupVar_updateVar_ne vs out z val hzout]; exact hww⟩
    · injection h with h'
      exact ⟨val, by rw [h']; exact lookupVar_updateVar_self vs out val⟩

