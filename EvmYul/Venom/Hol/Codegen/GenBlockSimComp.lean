theorem genBlockSimulation_regularHN_stop_entry
    {ctx : VenomContext} {bb : BasicBlock} {vs : VenomState}
    {offsetToPc : AssocList Nat Nat} {prog : List AsmInst} {labelOffsets : AssocList String Nat}
