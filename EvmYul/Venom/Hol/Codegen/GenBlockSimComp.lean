  have hthread' : execBodyThread front 0 { vs0 with instIdx := 0 } = some sEnd := by
    rw [← hvs0]; exact hthread
  refine ⟨runBlock_ok ctx bb extraFuel front term hd tl vs0 sEnd (jumpTo ifZ sEnd)
