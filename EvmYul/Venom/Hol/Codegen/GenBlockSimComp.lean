    (bodyLen : Nat)
    (hbodyLenEq : bodyLen = (executePlan ([StackOp.SOLabel l] ++ ((body.zipIdx 0).foldl
        (fun acc z => (acc.1 ++
          ((fun (w : Instruction × Nat) (p : PlanState) =>
            generateRegularInstPlan liveness dfg cfg fn w.1 nextLiveness false true curBbLabel p) z acc.2).1,
