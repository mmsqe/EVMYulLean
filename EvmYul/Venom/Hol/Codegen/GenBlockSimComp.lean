    (hsd0 : StackDiscH ((body.zipIdx 0).flatMap outsOf).length ps0 { vs with instIdx := 0 })
    (hsv0 : StackIsVars S0 ps0)
    (hrel0 : venomAsmRel labelOffsets ps0 { vs with instIdx := 0 } asm)
