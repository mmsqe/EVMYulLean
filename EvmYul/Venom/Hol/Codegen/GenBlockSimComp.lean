    change Operand.Var z ∈ ps.stack ++ [Operand.Var out] at hz
    by_cases hzo : z = out
    · exact ⟨addrOrZero, by rw [hzo]; exact lookupVar_updateVar_self _ _ _⟩
    · rcases List.mem_append.mp hz with h | h
