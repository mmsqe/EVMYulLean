theorem genBlockSimulation_faulting {ctx : VenomContext} {bb : BasicBlock} {vs as : _}
    {offsetToPc : AssocList Nat Nat} {blockOps : List StackOp}
    {labelOffsets : AssocList String Nat} {ps' : PlanState}
