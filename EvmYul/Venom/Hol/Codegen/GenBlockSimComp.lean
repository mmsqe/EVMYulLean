    (hlivey : nextLiveness.contains y = true)
    (hmemsafe : ∀ (p : PlanState) (v : VenomState) (s : AsmState) (w : bytes32),
        venomAsmRel lo p v s → lookupVar x v = some w →
        w.toNat ≤ v.memory.size ∧ ((w.toNat + 32 + 31) / 32) * 32 ≤ s.memory.size ∧
