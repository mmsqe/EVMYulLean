      (executePlan ([StackOp.SOLabel bb.label] ++ (cleanOps ++ bodyOps)))
      ([AsmInst.AsmPushLabel target, AsmInst.AsmOp "JUMP"] ++ executePlan tailOps)
      (fun a ha lbl => (hlblfree cleanOps ps2 bodyOps ps_body hbody a ha).1 lbl)
