  exact stackDiscHS_commBinop_valspilled_preserve (idx := idx) hsd hmemmono hname hcomm
    hops houts hxy hoy hstack0 hlive hspill_y hlivey hnospill_x hlivex hdepth_x hsmall_x hfresh
    ⟨wy, hwy⟩ hstepEq hoptnoop

