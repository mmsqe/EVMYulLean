    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan jmpStopFn 0 0).get!.1) (psFinal := (generateFnPlan jmpStopFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ ?_
  case _ =>
    -- hrun0
