    · -- next : REVERT %s %o, with SYMBOLIC operands
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm hwN
      have hpc5 : asm.pc = 5 := by rw [hpc_asm]; exact t32_next_pc
      obtain ⟨hs, ho⟩ := hvarS hlbl
