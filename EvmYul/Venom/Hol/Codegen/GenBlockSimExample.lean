      | 1 => exact Or.inl ⟨"out of fuel", by simp [runBlock, evalPhis, phiPrefixLength, execBlock,
               getInstruction, tEntry, tS, tO, stepInstBase, execRead0, isTerminator]⟩
      | (j+2) =>
