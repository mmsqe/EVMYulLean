     | _ => True) := by
  have hfnready : ∀ bb ∈ addStopFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [addStopFn, List.mem_singleton] at hbb; subst hbb
