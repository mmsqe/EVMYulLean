      psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
    rcases hbb2 with hbb | hbb <;> subst hbb
    · -- entry block: JMP recipe — discharged by the GENERIC empty-body slice, not inline
      have hlbl : s.currentBb = "entry" := hlbleq
