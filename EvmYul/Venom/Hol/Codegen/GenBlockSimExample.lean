    (hN : bodyLen + emitLen + 1 ≤ N) :
    ∃ (as' : AsmState) (ps' : PlanState) (vs' : VenomState) (bodyLen' : Nat),
      runAsm bodyLen' offsetToPc prog as0 = AsmResult.AsmOK as'
