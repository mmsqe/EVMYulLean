    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, jmpEntryBB, jmpInst]
    · simp [runBlock, evalPhis, execBlock, stopNextBB, stopInst]
  case _ =>
    -- hsupply
    intro bb hbb s asm N k hE hlbleq
