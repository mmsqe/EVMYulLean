    (match runContext 10 sgvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ sgvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [sgvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [sgvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
