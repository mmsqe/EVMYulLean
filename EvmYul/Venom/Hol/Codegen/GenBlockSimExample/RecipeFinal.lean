      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [gtvCvA, gtvCvB, gtvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof gtvCtx gtvEntry 1 [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA
               [gtvCvB, gtvLoad, gtvJmp] s (gtvEntrySEnd s) rfl rfl (by decide) hnt (gtvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof gtvCtx gtvEntry 2 [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA
               [gtvCvB, gtvLoad, gtvJmp] s (gtvEntrySEnd s) rfl rfl (by decide) hnt (gtvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof gtvCtx gtvEntry 3 [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA
               [gtvCvB, gtvLoad, gtvJmp] s (gtvEntrySEnd s) rfl rfl (by decide) hnt (gtvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([gtvCvA, gtvCvB, gtvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
