        (hvsz := by rw [show operandVal (gtvNextSEnd s (EvmYul.UInt256.ofNat 0) (gtvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (gtvNextSEnd s (EvmYul.UInt256.ofNat 0) (gtvVal s)) from rfl,
