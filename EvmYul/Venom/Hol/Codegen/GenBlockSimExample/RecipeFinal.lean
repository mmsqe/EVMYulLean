/-! ### ✅ A 0-input READ (TIMESTAMP) via the recipe route — `codegen_correct_tspFn_recipeW`

The environment read `TIMESTAMP`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_timestamp_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). TIMESTAMP carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = TIMESTAMP ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`TIMESTAMP` is a 0-input read (`fV v = v.blockCtx.timestamp`), emitted as a bare `TIMESTAMP` push,
leaving `[a, b, c]` with `c = tspVal s` (the block timestamp — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`tspNext_ready`). -/

def tspCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def tspCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def tspLoad : Instruction :=
  { id := 2, opcode := Opcode.TIMESTAMP, operands := [], outputs := ["c"] }
def tspJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def tspMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def tspRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def tspEntry : BasicBlock := { label := "entry", instructions := [tspCvA, tspCvB, tspLoad, tspJmp] }
def tspNext : BasicBlock := { label := "next", instructions := [tspMul, tspRet] }
def tspFn : IrFunction := { name := "main", blocks := [tspEntry, tspNext] }
def tspCtx : VenomContext := { functions := [tspFn], entry := some "main" }

theorem tsp_unresolved_asm : executePlan (generateFnPlan tspFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "TIMESTAMP", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word TIMESTAMP pushes (the block timestamp); context-dependent, generally NON-zero. -/
abbrev tspVal (s : VenomState) : bytes32 := s.blockCtx.timestamp

/-- entry's body `[CV a; CV b; TIMESTAMP]` as a `RegularBodyH`: two `cv_step`s then the
    TIMESTAMP push via `RegularStepG`'s 0-input read arm (`asmStep_timestamp_ok`), output live. -/
theorem tspEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1 1 [tspCvA, tspCvB, tspLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "TIMESTAMP", (fun v : VenomState => v.blockCtx.timestamp),
     (fun s : AsmState => s.blockCtx.timestamp),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_timestamp_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, _, hcc, _, _⟩ := hrel
       show s.blockCtx.timestamp = v.blockCtx.timestamp
       rw [hcc]⟩)))))

/-- Body-end state of `tspEntry`: `a,b := callvalue`, `c := tspVal s` (the block timestamp). -/
abbrev tspEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (tspVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem tspEntry_thread (s : VenomState) :
    execBodyThread [tspCvA, tspCvB, tspLoad] 0 { s with instIdx := 0 } = some (tspEntrySEnd s) := by
  have hsub : stepInstBase tspLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (tspVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [tspLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase tspCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase tspCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase tspCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [tspCvB, tspLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (tspEntrySEnd s)
  rw [h1]
  show (match stepInstBase tspCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [tspLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (tspEntrySEnd s)
  rw [h2]
  show (match stepInstBase tspLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (tspEntrySEnd s)
  rw [hsub]
  rfl

/-- `tspEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem tspEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) tspCtx tspEntry s = ExecResult.OK (jumpTo "next" (tspEntrySEnd s)) :=
  runBlock_body_jmp tspCtx tspEntry j [tspCvA, tspCvB, tspLoad] tspJmp tspCvA [tspCvB, tspLoad, tspJmp] s
    (tspEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (tspEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem tspNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg tspFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([tspMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := tspFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev tspNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem tspNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (tspNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (tspNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem tspNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [tspMul] 0 { s with instIdx := 0 } = some (tspNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase tspMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := tspMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase tspMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem tspMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase tspMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [tspMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem tspMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase tspMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [tspMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem tspNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) tspCtx tspNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (tspNextSEnd s wb wc))
        (tspNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := tspNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return tspCtx tspNext j [tspMul] tspRet tspMul [tspRet] s (tspNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (tspNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem tspNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) tspCtx tspNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := tspNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term tspCtx tspNext j [tspMul] tspRet tspMul [tspRet] s (tspNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (tspNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : tspNext.instructions = [tspMul] ++ [tspRet])
    (tspNext_thread s wb wc hb hc), tspRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `tspEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem tspEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (tspEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (tspEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (tspEntrySEnd s) = some (tspVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (tspVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (tspVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (tspVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def tspInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (tspVal s))

theorem tspInv_pres : ∀ bb ∈ tspFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    tspInv s → runBlock f' tspCtx bb s = ExecResult.OK s' → tspInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [tspFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (tspEntrySEnd s)`
    have hnt : ∀ inst ∈ [tspCvA, tspCvB, tspLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof tspCtx tspEntry 0 [tspCvA, tspCvB, tspLoad] tspJmp tspCvA
             [tspCvB, tspLoad, tspJmp] s (tspEntrySEnd s) rfl rfl (by decide) hnt (tspEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof tspCtx tspEntry 1 [tspCvA, tspCvB, tspLoad] tspJmp tspCvA
             [tspCvB, tspLoad, tspJmp] s (tspEntrySEnd s) rfl rfl (by decide) hnt (tspEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof tspCtx tspEntry 2 [tspCvA, tspCvB, tspLoad] tspJmp tspCvA
             [tspCvB, tspLoad, tspJmp] s (tspEntrySEnd s) rfl rfl (by decide) hnt (tspEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof tspCtx tspEntry 3 [tspCvA, tspCvB, tspLoad] tspJmp tspCvA
             [tspCvB, tspLoad, tspJmp] s (tspEntrySEnd s) rfl rfl (by decide) hnt (tspEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, tspEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := tspEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (tspEntrySEnd s)) = lookupVar "c" (tspEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 tspCtx tspNext s tspMul [tspRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error tspCtx tspNext tspMul [tspRet] s "undefined operand" j rfl
          (by decide) (tspMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 tspCtx tspNext s tspMul [tspRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error tspCtx tspNext tspMul [tspRet] s "undefined operand" j rfl
            (by decide) (tspMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 tspCtx tspNext s tspMul [tspRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof tspCtx tspNext 1 [tspMul] tspRet tspMul [tspRet] s
                   (tspNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (tspNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, tspNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 tspCtx tspNext s tspMul [tspRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof tspCtx tspNext 1 [tspMul] tspRet tspMul [tspRet] s
                   (tspNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (tspNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, tspNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 tspCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem tspFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 tspCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 tspCtx vs
      = runBlocks 10 tspCtx tspFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, tspCtx, tspFn, lookupFunction, fnEntryLabel, tspEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (tspEntrySEnd s0) with hs1
  have hentry : runBlock 9 tspCtx tspEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact tspEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb tspFn.blocks = some tspEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 tspCtx tspFn s0 = runBlocks 9 tspCtx tspFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := tspEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (tspVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (tspEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb tspFn.blocks = some tspNext := rfl
  have hhalt := tspNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (tspVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (TIMESTAMP) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=TIMESTAMP ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s TIMESTAMP exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_timestamp_ok`) as a whole-function capstone — a bare `TIMESTAMP`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = tspVal s` (the block timestamp,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_tspFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 tspCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ tspFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [tspFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [tspEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [tspNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan tspFn 0 0
      = some ((generateFnPlan tspFn 0 0).get!.1, (generateFnPlan tspFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel tspFn) tspFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv tspInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel tspFn) tspFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan tspFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := tspCtx) (fn := tspFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan tspFn 0 0).get!.1) (psFinal := (generateFnPlan tspFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ tspInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [tspFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, tspEntry, tspCvA]
    · simp [runBlock, evalPhis, execBlock, tspNext, tspMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [tspFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [tspCvA, tspCvB, tspLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof tspCtx tspEntry 1 [tspCvA, tspCvB, tspLoad] tspJmp tspCvA
               [tspCvB, tspLoad, tspJmp] s (tspEntrySEnd s) rfl rfl (by decide) hnt (tspEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof tspCtx tspEntry 2 [tspCvA, tspCvB, tspLoad] tspJmp tspCvA
               [tspCvB, tspLoad, tspJmp] s (tspEntrySEnd s) rfl rfl (by decide) hnt (tspEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof tspCtx tspEntry 3 [tspCvA, tspCvB, tspLoad] tspJmp tspCvA
               [tspCvB, tspLoad, tspJmp] s (tspEntrySEnd s) rfl rfl (by decide) hnt (tspEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([tspCvA, tspCvB, tspLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [tspCvA, tspCvB, tspLoad]) (jmpInst := tspJmp) (hd := tspCvA) (tl := [tspCvB, tspLoad, tspJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := tspNext) (sEnd := tspEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := tspEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := tspEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof tspCtx tspNext 1 [tspMul] tspRet tspMul [tspRet] s
               (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (tspNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([tspMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [tspMul]) (retInst := tspRet) (hd := tspMul) (tl := [tspRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel tspFn) tspFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := tspNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s))
            = lookupVar "e" (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s)) from rfl,
            (tspNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (tspVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s))
            = lookupVar "a" (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s)) from rfl,
            (tspNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (tspVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s)) from rfl,
            (tspNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (tspVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (tspNextSEnd s (EvmYul.UInt256.ofNat 0) (tspVal s)) from rfl,
            (tspNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (tspVal s)).2]; exact ha0)
        (hready := tspNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel tspFn) tspFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨tspEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel tspFn) tspFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan tspFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (NUMBER) via the recipe route — `codegen_correct_numFn_recipeW`

The environment read `NUMBER`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_number_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). NUMBER carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = NUMBER ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`NUMBER` is a 0-input read (`fV v = v.blockCtx.number`), emitted as a bare `NUMBER` push,
leaving `[a, b, c]` with `c = numVal s` (the block number — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`numNext_ready`). -/

def numCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def numCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def numLoad : Instruction :=
  { id := 2, opcode := Opcode.NUMBER, operands := [], outputs := ["c"] }
def numJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def numMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def numRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def numEntry : BasicBlock := { label := "entry", instructions := [numCvA, numCvB, numLoad, numJmp] }
def numNext : BasicBlock := { label := "next", instructions := [numMul, numRet] }
def numFn : IrFunction := { name := "main", blocks := [numEntry, numNext] }
def numCtx : VenomContext := { functions := [numFn], entry := some "main" }

theorem num_unresolved_asm : executePlan (generateFnPlan numFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "NUMBER", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word NUMBER pushes (the block number); context-dependent, generally NON-zero. -/
abbrev numVal (s : VenomState) : bytes32 := s.blockCtx.number

/-- entry's body `[CV a; CV b; NUMBER]` as a `RegularBodyH`: two `cv_step`s then the
    NUMBER push via `RegularStepG`'s 0-input read arm (`asmStep_number_ok`), output live. -/
theorem numEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan numFn 0 0).get!.1)).1 1 [numCvA, numCvB, numLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "NUMBER", (fun v : VenomState => v.blockCtx.number),
     (fun s : AsmState => s.blockCtx.number),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_number_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, _, hcc, _, _⟩ := hrel
       show s.blockCtx.number = v.blockCtx.number
       rw [hcc]⟩)))))

/-- Body-end state of `numEntry`: `a,b := callvalue`, `c := numVal s` (the block number). -/
abbrev numEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (numVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem numEntry_thread (s : VenomState) :
    execBodyThread [numCvA, numCvB, numLoad] 0 { s with instIdx := 0 } = some (numEntrySEnd s) := by
  have hsub : stepInstBase numLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (numVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [numLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase numCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase numCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase numCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [numCvB, numLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (numEntrySEnd s)
  rw [h1]
  show (match stepInstBase numCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [numLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (numEntrySEnd s)
  rw [h2]
  show (match stepInstBase numLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (numEntrySEnd s)
  rw [hsub]
  rfl

/-- `numEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem numEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) numCtx numEntry s = ExecResult.OK (jumpTo "next" (numEntrySEnd s)) :=
  runBlock_body_jmp numCtx numEntry j [numCvA, numCvB, numLoad] numJmp numCvA [numCvB, numLoad, numJmp] s
    (numEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (numEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem numNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan numFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan numFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg numFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([numMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := numFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev numNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem numNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (numNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (numNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem numNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [numMul] 0 { s with instIdx := 0 } = some (numNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase numMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := numMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase numMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem numMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase numMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [numMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem numMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase numMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [numMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem numNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) numCtx numNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (numNextSEnd s wb wc))
        (numNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := numNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return numCtx numNext j [numMul] numRet numMul [numRet] s (numNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (numNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem numNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) numCtx numNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := numNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term numCtx numNext j [numMul] numRet numMul [numRet] s (numNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (numNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : numNext.instructions = [numMul] ++ [numRet])
    (numNext_thread s wb wc hb hc), numRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `numEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem numEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (numEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (numEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (numEntrySEnd s) = some (numVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (numVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (numVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (numVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def numInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (numVal s))

theorem numInv_pres : ∀ bb ∈ numFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    numInv s → runBlock f' numCtx bb s = ExecResult.OK s' → numInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [numFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (numEntrySEnd s)`
    have hnt : ∀ inst ∈ [numCvA, numCvB, numLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof numCtx numEntry 0 [numCvA, numCvB, numLoad] numJmp numCvA
             [numCvB, numLoad, numJmp] s (numEntrySEnd s) rfl rfl (by decide) hnt (numEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof numCtx numEntry 1 [numCvA, numCvB, numLoad] numJmp numCvA
             [numCvB, numLoad, numJmp] s (numEntrySEnd s) rfl rfl (by decide) hnt (numEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof numCtx numEntry 2 [numCvA, numCvB, numLoad] numJmp numCvA
             [numCvB, numLoad, numJmp] s (numEntrySEnd s) rfl rfl (by decide) hnt (numEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof numCtx numEntry 3 [numCvA, numCvB, numLoad] numJmp numCvA
             [numCvB, numLoad, numJmp] s (numEntrySEnd s) rfl rfl (by decide) hnt (numEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, numEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := numEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (numEntrySEnd s)) = lookupVar "c" (numEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 numCtx numNext s numMul [numRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error numCtx numNext numMul [numRet] s "undefined operand" j rfl
          (by decide) (numMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 numCtx numNext s numMul [numRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error numCtx numNext numMul [numRet] s "undefined operand" j rfl
            (by decide) (numMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 numCtx numNext s numMul [numRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof numCtx numNext 1 [numMul] numRet numMul [numRet] s
                   (numNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (numNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, numNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 numCtx numNext s numMul [numRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof numCtx numNext 1 [numMul] numRet numMul [numRet] s
                   (numNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (numNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, numNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 numCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem numFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 numCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 numCtx vs
      = runBlocks 10 numCtx numFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, numCtx, numFn, lookupFunction, fnEntryLabel, numEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (numEntrySEnd s0) with hs1
  have hentry : runBlock 9 numCtx numEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact numEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb numFn.blocks = some numEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 numCtx numFn s0 = runBlocks 9 numCtx numFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := numEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (numVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (numEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb numFn.blocks = some numNext := rfl
  have hhalt := numNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (numVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (NUMBER) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=NUMBER ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s NUMBER exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_number_ok`) as a whole-function capstone — a bare `NUMBER`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = numVal s` (the block number,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_numFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 numCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan numFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan numFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan numFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
