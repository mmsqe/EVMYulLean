  refine codegen_correct_ofBlocks_recipeW_inv sgvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel sgvFn) sgvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan sgvFn 0 0).get!.1)).2)
