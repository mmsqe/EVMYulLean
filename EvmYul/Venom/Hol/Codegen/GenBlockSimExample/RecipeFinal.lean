     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ savFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
