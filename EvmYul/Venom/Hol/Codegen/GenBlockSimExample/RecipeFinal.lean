    · show (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (GASPRICE) via the recipe route — `codegen_correct_gprFn_recipeW`

The environment read `GASPRICE`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_gasprice_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). GASPRICE carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = GASPRICE ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`GASPRICE` is a 0-input read (`fV v = v.txCtx.gasprice`), emitted as a bare `GASPRICE` push,
leaving `[a, b, c]` with `c = gprVal s` (the gas price — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`gprNext_ready`). -/

def gprCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def gprCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def gprLoad : Instruction :=
  { id := 2, opcode := Opcode.GASPRICE, operands := [], outputs := ["c"] }
def gprJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def gprMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def gprRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def gprEntry : BasicBlock := { label := "entry", instructions := [gprCvA, gprCvB, gprLoad, gprJmp] }
def gprNext : BasicBlock := { label := "next", instructions := [gprMul, gprRet] }
def gprFn : IrFunction := { name := "main", blocks := [gprEntry, gprNext] }
def gprCtx : VenomContext := { functions := [gprFn], entry := some "main" }

theorem gpr_unresolved_asm : executePlan (generateFnPlan gprFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "GASPRICE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word GASPRICE pushes (the gas price); context-dependent, generally NON-zero. -/
abbrev gprVal (s : VenomState) : bytes32 := s.txCtx.gasprice

/-- entry's body `[CV a; CV b; GASPRICE]` as a `RegularBodyH`: two `cv_step`s then the
    GASPRICE push via `RegularStepG`'s 0-input read arm (`asmStep_gasprice_ok`), output live. -/
theorem gprEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1 1 [gprCvA, gprCvB, gprLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "GASPRICE", (fun v : VenomState => v.txCtx.gasprice),
     (fun s : AsmState => s.txCtx.gasprice),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_gasprice_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, hcc, _, _, _⟩ := hrel
       show s.txCtx.gasprice = v.txCtx.gasprice
       rw [hcc]⟩)))))

/-- Body-end state of `gprEntry`: `a,b := callvalue`, `c := gprVal s` (the gas price). -/
abbrev gprEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (gprVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem gprEntry_thread (s : VenomState) :
    execBodyThread [gprCvA, gprCvB, gprLoad] 0 { s with instIdx := 0 } = some (gprEntrySEnd s) := by
  have hsub : stepInstBase gprLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (gprVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [gprLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase gprCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase gprCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase gprCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [gprCvB, gprLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (gprEntrySEnd s)
  rw [h1]
  show (match stepInstBase gprCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [gprLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (gprEntrySEnd s)
  rw [h2]
  show (match stepInstBase gprLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (gprEntrySEnd s)
  rw [hsub]
  rfl

/-- `gprEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem gprEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) gprCtx gprEntry s = ExecResult.OK (jumpTo "next" (gprEntrySEnd s)) :=
  runBlock_body_jmp gprCtx gprEntry j [gprCvA, gprCvB, gprLoad] gprJmp gprCvA [gprCvB, gprLoad, gprJmp] s
    (gprEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (gprEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem gprNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg gprFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([gprMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := gprFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev gprNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem gprNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (gprNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (gprNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem gprNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [gprMul] 0 { s with instIdx := 0 } = some (gprNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase gprMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := gprMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase gprMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem gprMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase gprMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [gprMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem gprMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase gprMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [gprMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem gprNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) gprCtx gprNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (gprNextSEnd s wb wc))
        (gprNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := gprNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return gprCtx gprNext j [gprMul] gprRet gprMul [gprRet] s (gprNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (gprNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem gprNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) gprCtx gprNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := gprNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term gprCtx gprNext j [gprMul] gprRet gprMul [gprRet] s (gprNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (gprNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : gprNext.instructions = [gprMul] ++ [gprRet])
    (gprNext_thread s wb wc hb hc), gprRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `gprEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem gprEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (gprEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (gprEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (gprEntrySEnd s) = some (gprVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (gprVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (gprVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (gprVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def gprInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (gprVal s))

theorem gprInv_pres : ∀ bb ∈ gprFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    gprInv s → runBlock f' gprCtx bb s = ExecResult.OK s' → gprInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [gprFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (gprEntrySEnd s)`
    have hnt : ∀ inst ∈ [gprCvA, gprCvB, gprLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof gprCtx gprEntry 0 [gprCvA, gprCvB, gprLoad] gprJmp gprCvA
             [gprCvB, gprLoad, gprJmp] s (gprEntrySEnd s) rfl rfl (by decide) hnt (gprEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof gprCtx gprEntry 1 [gprCvA, gprCvB, gprLoad] gprJmp gprCvA
             [gprCvB, gprLoad, gprJmp] s (gprEntrySEnd s) rfl rfl (by decide) hnt (gprEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof gprCtx gprEntry 2 [gprCvA, gprCvB, gprLoad] gprJmp gprCvA
             [gprCvB, gprLoad, gprJmp] s (gprEntrySEnd s) rfl rfl (by decide) hnt (gprEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof gprCtx gprEntry 3 [gprCvA, gprCvB, gprLoad] gprJmp gprCvA
             [gprCvB, gprLoad, gprJmp] s (gprEntrySEnd s) rfl rfl (by decide) hnt (gprEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, gprEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := gprEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (gprEntrySEnd s)) = lookupVar "c" (gprEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 gprCtx gprNext s gprMul [gprRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error gprCtx gprNext gprMul [gprRet] s "undefined operand" j rfl
          (by decide) (gprMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 gprCtx gprNext s gprMul [gprRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error gprCtx gprNext gprMul [gprRet] s "undefined operand" j rfl
            (by decide) (gprMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 gprCtx gprNext s gprMul [gprRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof gprCtx gprNext 1 [gprMul] gprRet gprMul [gprRet] s
                   (gprNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (gprNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, gprNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 gprCtx gprNext s gprMul [gprRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof gprCtx gprNext 1 [gprMul] gprRet gprMul [gprRet] s
                   (gprNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (gprNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, gprNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 gprCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem gprFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 gprCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 gprCtx vs
      = runBlocks 10 gprCtx gprFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, gprCtx, gprFn, lookupFunction, fnEntryLabel, gprEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (gprEntrySEnd s0) with hs1
  have hentry : runBlock 9 gprCtx gprEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact gprEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb gprFn.blocks = some gprEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 gprCtx gprFn s0 = runBlocks 9 gprCtx gprFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := gprEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (gprVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (gprEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb gprFn.blocks = some gprNext := rfl
  have hhalt := gprNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (gprVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (GASPRICE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=GASPRICE ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s GASPRICE exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_gasprice_ok`) as a whole-function capstone — a bare `GASPRICE`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = gprVal s` (the gas price,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_gprFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 gprCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ gprFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [gprFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [gprEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [gprNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan gprFn 0 0
      = some ((generateFnPlan gprFn 0 0).get!.1, (generateFnPlan gprFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel gprFn) gprFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv gprInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel gprFn) gprFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan gprFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := gprCtx) (fn := gprFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan gprFn 0 0).get!.1) (psFinal := (generateFnPlan gprFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ gprInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [gprFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, gprEntry, gprCvA]
    · simp [runBlock, evalPhis, execBlock, gprNext, gprMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [gprFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [gprCvA, gprCvB, gprLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof gprCtx gprEntry 1 [gprCvA, gprCvB, gprLoad] gprJmp gprCvA
               [gprCvB, gprLoad, gprJmp] s (gprEntrySEnd s) rfl rfl (by decide) hnt (gprEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof gprCtx gprEntry 2 [gprCvA, gprCvB, gprLoad] gprJmp gprCvA
               [gprCvB, gprLoad, gprJmp] s (gprEntrySEnd s) rfl rfl (by decide) hnt (gprEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof gprCtx gprEntry 3 [gprCvA, gprCvB, gprLoad] gprJmp gprCvA
               [gprCvB, gprLoad, gprJmp] s (gprEntrySEnd s) rfl rfl (by decide) hnt (gprEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([gprCvA, gprCvB, gprLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [gprCvA, gprCvB, gprLoad]) (jmpInst := gprJmp) (hd := gprCvA) (tl := [gprCvB, gprLoad, gprJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := gprNext) (sEnd := gprEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := gprEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := gprEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof gprCtx gprNext 1 [gprMul] gprRet gprMul [gprRet] s
               (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (gprNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([gprMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [gprMul]) (retInst := gprRet) (hd := gprMul) (tl := [gprRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel gprFn) gprFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := gprNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s))
            = lookupVar "e" (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s)) from rfl,
            (gprNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gprVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s))
            = lookupVar "a" (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s)) from rfl,
            (gprNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gprVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s)) from rfl,
            (gprNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gprVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (gprNextSEnd s (EvmYul.UInt256.ofNat 0) (gprVal s)) from rfl,
            (gprNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gprVal s)).2]; exact ha0)
        (hready := gprNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel gprFn) gprFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨gprEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel gprFn) gprFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan gprFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (GASLIMIT) via the recipe route — `codegen_correct_glmFn_recipeW`

The environment read `GASLIMIT`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_gaslimit_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). GASLIMIT carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = GASLIMIT ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`GASLIMIT` is a 0-input read (`fV v = v.blockCtx.gaslimit`), emitted as a bare `GASLIMIT` push,
leaving `[a, b, c]` with `c = glmVal s` (the block gas limit — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`glmNext_ready`). -/

def glmCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def glmCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def glmLoad : Instruction :=
  { id := 2, opcode := Opcode.GASLIMIT, operands := [], outputs := ["c"] }
def glmJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def glmMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def glmRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def glmEntry : BasicBlock := { label := "entry", instructions := [glmCvA, glmCvB, glmLoad, glmJmp] }
def glmNext : BasicBlock := { label := "next", instructions := [glmMul, glmRet] }
def glmFn : IrFunction := { name := "main", blocks := [glmEntry, glmNext] }
def glmCtx : VenomContext := { functions := [glmFn], entry := some "main" }

theorem glm_unresolved_asm : executePlan (generateFnPlan glmFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "GASLIMIT", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word GASLIMIT pushes (the block gas limit); context-dependent, generally NON-zero. -/
abbrev glmVal (s : VenomState) : bytes32 := s.blockCtx.gaslimit

/-- entry's body `[CV a; CV b; GASLIMIT]` as a `RegularBodyH`: two `cv_step`s then the
    GASLIMIT push via `RegularStepG`'s 0-input read arm (`asmStep_gaslimit_ok`), output live. -/
theorem glmEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1 1 [glmCvA, glmCvB, glmLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "GASLIMIT", (fun v : VenomState => v.blockCtx.gaslimit),
     (fun s : AsmState => s.blockCtx.gaslimit),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_gaslimit_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, _, hcc, _, _⟩ := hrel
       show s.blockCtx.gaslimit = v.blockCtx.gaslimit
       rw [hcc]⟩)))))

/-- Body-end state of `glmEntry`: `a,b := callvalue`, `c := glmVal s` (the block gas limit). -/
abbrev glmEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (glmVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem glmEntry_thread (s : VenomState) :
    execBodyThread [glmCvA, glmCvB, glmLoad] 0 { s with instIdx := 0 } = some (glmEntrySEnd s) := by
  have hsub : stepInstBase glmLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (glmVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [glmLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase glmCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase glmCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase glmCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [glmCvB, glmLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (glmEntrySEnd s)
  rw [h1]
  show (match stepInstBase glmCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [glmLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (glmEntrySEnd s)
  rw [h2]
  show (match stepInstBase glmLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (glmEntrySEnd s)
  rw [hsub]
  rfl

/-- `glmEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem glmEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) glmCtx glmEntry s = ExecResult.OK (jumpTo "next" (glmEntrySEnd s)) :=
  runBlock_body_jmp glmCtx glmEntry j [glmCvA, glmCvB, glmLoad] glmJmp glmCvA [glmCvB, glmLoad, glmJmp] s
    (glmEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (glmEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem glmNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg glmFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([glmMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := glmFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev glmNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem glmNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (glmNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (glmNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem glmNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [glmMul] 0 { s with instIdx := 0 } = some (glmNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase glmMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := glmMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase glmMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem glmMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase glmMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [glmMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem glmMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase glmMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [glmMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem glmNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) glmCtx glmNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (glmNextSEnd s wb wc))
        (glmNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := glmNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return glmCtx glmNext j [glmMul] glmRet glmMul [glmRet] s (glmNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (glmNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem glmNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) glmCtx glmNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := glmNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term glmCtx glmNext j [glmMul] glmRet glmMul [glmRet] s (glmNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (glmNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : glmNext.instructions = [glmMul] ++ [glmRet])
    (glmNext_thread s wb wc hb hc), glmRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `glmEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem glmEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (glmEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (glmEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (glmEntrySEnd s) = some (glmVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (glmVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (glmVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (glmVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def glmInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (glmVal s))

theorem glmInv_pres : ∀ bb ∈ glmFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    glmInv s → runBlock f' glmCtx bb s = ExecResult.OK s' → glmInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [glmFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (glmEntrySEnd s)`
    have hnt : ∀ inst ∈ [glmCvA, glmCvB, glmLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof glmCtx glmEntry 0 [glmCvA, glmCvB, glmLoad] glmJmp glmCvA
             [glmCvB, glmLoad, glmJmp] s (glmEntrySEnd s) rfl rfl (by decide) hnt (glmEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof glmCtx glmEntry 1 [glmCvA, glmCvB, glmLoad] glmJmp glmCvA
             [glmCvB, glmLoad, glmJmp] s (glmEntrySEnd s) rfl rfl (by decide) hnt (glmEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof glmCtx glmEntry 2 [glmCvA, glmCvB, glmLoad] glmJmp glmCvA
             [glmCvB, glmLoad, glmJmp] s (glmEntrySEnd s) rfl rfl (by decide) hnt (glmEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof glmCtx glmEntry 3 [glmCvA, glmCvB, glmLoad] glmJmp glmCvA
             [glmCvB, glmLoad, glmJmp] s (glmEntrySEnd s) rfl rfl (by decide) hnt (glmEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, glmEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := glmEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (glmEntrySEnd s)) = lookupVar "c" (glmEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 glmCtx glmNext s glmMul [glmRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error glmCtx glmNext glmMul [glmRet] s "undefined operand" j rfl
          (by decide) (glmMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 glmCtx glmNext s glmMul [glmRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error glmCtx glmNext glmMul [glmRet] s "undefined operand" j rfl
            (by decide) (glmMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 glmCtx glmNext s glmMul [glmRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof glmCtx glmNext 1 [glmMul] glmRet glmMul [glmRet] s
                   (glmNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (glmNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, glmNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 glmCtx glmNext s glmMul [glmRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof glmCtx glmNext 1 [glmMul] glmRet glmMul [glmRet] s
                   (glmNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (glmNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, glmNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 glmCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem glmFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 glmCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 glmCtx vs
      = runBlocks 10 glmCtx glmFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, glmCtx, glmFn, lookupFunction, fnEntryLabel, glmEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (glmEntrySEnd s0) with hs1
  have hentry : runBlock 9 glmCtx glmEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact glmEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb glmFn.blocks = some glmEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 glmCtx glmFn s0 = runBlocks 9 glmCtx glmFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := glmEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (glmVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (glmEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb glmFn.blocks = some glmNext := rfl
  have hhalt := glmNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (glmVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (GASLIMIT) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=GASLIMIT ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s GASLIMIT exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_gaslimit_ok`) as a whole-function capstone — a bare `GASLIMIT`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = glmVal s` (the block gas limit,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_glmFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 glmCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ glmFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [glmFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [glmEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [glmNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan glmFn 0 0
      = some ((generateFnPlan glmFn 0 0).get!.1, (generateFnPlan glmFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel glmFn) glmFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv glmInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel glmFn) glmFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan glmFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := glmCtx) (fn := glmFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan glmFn 0 0).get!.1) (psFinal := (generateFnPlan glmFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ glmInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [glmFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, glmEntry, glmCvA]
    · simp [runBlock, evalPhis, execBlock, glmNext, glmMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [glmFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [glmCvA, glmCvB, glmLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof glmCtx glmEntry 1 [glmCvA, glmCvB, glmLoad] glmJmp glmCvA
               [glmCvB, glmLoad, glmJmp] s (glmEntrySEnd s) rfl rfl (by decide) hnt (glmEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof glmCtx glmEntry 2 [glmCvA, glmCvB, glmLoad] glmJmp glmCvA
               [glmCvB, glmLoad, glmJmp] s (glmEntrySEnd s) rfl rfl (by decide) hnt (glmEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof glmCtx glmEntry 3 [glmCvA, glmCvB, glmLoad] glmJmp glmCvA
               [glmCvB, glmLoad, glmJmp] s (glmEntrySEnd s) rfl rfl (by decide) hnt (glmEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([glmCvA, glmCvB, glmLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [glmCvA, glmCvB, glmLoad]) (jmpInst := glmJmp) (hd := glmCvA) (tl := [glmCvB, glmLoad, glmJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := glmNext) (sEnd := glmEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := glmEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := glmEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof glmCtx glmNext 1 [glmMul] glmRet glmMul [glmRet] s
               (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (glmNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([glmMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [glmMul]) (retInst := glmRet) (hd := glmMul) (tl := [glmRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel glmFn) glmFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := glmNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s))
            = lookupVar "e" (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s)) from rfl,
            (glmNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (glmVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s))
            = lookupVar "a" (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s)) from rfl,
            (glmNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (glmVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s)) from rfl,
            (glmNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (glmVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (glmNextSEnd s (EvmYul.UInt256.ofNat 0) (glmVal s)) from rfl,
            (glmNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (glmVal s)).2]; exact ha0)
        (hready := glmNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel glmFn) glmFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨glmEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel glmFn) glmFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan glmFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (CALLDATASIZE) via the recipe route — `codegen_correct_cdsFn_recipeW`

The environment read `CALLDATASIZE`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_calldatasize_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). CALLDATASIZE carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = CALLDATASIZE ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`CALLDATASIZE` is a 0-input read (`fV v = EvmYul.UInt256.ofNat v.callCtx.calldata.length`), emitted as a bare `CALLDATASIZE` push,
leaving `[a, b, c]` with `c = cdsVal s` (the calldata size — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`cdsNext_ready`). -/

def cdsCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def cdsCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def cdsLoad : Instruction :=
  { id := 2, opcode := Opcode.CALLDATASIZE, operands := [], outputs := ["c"] }
def cdsJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def cdsMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def cdsRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def cdsEntry : BasicBlock := { label := "entry", instructions := [cdsCvA, cdsCvB, cdsLoad, cdsJmp] }
def cdsNext : BasicBlock := { label := "next", instructions := [cdsMul, cdsRet] }
def cdsFn : IrFunction := { name := "main", blocks := [cdsEntry, cdsNext] }
def cdsCtx : VenomContext := { functions := [cdsFn], entry := some "main" }

theorem cds_unresolved_asm : executePlan (generateFnPlan cdsFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "CALLDATASIZE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word CALLDATASIZE pushes (the calldata size); context-dependent, generally NON-zero. -/
abbrev cdsVal (s : VenomState) : bytes32 := EvmYul.UInt256.ofNat s.callCtx.calldata.length

/-- entry's body `[CV a; CV b; CALLDATASIZE]` as a `RegularBodyH`: two `cv_step`s then the
    CALLDATASIZE push via `RegularStepG`'s 0-input read arm (`asmStep_calldatasize_ok`), output live. -/
theorem cdsEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1 1 [cdsCvA, cdsCvB, cdsLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "CALLDATASIZE", (fun v : VenomState => EvmYul.UInt256.ofNat v.callCtx.calldata.length),
     (fun s : AsmState => EvmYul.UInt256.ofNat s.callCtx.calldata.length),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_calldatasize_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, hcc, _, _, _, _⟩ := hrel
       show EvmYul.UInt256.ofNat s.callCtx.calldata.length = EvmYul.UInt256.ofNat v.callCtx.calldata.length
       rw [hcc]⟩)))))

/-- Body-end state of `cdsEntry`: `a,b := callvalue`, `c := cdsVal s` (the calldata size). -/
abbrev cdsEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (cdsVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem cdsEntry_thread (s : VenomState) :
    execBodyThread [cdsCvA, cdsCvB, cdsLoad] 0 { s with instIdx := 0 } = some (cdsEntrySEnd s) := by
  have hsub : stepInstBase cdsLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (cdsVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [cdsLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase cdsCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase cdsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase cdsCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [cdsCvB, cdsLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (cdsEntrySEnd s)
  rw [h1]
  show (match stepInstBase cdsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [cdsLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (cdsEntrySEnd s)
  rw [h2]
  show (match stepInstBase cdsLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (cdsEntrySEnd s)
  rw [hsub]
  rfl

/-- `cdsEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem cdsEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) cdsCtx cdsEntry s = ExecResult.OK (jumpTo "next" (cdsEntrySEnd s)) :=
  runBlock_body_jmp cdsCtx cdsEntry j [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA [cdsCvB, cdsLoad, cdsJmp] s
    (cdsEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (cdsEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem cdsNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg cdsFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([cdsMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := cdsFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev cdsNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem cdsNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (cdsNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (cdsNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem cdsNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [cdsMul] 0 { s with instIdx := 0 } = some (cdsNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase cdsMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := cdsMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase cdsMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem cdsMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase cdsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [cdsMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem cdsMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase cdsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [cdsMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem cdsNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) cdsCtx cdsNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (cdsNextSEnd s wb wc))
        (cdsNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := cdsNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return cdsCtx cdsNext j [cdsMul] cdsRet cdsMul [cdsRet] s (cdsNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (cdsNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem cdsNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) cdsCtx cdsNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := cdsNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term cdsCtx cdsNext j [cdsMul] cdsRet cdsMul [cdsRet] s (cdsNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (cdsNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : cdsNext.instructions = [cdsMul] ++ [cdsRet])
    (cdsNext_thread s wb wc hb hc), cdsRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `cdsEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem cdsEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (cdsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (cdsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (cdsEntrySEnd s) = some (cdsVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (cdsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (cdsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (cdsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def cdsInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (cdsVal s))

theorem cdsInv_pres : ∀ bb ∈ cdsFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    cdsInv s → runBlock f' cdsCtx bb s = ExecResult.OK s' → cdsInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [cdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (cdsEntrySEnd s)`
    have hnt : ∀ inst ∈ [cdsCvA, cdsCvB, cdsLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof cdsCtx cdsEntry 0 [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA
             [cdsCvB, cdsLoad, cdsJmp] s (cdsEntrySEnd s) rfl rfl (by decide) hnt (cdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof cdsCtx cdsEntry 1 [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA
             [cdsCvB, cdsLoad, cdsJmp] s (cdsEntrySEnd s) rfl rfl (by decide) hnt (cdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof cdsCtx cdsEntry 2 [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA
             [cdsCvB, cdsLoad, cdsJmp] s (cdsEntrySEnd s) rfl rfl (by decide) hnt (cdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof cdsCtx cdsEntry 3 [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA
             [cdsCvB, cdsLoad, cdsJmp] s (cdsEntrySEnd s) rfl rfl (by decide) hnt (cdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, cdsEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := cdsEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (cdsEntrySEnd s)) = lookupVar "c" (cdsEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 cdsCtx cdsNext s cdsMul [cdsRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error cdsCtx cdsNext cdsMul [cdsRet] s "undefined operand" j rfl
          (by decide) (cdsMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 cdsCtx cdsNext s cdsMul [cdsRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error cdsCtx cdsNext cdsMul [cdsRet] s "undefined operand" j rfl
            (by decide) (cdsMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 cdsCtx cdsNext s cdsMul [cdsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof cdsCtx cdsNext 1 [cdsMul] cdsRet cdsMul [cdsRet] s
                   (cdsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (cdsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, cdsNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 cdsCtx cdsNext s cdsMul [cdsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof cdsCtx cdsNext 1 [cdsMul] cdsRet cdsMul [cdsRet] s
                   (cdsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (cdsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, cdsNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 cdsCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem cdsFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 cdsCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 cdsCtx vs
      = runBlocks 10 cdsCtx cdsFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, cdsCtx, cdsFn, lookupFunction, fnEntryLabel, cdsEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (cdsEntrySEnd s0) with hs1
  have hentry : runBlock 9 cdsCtx cdsEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact cdsEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb cdsFn.blocks = some cdsEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 cdsCtx cdsFn s0 = runBlocks 9 cdsCtx cdsFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := cdsEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (cdsVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (cdsEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb cdsFn.blocks = some cdsNext := rfl
  have hhalt := cdsNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (cdsVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (CALLDATASIZE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=CALLDATASIZE ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s CALLDATASIZE exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_calldatasize_ok`) as a whole-function capstone — a bare `CALLDATASIZE`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = cdsVal s` (the calldata size,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_cdsFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 cdsCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ cdsFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [cdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [cdsEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [cdsNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan cdsFn 0 0
      = some ((generateFnPlan cdsFn 0 0).get!.1, (generateFnPlan cdsFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel cdsFn) cdsFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv cdsInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel cdsFn) cdsFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan cdsFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := cdsCtx) (fn := cdsFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan cdsFn 0 0).get!.1) (psFinal := (generateFnPlan cdsFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ cdsInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [cdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, cdsEntry, cdsCvA]
    · simp [runBlock, evalPhis, execBlock, cdsNext, cdsMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [cdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [cdsCvA, cdsCvB, cdsLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof cdsCtx cdsEntry 1 [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA
               [cdsCvB, cdsLoad, cdsJmp] s (cdsEntrySEnd s) rfl rfl (by decide) hnt (cdsEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof cdsCtx cdsEntry 2 [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA
               [cdsCvB, cdsLoad, cdsJmp] s (cdsEntrySEnd s) rfl rfl (by decide) hnt (cdsEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof cdsCtx cdsEntry 3 [cdsCvA, cdsCvB, cdsLoad] cdsJmp cdsCvA
               [cdsCvB, cdsLoad, cdsJmp] s (cdsEntrySEnd s) rfl rfl (by decide) hnt (cdsEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([cdsCvA, cdsCvB, cdsLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [cdsCvA, cdsCvB, cdsLoad]) (jmpInst := cdsJmp) (hd := cdsCvA) (tl := [cdsCvB, cdsLoad, cdsJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := cdsNext) (sEnd := cdsEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := cdsEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := cdsEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof cdsCtx cdsNext 1 [cdsMul] cdsRet cdsMul [cdsRet] s
               (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (cdsNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([cdsMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [cdsMul]) (retInst := cdsRet) (hd := cdsMul) (tl := [cdsRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel cdsFn) cdsFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := cdsNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s))
            = lookupVar "e" (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s)) from rfl,
            (cdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cdsVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s))
            = lookupVar "a" (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s)) from rfl,
            (cdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cdsVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s)) from rfl,
            (cdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cdsVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (cdsNextSEnd s (EvmYul.UInt256.ofNat 0) (cdsVal s)) from rfl,
            (cdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cdsVal s)).2]; exact ha0)
        (hready := cdsNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel cdsFn) cdsFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨cdsEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel cdsFn) cdsFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan cdsFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (GAS) via the recipe route — `codegen_correct_gsrFn_recipeW`

The environment read `GAS`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_gas_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). GAS carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = GAS ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`GAS` is a 0-input read (`fV v = EvmYul.UInt256.ofNat v.callCtx.gas`), emitted as a bare `GAS` push,
leaving `[a, b, c]` with `c = gsrVal s` (the remaining gas — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`gsrNext_ready`). -/

def gsrCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def gsrCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def gsrLoad : Instruction :=
  { id := 2, opcode := Opcode.GAS, operands := [], outputs := ["c"] }
def gsrJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def gsrMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def gsrRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def gsrEntry : BasicBlock := { label := "entry", instructions := [gsrCvA, gsrCvB, gsrLoad, gsrJmp] }
def gsrNext : BasicBlock := { label := "next", instructions := [gsrMul, gsrRet] }
def gsrFn : IrFunction := { name := "main", blocks := [gsrEntry, gsrNext] }
def gsrCtx : VenomContext := { functions := [gsrFn], entry := some "main" }

theorem gsr_unresolved_asm : executePlan (generateFnPlan gsrFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "GAS", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word GAS pushes (the remaining gas); context-dependent, generally NON-zero. -/
abbrev gsrVal (s : VenomState) : bytes32 := EvmYul.UInt256.ofNat s.callCtx.gas

/-- entry's body `[CV a; CV b; GAS]` as a `RegularBodyH`: two `cv_step`s then the
    GAS push via `RegularStepG`'s 0-input read arm (`asmStep_gas_ok`), output live. -/
theorem gsrEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1 1 [gsrCvA, gsrCvB, gsrLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "GAS", (fun v : VenomState => EvmYul.UInt256.ofNat v.callCtx.gas),
     (fun s : AsmState => EvmYul.UInt256.ofNat s.callCtx.gas),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_gas_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, hcc, _, _, _, _⟩ := hrel
       show EvmYul.UInt256.ofNat s.callCtx.gas = EvmYul.UInt256.ofNat v.callCtx.gas
       rw [hcc]⟩)))))

/-- Body-end state of `gsrEntry`: `a,b := callvalue`, `c := gsrVal s` (the remaining gas). -/
abbrev gsrEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (gsrVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem gsrEntry_thread (s : VenomState) :
    execBodyThread [gsrCvA, gsrCvB, gsrLoad] 0 { s with instIdx := 0 } = some (gsrEntrySEnd s) := by
  have hsub : stepInstBase gsrLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (gsrVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [gsrLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase gsrCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase gsrCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase gsrCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [gsrCvB, gsrLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (gsrEntrySEnd s)
  rw [h1]
  show (match stepInstBase gsrCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [gsrLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (gsrEntrySEnd s)
  rw [h2]
  show (match stepInstBase gsrLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (gsrEntrySEnd s)
  rw [hsub]
  rfl

/-- `gsrEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem gsrEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) gsrCtx gsrEntry s = ExecResult.OK (jumpTo "next" (gsrEntrySEnd s)) :=
  runBlock_body_jmp gsrCtx gsrEntry j [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA [gsrCvB, gsrLoad, gsrJmp] s
    (gsrEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (gsrEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem gsrNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg gsrFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([gsrMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := gsrFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev gsrNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem gsrNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (gsrNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (gsrNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem gsrNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [gsrMul] 0 { s with instIdx := 0 } = some (gsrNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase gsrMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := gsrMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase gsrMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem gsrMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase gsrMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [gsrMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem gsrMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase gsrMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [gsrMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem gsrNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) gsrCtx gsrNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (gsrNextSEnd s wb wc))
        (gsrNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := gsrNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return gsrCtx gsrNext j [gsrMul] gsrRet gsrMul [gsrRet] s (gsrNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (gsrNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem gsrNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) gsrCtx gsrNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := gsrNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term gsrCtx gsrNext j [gsrMul] gsrRet gsrMul [gsrRet] s (gsrNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (gsrNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : gsrNext.instructions = [gsrMul] ++ [gsrRet])
    (gsrNext_thread s wb wc hb hc), gsrRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `gsrEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem gsrEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (gsrEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (gsrEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (gsrEntrySEnd s) = some (gsrVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (gsrVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (gsrVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (gsrVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def gsrInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (gsrVal s))

theorem gsrInv_pres : ∀ bb ∈ gsrFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    gsrInv s → runBlock f' gsrCtx bb s = ExecResult.OK s' → gsrInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [gsrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (gsrEntrySEnd s)`
    have hnt : ∀ inst ∈ [gsrCvA, gsrCvB, gsrLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof gsrCtx gsrEntry 0 [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA
             [gsrCvB, gsrLoad, gsrJmp] s (gsrEntrySEnd s) rfl rfl (by decide) hnt (gsrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof gsrCtx gsrEntry 1 [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA
             [gsrCvB, gsrLoad, gsrJmp] s (gsrEntrySEnd s) rfl rfl (by decide) hnt (gsrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof gsrCtx gsrEntry 2 [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA
             [gsrCvB, gsrLoad, gsrJmp] s (gsrEntrySEnd s) rfl rfl (by decide) hnt (gsrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof gsrCtx gsrEntry 3 [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA
             [gsrCvB, gsrLoad, gsrJmp] s (gsrEntrySEnd s) rfl rfl (by decide) hnt (gsrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, gsrEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := gsrEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (gsrEntrySEnd s)) = lookupVar "c" (gsrEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 gsrCtx gsrNext s gsrMul [gsrRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error gsrCtx gsrNext gsrMul [gsrRet] s "undefined operand" j rfl
          (by decide) (gsrMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 gsrCtx gsrNext s gsrMul [gsrRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error gsrCtx gsrNext gsrMul [gsrRet] s "undefined operand" j rfl
            (by decide) (gsrMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 gsrCtx gsrNext s gsrMul [gsrRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof gsrCtx gsrNext 1 [gsrMul] gsrRet gsrMul [gsrRet] s
                   (gsrNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (gsrNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, gsrNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 gsrCtx gsrNext s gsrMul [gsrRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof gsrCtx gsrNext 1 [gsrMul] gsrRet gsrMul [gsrRet] s
                   (gsrNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (gsrNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, gsrNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 gsrCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem gsrFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 gsrCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 gsrCtx vs
      = runBlocks 10 gsrCtx gsrFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, gsrCtx, gsrFn, lookupFunction, fnEntryLabel, gsrEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (gsrEntrySEnd s0) with hs1
  have hentry : runBlock 9 gsrCtx gsrEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact gsrEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb gsrFn.blocks = some gsrEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 gsrCtx gsrFn s0 = runBlocks 9 gsrCtx gsrFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := gsrEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (gsrVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (gsrEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb gsrFn.blocks = some gsrNext := rfl
  have hhalt := gsrNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (gsrVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (GAS) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=GAS ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s GAS exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_gas_ok`) as a whole-function capstone — a bare `GAS`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = gsrVal s` (the remaining gas,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_gsrFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 gsrCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ gsrFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [gsrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [gsrEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [gsrNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan gsrFn 0 0
      = some ((generateFnPlan gsrFn 0 0).get!.1, (generateFnPlan gsrFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel gsrFn) gsrFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv gsrInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel gsrFn) gsrFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan gsrFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := gsrCtx) (fn := gsrFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan gsrFn 0 0).get!.1) (psFinal := (generateFnPlan gsrFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ gsrInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [gsrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, gsrEntry, gsrCvA]
    · simp [runBlock, evalPhis, execBlock, gsrNext, gsrMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [gsrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [gsrCvA, gsrCvB, gsrLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof gsrCtx gsrEntry 1 [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA
               [gsrCvB, gsrLoad, gsrJmp] s (gsrEntrySEnd s) rfl rfl (by decide) hnt (gsrEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof gsrCtx gsrEntry 2 [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA
               [gsrCvB, gsrLoad, gsrJmp] s (gsrEntrySEnd s) rfl rfl (by decide) hnt (gsrEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof gsrCtx gsrEntry 3 [gsrCvA, gsrCvB, gsrLoad] gsrJmp gsrCvA
               [gsrCvB, gsrLoad, gsrJmp] s (gsrEntrySEnd s) rfl rfl (by decide) hnt (gsrEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([gsrCvA, gsrCvB, gsrLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [gsrCvA, gsrCvB, gsrLoad]) (jmpInst := gsrJmp) (hd := gsrCvA) (tl := [gsrCvB, gsrLoad, gsrJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := gsrNext) (sEnd := gsrEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := gsrEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := gsrEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof gsrCtx gsrNext 1 [gsrMul] gsrRet gsrMul [gsrRet] s
               (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (gsrNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([gsrMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [gsrMul]) (retInst := gsrRet) (hd := gsrMul) (tl := [gsrRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel gsrFn) gsrFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := gsrNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s))
            = lookupVar "e" (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s)) from rfl,
            (gsrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gsrVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s))
            = lookupVar "a" (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s)) from rfl,
            (gsrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gsrVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s)) from rfl,
            (gsrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gsrVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (gsrNextSEnd s (EvmYul.UInt256.ofNat 0) (gsrVal s)) from rfl,
            (gsrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (gsrVal s)).2]; exact ha0)
        (hready := gsrNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel gsrFn) gsrFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨gsrEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel gsrFn) gsrFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan gsrFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (BASEFEE) via the recipe route — `codegen_correct_bfeFn_recipeW`

The environment read `BASEFEE`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_basefee_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). BASEFEE carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = BASEFEE ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`BASEFEE` is a 0-input read (`fV v = v.blockCtx.basefee`), emitted as a bare `BASEFEE` push,
leaving `[a, b, c]` with `c = bfeVal s` (the block base fee — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`bfeNext_ready`). -/

def bfeCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def bfeCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def bfeLoad : Instruction :=
  { id := 2, opcode := Opcode.BASEFEE, operands := [], outputs := ["c"] }
def bfeJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def bfeMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def bfeRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def bfeEntry : BasicBlock := { label := "entry", instructions := [bfeCvA, bfeCvB, bfeLoad, bfeJmp] }
def bfeNext : BasicBlock := { label := "next", instructions := [bfeMul, bfeRet] }
def bfeFn : IrFunction := { name := "main", blocks := [bfeEntry, bfeNext] }
def bfeCtx : VenomContext := { functions := [bfeFn], entry := some "main" }

theorem bfe_unresolved_asm : executePlan (generateFnPlan bfeFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "BASEFEE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word BASEFEE pushes (the block base fee); context-dependent, generally NON-zero. -/
abbrev bfeVal (s : VenomState) : bytes32 := s.blockCtx.basefee

/-- entry's body `[CV a; CV b; BASEFEE]` as a `RegularBodyH`: two `cv_step`s then the
    BASEFEE push via `RegularStepG`'s 0-input read arm (`asmStep_basefee_ok`), output live. -/
theorem bfeEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan bfeFn 0 0).get!.1)).1 1 [bfeCvA, bfeCvB, bfeLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "BASEFEE", (fun v : VenomState => v.blockCtx.basefee),
     (fun s : AsmState => s.blockCtx.basefee),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_basefee_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, _, hcc, _, _⟩ := hrel
       show s.blockCtx.basefee = v.blockCtx.basefee
       rw [hcc]⟩)))))

/-- Body-end state of `bfeEntry`: `a,b := callvalue`, `c := bfeVal s` (the block base fee). -/
abbrev bfeEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (bfeVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem bfeEntry_thread (s : VenomState) :
    execBodyThread [bfeCvA, bfeCvB, bfeLoad] 0 { s with instIdx := 0 } = some (bfeEntrySEnd s) := by
  have hsub : stepInstBase bfeLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (bfeVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [bfeLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase bfeCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase bfeCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase bfeCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [bfeCvB, bfeLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (bfeEntrySEnd s)
  rw [h1]
  show (match stepInstBase bfeCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [bfeLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (bfeEntrySEnd s)
  rw [h2]
  show (match stepInstBase bfeLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (bfeEntrySEnd s)
  rw [hsub]
  rfl

/-- `bfeEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem bfeEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) bfeCtx bfeEntry s = ExecResult.OK (jumpTo "next" (bfeEntrySEnd s)) :=
  runBlock_body_jmp bfeCtx bfeEntry j [bfeCvA, bfeCvB, bfeLoad] bfeJmp bfeCvA [bfeCvB, bfeLoad, bfeJmp] s
    (bfeEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (bfeEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem bfeNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan bfeFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan bfeFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg bfeFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([bfeMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := bfeFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev bfeNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem bfeNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (bfeNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (bfeNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem bfeNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [bfeMul] 0 { s with instIdx := 0 } = some (bfeNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase bfeMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := bfeMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase bfeMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem bfeMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase bfeMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [bfeMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem bfeMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase bfeMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [bfeMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem bfeNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) bfeCtx bfeNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (bfeNextSEnd s wb wc))
        (bfeNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := bfeNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return bfeCtx bfeNext j [bfeMul] bfeRet bfeMul [bfeRet] s (bfeNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (bfeNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem bfeNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) bfeCtx bfeNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := bfeNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term bfeCtx bfeNext j [bfeMul] bfeRet bfeMul [bfeRet] s (bfeNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (bfeNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : bfeNext.instructions = [bfeMul] ++ [bfeRet])
    (bfeNext_thread s wb wc hb hc), bfeRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `bfeEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem bfeEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (bfeEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (bfeEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (bfeEntrySEnd s) = some (bfeVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (bfeVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (bfeVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (bfeVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def bfeInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (bfeVal s))

theorem bfeInv_pres : ∀ bb ∈ bfeFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    bfeInv s → runBlock f' bfeCtx bb s = ExecResult.OK s' → bfeInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [bfeFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (bfeEntrySEnd s)`
    have hnt : ∀ inst ∈ [bfeCvA, bfeCvB, bfeLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof bfeCtx bfeEntry 0 [bfeCvA, bfeCvB, bfeLoad] bfeJmp bfeCvA
             [bfeCvB, bfeLoad, bfeJmp] s (bfeEntrySEnd s) rfl rfl (by decide) hnt (bfeEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof bfeCtx bfeEntry 1 [bfeCvA, bfeCvB, bfeLoad] bfeJmp bfeCvA
             [bfeCvB, bfeLoad, bfeJmp] s (bfeEntrySEnd s) rfl rfl (by decide) hnt (bfeEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof bfeCtx bfeEntry 2 [bfeCvA, bfeCvB, bfeLoad] bfeJmp bfeCvA
             [bfeCvB, bfeLoad, bfeJmp] s (bfeEntrySEnd s) rfl rfl (by decide) hnt (bfeEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof bfeCtx bfeEntry 3 [bfeCvA, bfeCvB, bfeLoad] bfeJmp bfeCvA
             [bfeCvB, bfeLoad, bfeJmp] s (bfeEntrySEnd s) rfl rfl (by decide) hnt (bfeEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, bfeEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := bfeEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (bfeEntrySEnd s)) = lookupVar "c" (bfeEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 bfeCtx bfeNext s bfeMul [bfeRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error bfeCtx bfeNext bfeMul [bfeRet] s "undefined operand" j rfl
          (by decide) (bfeMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 bfeCtx bfeNext s bfeMul [bfeRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error bfeCtx bfeNext bfeMul [bfeRet] s "undefined operand" j rfl
            (by decide) (bfeMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 bfeCtx bfeNext s bfeMul [bfeRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof bfeCtx bfeNext 1 [bfeMul] bfeRet bfeMul [bfeRet] s
                   (bfeNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (bfeNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, bfeNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 bfeCtx bfeNext s bfeMul [bfeRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof bfeCtx bfeNext 1 [bfeMul] bfeRet bfeMul [bfeRet] s
                   (bfeNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (bfeNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, bfeNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 bfeCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem bfeFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 bfeCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 bfeCtx vs
      = runBlocks 10 bfeCtx bfeFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, bfeCtx, bfeFn, lookupFunction, fnEntryLabel, bfeEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (bfeEntrySEnd s0) with hs1
  have hentry : runBlock 9 bfeCtx bfeEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact bfeEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb bfeFn.blocks = some bfeEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 bfeCtx bfeFn s0 = runBlocks 9 bfeCtx bfeFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := bfeEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (bfeVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (bfeEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb bfeFn.blocks = some bfeNext := rfl
  have hhalt := bfeNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (bfeVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (BASEFEE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=BASEFEE ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s BASEFEE exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_basefee_ok`) as a whole-function capstone — a bare `BASEFEE`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = bfeVal s` (the block base fee,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_bfeFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
