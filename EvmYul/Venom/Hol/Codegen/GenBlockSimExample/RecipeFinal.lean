/-! ### ✅ A 0-input READ (CODESIZE) via the recipe route — `codegen_correct_cszFn_recipeW`

The environment read `CODESIZE`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_codesize_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). CODESIZE carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = CODESIZE ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`CODESIZE` is a 0-input read (`fV v = EvmYul.UInt256.ofNat v.code.length`), emitted as a bare `CODESIZE` push,
leaving `[a, b, c]` with `c = cszVal s` (the code size — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`cszNext_ready`). -/

def cszCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def cszCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def cszLoad : Instruction :=
  { id := 2, opcode := Opcode.CODESIZE, operands := [], outputs := ["c"] }
def cszJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def cszMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def cszRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def cszEntry : BasicBlock := { label := "entry", instructions := [cszCvA, cszCvB, cszLoad, cszJmp] }
def cszNext : BasicBlock := { label := "next", instructions := [cszMul, cszRet] }
def cszFn : IrFunction := { name := "main", blocks := [cszEntry, cszNext] }
def cszCtx : VenomContext := { functions := [cszFn], entry := some "main" }

theorem csz_unresolved_asm : executePlan (generateFnPlan cszFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "CODESIZE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word CODESIZE pushes (the executing code size); context-dependent, generally NON-zero. -/
abbrev cszVal (s : VenomState) : bytes32 := EvmYul.UInt256.ofNat s.code.length

/-- entry's body `[CV a; CV b; CODESIZE]` as a `RegularBodyH`: two `cv_step`s then the
    CODESIZE push via `RegularStepG`'s 0-input read arm (`asmStep_codesize_ok`), output live. -/
theorem cszEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1 1 [cszCvA, cszCvB, cszLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "CODESIZE", (fun v : VenomState => EvmYul.UInt256.ofNat v.code.length),
     (fun s : AsmState => EvmYul.UInt256.ofNat s.code.length),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_codesize_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, _, _, hcc, _⟩ := hrel
       show EvmYul.UInt256.ofNat s.code.length = EvmYul.UInt256.ofNat v.code.length
       rw [hcc]⟩)))))

/-- Body-end state of `cszEntry`: `a,b := callvalue`, `c := cszVal s` (the code size). -/
abbrev cszEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (cszVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem cszEntry_thread (s : VenomState) :
    execBodyThread [cszCvA, cszCvB, cszLoad] 0 { s with instIdx := 0 } = some (cszEntrySEnd s) := by
  have hsub : stepInstBase cszLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (cszVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [cszLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase cszCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase cszCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase cszCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [cszCvB, cszLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (cszEntrySEnd s)
  rw [h1]
  show (match stepInstBase cszCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [cszLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (cszEntrySEnd s)
  rw [h2]
  show (match stepInstBase cszLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (cszEntrySEnd s)
  rw [hsub]
  rfl

/-- `cszEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem cszEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) cszCtx cszEntry s = ExecResult.OK (jumpTo "next" (cszEntrySEnd s)) :=
  runBlock_body_jmp cszCtx cszEntry j [cszCvA, cszCvB, cszLoad] cszJmp cszCvA [cszCvB, cszLoad, cszJmp] s
    (cszEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (cszEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem cszNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg cszFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([cszMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := cszFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev cszNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem cszNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (cszNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (cszNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem cszNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [cszMul] 0 { s with instIdx := 0 } = some (cszNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase cszMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := cszMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase cszMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem cszMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase cszMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [cszMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem cszMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase cszMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [cszMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem cszNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) cszCtx cszNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (cszNextSEnd s wb wc))
        (cszNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := cszNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return cszCtx cszNext j [cszMul] cszRet cszMul [cszRet] s (cszNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (cszNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem cszNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) cszCtx cszNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := cszNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term cszCtx cszNext j [cszMul] cszRet cszMul [cszRet] s (cszNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (cszNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : cszNext.instructions = [cszMul] ++ [cszRet])
    (cszNext_thread s wb wc hb hc), cszRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `cszEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem cszEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (cszEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (cszEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (cszEntrySEnd s) = some (cszVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (cszVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (cszVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (cszVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def cszInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (cszVal s))

theorem cszInv_pres : ∀ bb ∈ cszFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    cszInv s → runBlock f' cszCtx bb s = ExecResult.OK s' → cszInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [cszFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (cszEntrySEnd s)`
    have hnt : ∀ inst ∈ [cszCvA, cszCvB, cszLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof cszCtx cszEntry 0 [cszCvA, cszCvB, cszLoad] cszJmp cszCvA
             [cszCvB, cszLoad, cszJmp] s (cszEntrySEnd s) rfl rfl (by decide) hnt (cszEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof cszCtx cszEntry 1 [cszCvA, cszCvB, cszLoad] cszJmp cszCvA
             [cszCvB, cszLoad, cszJmp] s (cszEntrySEnd s) rfl rfl (by decide) hnt (cszEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof cszCtx cszEntry 2 [cszCvA, cszCvB, cszLoad] cszJmp cszCvA
             [cszCvB, cszLoad, cszJmp] s (cszEntrySEnd s) rfl rfl (by decide) hnt (cszEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof cszCtx cszEntry 3 [cszCvA, cszCvB, cszLoad] cszJmp cszCvA
             [cszCvB, cszLoad, cszJmp] s (cszEntrySEnd s) rfl rfl (by decide) hnt (cszEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, cszEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := cszEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (cszEntrySEnd s)) = lookupVar "c" (cszEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 cszCtx cszNext s cszMul [cszRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error cszCtx cszNext cszMul [cszRet] s "undefined operand" j rfl
          (by decide) (cszMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 cszCtx cszNext s cszMul [cszRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error cszCtx cszNext cszMul [cszRet] s "undefined operand" j rfl
            (by decide) (cszMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 cszCtx cszNext s cszMul [cszRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof cszCtx cszNext 1 [cszMul] cszRet cszMul [cszRet] s
                   (cszNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (cszNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, cszNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 cszCtx cszNext s cszMul [cszRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof cszCtx cszNext 1 [cszMul] cszRet cszMul [cszRet] s
                   (cszNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (cszNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, cszNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 cszCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem cszFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 cszCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 cszCtx vs
      = runBlocks 10 cszCtx cszFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, cszCtx, cszFn, lookupFunction, fnEntryLabel, cszEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (cszEntrySEnd s0) with hs1
  have hentry : runBlock 9 cszCtx cszEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact cszEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb cszFn.blocks = some cszEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 cszCtx cszFn s0 = runBlocks 9 cszCtx cszFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := cszEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (cszVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (cszEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb cszFn.blocks = some cszNext := rfl
  have hhalt := cszNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (cszVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (CODESIZE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=CODESIZE ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s CODESIZE exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_codesize_ok`) as a whole-function capstone — a bare `CODESIZE`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = cszVal s` (the code size,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_cszFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 cszCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ cszFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [cszFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [cszEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [cszNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan cszFn 0 0
      = some ((generateFnPlan cszFn 0 0).get!.1, (generateFnPlan cszFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel cszFn) cszFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv cszInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel cszFn) cszFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan cszFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := cszCtx) (fn := cszFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan cszFn 0 0).get!.1) (psFinal := (generateFnPlan cszFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ cszInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [cszFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, cszEntry, cszCvA]
    · simp [runBlock, evalPhis, execBlock, cszNext, cszMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [cszFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [cszCvA, cszCvB, cszLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof cszCtx cszEntry 1 [cszCvA, cszCvB, cszLoad] cszJmp cszCvA
               [cszCvB, cszLoad, cszJmp] s (cszEntrySEnd s) rfl rfl (by decide) hnt (cszEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof cszCtx cszEntry 2 [cszCvA, cszCvB, cszLoad] cszJmp cszCvA
               [cszCvB, cszLoad, cszJmp] s (cszEntrySEnd s) rfl rfl (by decide) hnt (cszEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof cszCtx cszEntry 3 [cszCvA, cszCvB, cszLoad] cszJmp cszCvA
               [cszCvB, cszLoad, cszJmp] s (cszEntrySEnd s) rfl rfl (by decide) hnt (cszEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([cszCvA, cszCvB, cszLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [cszCvA, cszCvB, cszLoad]) (jmpInst := cszJmp) (hd := cszCvA) (tl := [cszCvB, cszLoad, cszJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := cszNext) (sEnd := cszEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := cszEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := cszEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof cszCtx cszNext 1 [cszMul] cszRet cszMul [cszRet] s
               (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (cszNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([cszMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [cszMul]) (retInst := cszRet) (hd := cszMul) (tl := [cszRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel cszFn) cszFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := cszNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s))
            = lookupVar "e" (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s)) from rfl,
            (cszNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cszVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s))
            = lookupVar "a" (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s)) from rfl,
            (cszNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cszVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s)) from rfl,
            (cszNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cszVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (cszNextSEnd s (EvmYul.UInt256.ofNat 0) (cszVal s)) from rfl,
            (cszNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (cszVal s)).2]; exact ha0)
        (hready := cszNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel cszFn) cszFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨cszEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel cszFn) cszFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan cszFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (RETURNDATASIZE) via the recipe route — `codegen_correct_rdsFn_recipeW`

The environment read `RETURNDATASIZE`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_returndatasize_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). RETURNDATASIZE carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = RETURNDATASIZE ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`RETURNDATASIZE` is a 0-input read (`fV v = EvmYul.UInt256.ofNat v.returndata.size`), emitted as a bare `RETURNDATASIZE` push,
leaving `[a, b, c]` with `c = rdsVal s` (the returndata size — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`rdsNext_ready`). -/

def rdsCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def rdsCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def rdsLoad : Instruction :=
  { id := 2, opcode := Opcode.RETURNDATASIZE, operands := [], outputs := ["c"] }
def rdsJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def rdsMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def rdsRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def rdsEntry : BasicBlock := { label := "entry", instructions := [rdsCvA, rdsCvB, rdsLoad, rdsJmp] }
def rdsNext : BasicBlock := { label := "next", instructions := [rdsMul, rdsRet] }
def rdsFn : IrFunction := { name := "main", blocks := [rdsEntry, rdsNext] }
def rdsCtx : VenomContext := { functions := [rdsFn], entry := some "main" }

theorem rds_unresolved_asm : executePlan (generateFnPlan rdsFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "RETURNDATASIZE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word RETURNDATASIZE pushes (the returndata size); context-dependent, generally NON-zero. -/
abbrev rdsVal (s : VenomState) : bytes32 := EvmYul.UInt256.ofNat s.returndata.size

/-- entry's body `[CV a; CV b; RETURNDATASIZE]` as a `RegularBodyH`: two `cv_step`s then the
    RETURNDATASIZE push via `RegularStepG`'s 0-input read arm (`asmStep_returndatasize_ok`), output live. -/
theorem rdsEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1 1 [rdsCvA, rdsCvB, rdsLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "RETURNDATASIZE", (fun v : VenomState => EvmYul.UInt256.ofNat v.returndata.size),
     (fun s : AsmState => EvmYul.UInt256.ofNat s.returndata.size),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_returndatasize_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, hcc, _, _, _, _, _, _⟩ := hrel
       show EvmYul.UInt256.ofNat s.returndata.size = EvmYul.UInt256.ofNat v.returndata.size
       rw [hcc]⟩)))))

/-- Body-end state of `rdsEntry`: `a,b := callvalue`, `c := rdsVal s` (the returndata size). -/
abbrev rdsEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (rdsVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem rdsEntry_thread (s : VenomState) :
    execBodyThread [rdsCvA, rdsCvB, rdsLoad] 0 { s with instIdx := 0 } = some (rdsEntrySEnd s) := by
  have hsub : stepInstBase rdsLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (rdsVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [rdsLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase rdsCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase rdsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase rdsCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [rdsCvB, rdsLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (rdsEntrySEnd s)
  rw [h1]
  show (match stepInstBase rdsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [rdsLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (rdsEntrySEnd s)
  rw [h2]
  show (match stepInstBase rdsLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (rdsEntrySEnd s)
  rw [hsub]
  rfl

/-- `rdsEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem rdsEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) rdsCtx rdsEntry s = ExecResult.OK (jumpTo "next" (rdsEntrySEnd s)) :=
  runBlock_body_jmp rdsCtx rdsEntry j [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA [rdsCvB, rdsLoad, rdsJmp] s
    (rdsEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (rdsEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem rdsNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg rdsFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([rdsMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := rdsFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev rdsNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem rdsNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (rdsNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (rdsNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem rdsNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [rdsMul] 0 { s with instIdx := 0 } = some (rdsNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase rdsMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := rdsMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase rdsMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem rdsMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase rdsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [rdsMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem rdsMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase rdsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [rdsMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem rdsNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) rdsCtx rdsNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (rdsNextSEnd s wb wc))
        (rdsNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := rdsNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return rdsCtx rdsNext j [rdsMul] rdsRet rdsMul [rdsRet] s (rdsNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (rdsNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem rdsNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) rdsCtx rdsNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := rdsNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term rdsCtx rdsNext j [rdsMul] rdsRet rdsMul [rdsRet] s (rdsNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (rdsNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : rdsNext.instructions = [rdsMul] ++ [rdsRet])
    (rdsNext_thread s wb wc hb hc), rdsRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `rdsEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem rdsEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (rdsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (rdsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (rdsEntrySEnd s) = some (rdsVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (rdsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (rdsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (rdsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def rdsInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (rdsVal s))

theorem rdsInv_pres : ∀ bb ∈ rdsFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    rdsInv s → runBlock f' rdsCtx bb s = ExecResult.OK s' → rdsInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [rdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (rdsEntrySEnd s)`
    have hnt : ∀ inst ∈ [rdsCvA, rdsCvB, rdsLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof rdsCtx rdsEntry 0 [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA
             [rdsCvB, rdsLoad, rdsJmp] s (rdsEntrySEnd s) rfl rfl (by decide) hnt (rdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof rdsCtx rdsEntry 1 [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA
             [rdsCvB, rdsLoad, rdsJmp] s (rdsEntrySEnd s) rfl rfl (by decide) hnt (rdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof rdsCtx rdsEntry 2 [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA
             [rdsCvB, rdsLoad, rdsJmp] s (rdsEntrySEnd s) rfl rfl (by decide) hnt (rdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof rdsCtx rdsEntry 3 [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA
             [rdsCvB, rdsLoad, rdsJmp] s (rdsEntrySEnd s) rfl rfl (by decide) hnt (rdsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, rdsEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := rdsEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (rdsEntrySEnd s)) = lookupVar "c" (rdsEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 rdsCtx rdsNext s rdsMul [rdsRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error rdsCtx rdsNext rdsMul [rdsRet] s "undefined operand" j rfl
          (by decide) (rdsMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 rdsCtx rdsNext s rdsMul [rdsRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error rdsCtx rdsNext rdsMul [rdsRet] s "undefined operand" j rfl
            (by decide) (rdsMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 rdsCtx rdsNext s rdsMul [rdsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof rdsCtx rdsNext 1 [rdsMul] rdsRet rdsMul [rdsRet] s
                   (rdsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (rdsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, rdsNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 rdsCtx rdsNext s rdsMul [rdsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof rdsCtx rdsNext 1 [rdsMul] rdsRet rdsMul [rdsRet] s
                   (rdsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (rdsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, rdsNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 rdsCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem rdsFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 rdsCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 rdsCtx vs
      = runBlocks 10 rdsCtx rdsFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, rdsCtx, rdsFn, lookupFunction, fnEntryLabel, rdsEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (rdsEntrySEnd s0) with hs1
  have hentry : runBlock 9 rdsCtx rdsEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact rdsEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb rdsFn.blocks = some rdsEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 rdsCtx rdsFn s0 = runBlocks 9 rdsCtx rdsFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := rdsEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (rdsVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (rdsEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb rdsFn.blocks = some rdsNext := rfl
  have hhalt := rdsNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (rdsVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (RETURNDATASIZE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=RETURNDATASIZE ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s RETURNDATASIZE exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_returndatasize_ok`) as a whole-function capstone — a bare `RETURNDATASIZE`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = rdsVal s` (the returndata size,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_rdsFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 rdsCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ rdsFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [rdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [rdsEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [rdsNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan rdsFn 0 0
      = some ((generateFnPlan rdsFn 0 0).get!.1, (generateFnPlan rdsFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel rdsFn) rdsFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv rdsInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel rdsFn) rdsFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan rdsFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := rdsCtx) (fn := rdsFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan rdsFn 0 0).get!.1) (psFinal := (generateFnPlan rdsFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ rdsInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [rdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, rdsEntry, rdsCvA]
    · simp [runBlock, evalPhis, execBlock, rdsNext, rdsMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [rdsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [rdsCvA, rdsCvB, rdsLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof rdsCtx rdsEntry 1 [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA
               [rdsCvB, rdsLoad, rdsJmp] s (rdsEntrySEnd s) rfl rfl (by decide) hnt (rdsEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof rdsCtx rdsEntry 2 [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA
               [rdsCvB, rdsLoad, rdsJmp] s (rdsEntrySEnd s) rfl rfl (by decide) hnt (rdsEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof rdsCtx rdsEntry 3 [rdsCvA, rdsCvB, rdsLoad] rdsJmp rdsCvA
               [rdsCvB, rdsLoad, rdsJmp] s (rdsEntrySEnd s) rfl rfl (by decide) hnt (rdsEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([rdsCvA, rdsCvB, rdsLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [rdsCvA, rdsCvB, rdsLoad]) (jmpInst := rdsJmp) (hd := rdsCvA) (tl := [rdsCvB, rdsLoad, rdsJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := rdsNext) (sEnd := rdsEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := rdsEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := rdsEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof rdsCtx rdsNext 1 [rdsMul] rdsRet rdsMul [rdsRet] s
               (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (rdsNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([rdsMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [rdsMul]) (retInst := rdsRet) (hd := rdsMul) (tl := [rdsRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel rdsFn) rdsFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := rdsNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s))
            = lookupVar "e" (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s)) from rfl,
            (rdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (rdsVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s))
            = lookupVar "a" (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s)) from rfl,
            (rdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (rdsVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s)) from rfl,
            (rdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (rdsVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (rdsNextSEnd s (EvmYul.UInt256.ofNat 0) (rdsVal s)) from rfl,
            (rdsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (rdsVal s)).2]; exact ha0)
        (hready := rdsNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel rdsFn) rdsFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨rdsEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel rdsFn) rdsFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan rdsFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (SELFBALANCE) via the recipe route — `codegen_correct_sblFn_recipeW`

The environment read `SELFBALANCE`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_selfbalance_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). SELFBALANCE carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SELFBALANCE ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`SELFBALANCE` is a 0-input read (`fV v = EvmYul.UInt256.ofNat (lookupAccount v.callCtx.contract v.accounts).balance`), emitted as a bare `SELFBALANCE` push,
leaving `[a, b, c]` with `c = sblVal s` (the own balance — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`sblNext_ready`). -/

def sblCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def sblCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def sblLoad : Instruction :=
  { id := 2, opcode := Opcode.SELFBALANCE, operands := [], outputs := ["c"] }
def sblJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def sblMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def sblRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def sblEntry : BasicBlock := { label := "entry", instructions := [sblCvA, sblCvB, sblLoad, sblJmp] }
def sblNext : BasicBlock := { label := "next", instructions := [sblMul, sblRet] }
def sblFn : IrFunction := { name := "main", blocks := [sblEntry, sblNext] }
def sblCtx : VenomContext := { functions := [sblFn], entry := some "main" }

theorem sbl_unresolved_asm : executePlan (generateFnPlan sblFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "SELFBALANCE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word SELFBALANCE pushes (the balance of the executing account); context-dependent, generally NON-zero. -/
abbrev sblVal (s : VenomState) : bytes32 := EvmYul.UInt256.ofNat (lookupAccount s.callCtx.contract s.accounts).balance

/-- entry's body `[CV a; CV b; SELFBALANCE]` as a `RegularBodyH`: two `cv_step`s then the
    SELFBALANCE push via `RegularStepG`'s 0-input read arm (`asmStep_selfbalance_ok`), output live. -/
theorem sblEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1 1 [sblCvA, sblCvB, sblLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "SELFBALANCE", (fun v : VenomState => EvmYul.UInt256.ofNat (lookupAccount v.callCtx.contract v.accounts).balance),
     (fun s : AsmState => EvmYul.UInt256.ofNat (lookupAccount s.callCtx.contract s.accounts).balance),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_selfbalance_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, hac, _, _, _, hcc, _, _, _, _⟩ := hrel
       show EvmYul.UInt256.ofNat (lookupAccount s.callCtx.contract s.accounts).balance = EvmYul.UInt256.ofNat (lookupAccount v.callCtx.contract v.accounts).balance
       rw [hcc, hac]⟩)))))

/-- Body-end state of `sblEntry`: `a,b := callvalue`, `c := sblVal s` (the own balance). -/
abbrev sblEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (sblVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem sblEntry_thread (s : VenomState) :
    execBodyThread [sblCvA, sblCvB, sblLoad] 0 { s with instIdx := 0 } = some (sblEntrySEnd s) := by
  have hsub : stepInstBase sblLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (sblVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [sblLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase sblCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase sblCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase sblCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [sblCvB, sblLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (sblEntrySEnd s)
  rw [h1]
  show (match stepInstBase sblCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [sblLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (sblEntrySEnd s)
  rw [h2]
  show (match stepInstBase sblLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (sblEntrySEnd s)
  rw [hsub]
  rfl

/-- `sblEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem sblEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) sblCtx sblEntry s = ExecResult.OK (jumpTo "next" (sblEntrySEnd s)) :=
  runBlock_body_jmp sblCtx sblEntry j [sblCvA, sblCvB, sblLoad] sblJmp sblCvA [sblCvB, sblLoad, sblJmp] s
    (sblEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (sblEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem sblNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg sblFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([sblMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := sblFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev sblNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem sblNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (sblNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (sblNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem sblNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [sblMul] 0 { s with instIdx := 0 } = some (sblNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase sblMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := sblMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase sblMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem sblMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase sblMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [sblMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem sblMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase sblMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [sblMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem sblNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) sblCtx sblNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (sblNextSEnd s wb wc))
        (sblNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := sblNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return sblCtx sblNext j [sblMul] sblRet sblMul [sblRet] s (sblNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sblNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem sblNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) sblCtx sblNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := sblNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term sblCtx sblNext j [sblMul] sblRet sblMul [sblRet] s (sblNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sblNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : sblNext.instructions = [sblMul] ++ [sblRet])
    (sblNext_thread s wb wc hb hc), sblRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `sblEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem sblEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (sblEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (sblEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (sblEntrySEnd s) = some (sblVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (sblVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (sblVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (sblVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def sblInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (sblVal s))

theorem sblInv_pres : ∀ bb ∈ sblFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    sblInv s → runBlock f' sblCtx bb s = ExecResult.OK s' → sblInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [sblFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (sblEntrySEnd s)`
    have hnt : ∀ inst ∈ [sblCvA, sblCvB, sblLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof sblCtx sblEntry 0 [sblCvA, sblCvB, sblLoad] sblJmp sblCvA
             [sblCvB, sblLoad, sblJmp] s (sblEntrySEnd s) rfl rfl (by decide) hnt (sblEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof sblCtx sblEntry 1 [sblCvA, sblCvB, sblLoad] sblJmp sblCvA
             [sblCvB, sblLoad, sblJmp] s (sblEntrySEnd s) rfl rfl (by decide) hnt (sblEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof sblCtx sblEntry 2 [sblCvA, sblCvB, sblLoad] sblJmp sblCvA
             [sblCvB, sblLoad, sblJmp] s (sblEntrySEnd s) rfl rfl (by decide) hnt (sblEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof sblCtx sblEntry 3 [sblCvA, sblCvB, sblLoad] sblJmp sblCvA
             [sblCvB, sblLoad, sblJmp] s (sblEntrySEnd s) rfl rfl (by decide) hnt (sblEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, sblEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := sblEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (sblEntrySEnd s)) = lookupVar "c" (sblEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 sblCtx sblNext s sblMul [sblRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error sblCtx sblNext sblMul [sblRet] s "undefined operand" j rfl
          (by decide) (sblMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 sblCtx sblNext s sblMul [sblRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error sblCtx sblNext sblMul [sblRet] s "undefined operand" j rfl
            (by decide) (sblMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sblCtx sblNext s sblMul [sblRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sblCtx sblNext 1 [sblMul] sblRet sblMul [sblRet] s
                   (sblNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sblNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sblNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sblCtx sblNext s sblMul [sblRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sblCtx sblNext 1 [sblMul] sblRet sblMul [sblRet] s
                   (sblNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sblNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sblNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 sblCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem sblFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 sblCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 sblCtx vs
      = runBlocks 10 sblCtx sblFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, sblCtx, sblFn, lookupFunction, fnEntryLabel, sblEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (sblEntrySEnd s0) with hs1
  have hentry : runBlock 9 sblCtx sblEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact sblEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb sblFn.blocks = some sblEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 sblCtx sblFn s0 = runBlocks 9 sblCtx sblFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := sblEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (sblVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (sblEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb sblFn.blocks = some sblNext := rfl
  have hhalt := sblNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (sblVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (SELFBALANCE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=SELFBALANCE ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s SELFBALANCE exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_selfbalance_ok`) as a whole-function capstone — a bare `SELFBALANCE`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = sblVal s` (the own balance,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_sblFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 sblCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ sblFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [sblFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [sblEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [sblNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan sblFn 0 0
      = some ((generateFnPlan sblFn 0 0).get!.1, (generateFnPlan sblFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel sblFn) sblFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv sblInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel sblFn) sblFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan sblFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := sblCtx) (fn := sblFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan sblFn 0 0).get!.1) (psFinal := (generateFnPlan sblFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ sblInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [sblFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, sblEntry, sblCvA]
    · simp [runBlock, evalPhis, execBlock, sblNext, sblMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [sblFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [sblCvA, sblCvB, sblLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof sblCtx sblEntry 1 [sblCvA, sblCvB, sblLoad] sblJmp sblCvA
               [sblCvB, sblLoad, sblJmp] s (sblEntrySEnd s) rfl rfl (by decide) hnt (sblEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof sblCtx sblEntry 2 [sblCvA, sblCvB, sblLoad] sblJmp sblCvA
               [sblCvB, sblLoad, sblJmp] s (sblEntrySEnd s) rfl rfl (by decide) hnt (sblEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof sblCtx sblEntry 3 [sblCvA, sblCvB, sblLoad] sblJmp sblCvA
               [sblCvB, sblLoad, sblJmp] s (sblEntrySEnd s) rfl rfl (by decide) hnt (sblEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([sblCvA, sblCvB, sblLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [sblCvA, sblCvB, sblLoad]) (jmpInst := sblJmp) (hd := sblCvA) (tl := [sblCvB, sblLoad, sblJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := sblNext) (sEnd := sblEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := sblEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := sblEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof sblCtx sblNext 1 [sblMul] sblRet sblMul [sblRet] s
               (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (sblNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([sblMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [sblMul]) (retInst := sblRet) (hd := sblMul) (tl := [sblRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel sblFn) sblFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := sblNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s))
            = lookupVar "e" (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s)) from rfl,
            (sblNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sblVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s))
            = lookupVar "a" (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s)) from rfl,
            (sblNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sblVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s)) from rfl,
            (sblNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sblVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (sblNextSEnd s (EvmYul.UInt256.ofNat 0) (sblVal s)) from rfl,
