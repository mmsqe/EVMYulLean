    (hpushN : prog.get ⟨as0.pc + (executePlan
        (bodyPlanRIP liveness dfg cfg fn nextLiveness curBbLabel front ps0).1).length, hp1⟩
      = resolveInst offsets (AsmInst.AsmPushLabel ifNz))
