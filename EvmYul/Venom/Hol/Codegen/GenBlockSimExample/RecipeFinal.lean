      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [ecsCvA, ecsCvB, ecsLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof ecsCtx ecsEntry 1 [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA
               [ecsCvB, ecsLoad, ecsJmp] s (ecsEntrySEnd s) rfl rfl (by decide) hnt (ecsEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof ecsCtx ecsEntry 2 [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA
               [ecsCvB, ecsLoad, ecsJmp] s (ecsEntrySEnd s) rfl rfl (by decide) hnt (ecsEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof ecsCtx ecsEntry 3 [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA
               [ecsCvB, ecsLoad, ecsJmp] s (ecsEntrySEnd s) rfl rfl (by decide) hnt (ecsEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([ecsCvA, ecsCvB, ecsLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [ecsCvA, ecsCvB, ecsLoad]) (jmpInst := ecsJmp) (hd := ecsCvA) (tl := [ecsCvB, ecsLoad, ecsJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 9) (bb' := ecsNext) (sEnd := ecsEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := ecsEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := ecsEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 4 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc7 : asm.pc = 7 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof ecsCtx ecsNext 1 [ecsMul] ecsRet ecsMul [ecsRet] s
               (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (ecsNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([ecsMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [ecsMul]) (retInst := ecsRet) (hd := ecsMul) (tl := [ecsRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel ecsFn) ecsFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := ecsNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s))
            = lookupVar "e" (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s)) from rfl,
            (ecsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ecsVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s))
            = lookupVar "a" (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s)) from rfl,
            (ecsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ecsVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s)) from rfl,
            (ecsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ecsVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (ecsNextSEnd s (EvmYul.UInt256.ofNat 0) (ecsVal s)) from rfl,
            (ecsNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ecsVal s)).2]; exact ha0)
        (hready := ecsNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel ecsFn) ecsFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc7]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc7]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc7]; decide) (hret := by simp only [hpc7]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨ecsEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel ecsFn) ecsFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ An ACCOUNT READ (EXTCODEHASH) via the recipe route — `codegen_correct_echFn_recipeW`

The world-state account read `EXTCODEHASH`, third of the account-read family (BALANCE/EXTCODESIZE/EXTCODEHASH)
— same generic account-read arm (`RegularStepG`'s 7th disjunct, `∃ x out name fRead`), now with a `fRead`
that BRANCHES: `⟨0⟩` for an empty-code account, else `keccak256` of the code (`asmStep_extcodehash_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = EXTCODEHASH %a ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                     -- MUL consumes the TOP two (b,c)
```

`EXTCODEHASH %a` is a 1-input account read (`fRead addr accts = if (code empty) then ⟨0⟩ else keccak256 code`),
emitted `DUP2 ; EXTCODEHASH`, leaving `[a, b, c]` with `c = echVal s` (the code hash of the account at
address `callvalue` — context-dependent, generally NON-zero, so `c` cannot itself be a RETURN operand). In
`next` the consuming `MUL %b %c` eats the top two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`,
regardless of `c`), emptying the return window. `a` (bottom) is never buried — no f1a reorder. `entry` via
`hsupplyW_regularJmp`, `next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`echNext_ready`). -/

def echCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def echCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def echLoad : Instruction :=
  { id := 2, opcode := Opcode.EXTCODEHASH, operands := [Operand.Var "a"], outputs := ["c"] }
def echJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def echMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def echRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def echEntry : BasicBlock := { label := "entry", instructions := [echCvA, echCvB, echLoad, echJmp] }
def echNext : BasicBlock := { label := "next", instructions := [echMul, echRet] }
def echFn : IrFunction := { name := "main", blocks := [echEntry, echNext] }
def echCtx : VenomContext := { functions := [echFn], entry := some "main" }

theorem ech_unresolved_asm : executePlan (generateFnPlan echFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP2", AsmInst.AsmOp "EXTCODEHASH", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The code hash EXTCODEHASH reads for the account at address `a` (= the call value); context-dependent, generally NON-zero. -/
abbrev echVal (s : VenomState) : bytes32 :=
  let acct := lookupAccount (AccountAddress.ofUInt256 s.callCtx.callvalue) s.accounts
  if acct.code.isEmpty then (⟨0⟩ : bytes32) else keccak256 (⟨acct.code.toArray⟩ : ByteArray)

/-- entry's body `[CV a; CV b; EXTCODEHASH %a]` as a `RegularBodyH`: two `cv_step`s then the
    EXTCODEHASH read via `RegularStepG`'s account-read arm (`asmStep_extcodehash_ok`), output live. -/
theorem echEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1 1 [echCvA, echCvB, echLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"a", "c", "EXTCODEHASH",
     (fun addr accts => let acct := lookupAccount (AccountAddress.ofUInt256 addr) accts;
      if acct.code.isEmpty then (⟨0⟩ : bytes32) else keccak256 (⟨acct.code.toArray⟩ : ByteArray)),
     rfl, by decide, rfl, fun _ => rfl, rfl, rfl,
     by decide, by decide, by decide, by decide, fun _ h hg => asmStep_extcodehash_ok h hg⟩))))))

/-- Body-end state of `echEntry`: `a,b := callvalue`, `c := echVal s` (the account code hash at address `a`). -/
abbrev echEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (echVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem echEntry_thread (s : VenomState) :
    execBodyThread [echCvA, echCvB, echLoad] 0 { s with instIdx := 0 } = some (echEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub : stepInstBase echLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (echVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    have he : evalOperand (Operand.Var "a") ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := hla
    simp only [echLoad, stepInstBase, execRead1, he]
    rfl
  have h1 : stepInstBase echCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase echCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase echCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [echCvB, echLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (echEntrySEnd s)
  rw [h1]
  show (match stepInstBase echCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [echLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (echEntrySEnd s)
  rw [h2]
  show (match stepInstBase echLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (echEntrySEnd s)
  rw [hsub]
  rfl

/-- `echEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem echEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) echCtx echEntry s = ExecResult.OK (jumpTo "next" (echEntrySEnd s)) :=
  runBlock_body_jmp echCtx echEntry j [echCvA, echCvB, echLoad] echJmp echCvA [echCvB, echLoad, echJmp] s
    (echEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (echEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem echNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg echFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([echMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := echFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev echNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem echNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (echNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (echNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem echNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [echMul] 0 { s with instIdx := 0 } = some (echNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase echMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := echMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase echMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem echMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase echMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [echMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem echMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase echMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [echMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem echNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) echCtx echNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (echNextSEnd s wb wc))
        (echNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := echNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return echCtx echNext j [echMul] echRet echMul [echRet] s (echNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (echNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem echNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) echCtx echNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := echNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term echCtx echNext j [echMul] echRet echMul [echRet] s (echNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (echNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : echNext.instructions = [echMul] ++ [echRet])
    (echNext_thread s wb wc hb hc), echRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `echEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem echEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (echEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (echEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (echEntrySEnd s) = some (echVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (echVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (echVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (echVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def echInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (echVal s))

theorem echInv_pres : ∀ bb ∈ echFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    echInv s → runBlock f' echCtx bb s = ExecResult.OK s' → echInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [echFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (echEntrySEnd s)`
    have hnt : ∀ inst ∈ [echCvA, echCvB, echLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof echCtx echEntry 0 [echCvA, echCvB, echLoad] echJmp echCvA
             [echCvB, echLoad, echJmp] s (echEntrySEnd s) rfl rfl (by decide) hnt (echEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof echCtx echEntry 1 [echCvA, echCvB, echLoad] echJmp echCvA
             [echCvB, echLoad, echJmp] s (echEntrySEnd s) rfl rfl (by decide) hnt (echEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof echCtx echEntry 2 [echCvA, echCvB, echLoad] echJmp echCvA
             [echCvB, echLoad, echJmp] s (echEntrySEnd s) rfl rfl (by decide) hnt (echEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof echCtx echEntry 3 [echCvA, echCvB, echLoad] echJmp echCvA
             [echCvB, echLoad, echJmp] s (echEntrySEnd s) rfl rfl (by decide) hnt (echEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, echEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := echEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (echEntrySEnd s)) = lookupVar "c" (echEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 echCtx echNext s echMul [echRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error echCtx echNext echMul [echRet] s "undefined operand" j rfl
          (by decide) (echMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 echCtx echNext s echMul [echRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error echCtx echNext echMul [echRet] s "undefined operand" j rfl
            (by decide) (echMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 echCtx echNext s echMul [echRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof echCtx echNext 1 [echMul] echRet echMul [echRet] s
                   (echNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (echNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, echNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 echCtx echNext s echMul [echRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof echCtx echNext 1 [echMul] echRet echMul [echRet] s
                   (echNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (echNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, echNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 echCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem echFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 echCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 echCtx vs
      = runBlocks 10 echCtx echFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, echCtx, echFn, lookupFunction, fnEntryLabel, echEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (echEntrySEnd s0) with hs1
  have hentry : runBlock 9 echCtx echEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact echEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb echFn.blocks = some echEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 echCtx echFn s0 = runBlocks 9 echCtx echFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := echEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (echVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (echEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb echFn.blocks = some echNext := rfl
  have hhalt := echNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (echVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **An ACCOUNT READ (EXTCODEHASH) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=EXTCODEHASH %a ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s EXTCODEHASH exercises `RegularStepG`'s generic
    account-read arm (`∃ x out name fRead`, `asmStep_extcodehash_ok`), emitted `DUP2 ; EXTCODEHASH`, leaving
    `c = echVal s` (the code hash of the account at address `callvalue`, context-dependent). `next`'s MUL
    consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒ `e = 0`
    (`uint256_zero_mul`) empties the return window. `next` ends in a body-then-RETURN handled by
    `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_echFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 echCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ echFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [echFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [echEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [echNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan echFn 0 0
      = some ((generateFnPlan echFn 0 0).get!.1, (generateFnPlan echFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel echFn) echFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv echInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel echFn) echFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan echFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := echCtx) (fn := echFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan echFn 0 0).get!.1) (psFinal := (generateFnPlan echFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ echInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [echFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, echEntry, echCvA]
    · simp [runBlock, evalPhis, execBlock, echNext, echMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [echFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [echCvA, echCvB, echLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof echCtx echEntry 1 [echCvA, echCvB, echLoad] echJmp echCvA
               [echCvB, echLoad, echJmp] s (echEntrySEnd s) rfl rfl (by decide) hnt (echEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof echCtx echEntry 2 [echCvA, echCvB, echLoad] echJmp echCvA
               [echCvB, echLoad, echJmp] s (echEntrySEnd s) rfl rfl (by decide) hnt (echEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof echCtx echEntry 3 [echCvA, echCvB, echLoad] echJmp echCvA
               [echCvB, echLoad, echJmp] s (echEntrySEnd s) rfl rfl (by decide) hnt (echEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([echCvA, echCvB, echLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [echCvA, echCvB, echLoad]) (jmpInst := echJmp) (hd := echCvA) (tl := [echCvB, echLoad, echJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 9) (bb' := echNext) (sEnd := echEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := echEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := echEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 4 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc7 : asm.pc = 7 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof echCtx echNext 1 [echMul] echRet echMul [echRet] s
               (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (echNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([echMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [echMul]) (retInst := echRet) (hd := echMul) (tl := [echRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel echFn) echFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := echNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s))
            = lookupVar "e" (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s)) from rfl,
            (echNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (echVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s))
            = lookupVar "a" (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s)) from rfl,
            (echNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (echVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s)) from rfl,
            (echNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (echVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (echNextSEnd s (EvmYul.UInt256.ofNat 0) (echVal s)) from rfl,
            (echNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (echVal s)).2]; exact ha0)
        (hready := echNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel echFn) echFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc7]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc7]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc7]; decide) (hret := by simp only [hpc7]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨echEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel echFn) echFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan echFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (ADDRESS) via the recipe route — `codegen_correct_adrFn_recipeW`

The environment read `ADDRESS`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_address_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). ADDRESS carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = ADDRESS ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`ADDRESS` is a 0-input read (`fV v = addressToWord v.callCtx.contract`), emitted as a bare `ADDRESS` push,
leaving `[a, b, c]` with `c = adrVal s` (the contract address — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`adrNext_ready`). -/

def adrCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def adrCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def adrLoad : Instruction :=
  { id := 2, opcode := Opcode.ADDRESS, operands := [], outputs := ["c"] }
def adrJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def adrMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def adrRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def adrEntry : BasicBlock := { label := "entry", instructions := [adrCvA, adrCvB, adrLoad, adrJmp] }
def adrNext : BasicBlock := { label := "next", instructions := [adrMul, adrRet] }
def adrFn : IrFunction := { name := "main", blocks := [adrEntry, adrNext] }
def adrCtx : VenomContext := { functions := [adrFn], entry := some "main" }

theorem adr_unresolved_asm : executePlan (generateFnPlan adrFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "ADDRESS", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word ADDRESS pushes (the contract address, zero-extended); context-dependent, generally NON-zero. -/
abbrev adrVal (s : VenomState) : bytes32 := addressToWord s.callCtx.contract

/-- entry's body `[CV a; CV b; ADDRESS]` as a `RegularBodyH`: two `cv_step`s then the
    ADDRESS push via `RegularStepG`'s 0-input read arm (`asmStep_address_ok`), output live. -/
theorem adrEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1 1 [adrCvA, adrCvB, adrLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "ADDRESS", (fun v : VenomState => addressToWord v.callCtx.contract),
     (fun s : AsmState => addressToWord s.callCtx.contract),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_address_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, hcc, _, _, _, _⟩ := hrel
       show addressToWord s.callCtx.contract = addressToWord v.callCtx.contract
       rw [hcc]⟩)))))

/-- Body-end state of `adrEntry`: `a,b := callvalue`, `c := adrVal s` (the contract address). -/
abbrev adrEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (adrVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem adrEntry_thread (s : VenomState) :
    execBodyThread [adrCvA, adrCvB, adrLoad] 0 { s with instIdx := 0 } = some (adrEntrySEnd s) := by
  have hsub : stepInstBase adrLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (adrVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [adrLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase adrCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase adrCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase adrCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [adrCvB, adrLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (adrEntrySEnd s)
  rw [h1]
  show (match stepInstBase adrCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [adrLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (adrEntrySEnd s)
  rw [h2]
  show (match stepInstBase adrLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (adrEntrySEnd s)
  rw [hsub]
  rfl

/-- `adrEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem adrEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) adrCtx adrEntry s = ExecResult.OK (jumpTo "next" (adrEntrySEnd s)) :=
  runBlock_body_jmp adrCtx adrEntry j [adrCvA, adrCvB, adrLoad] adrJmp adrCvA [adrCvB, adrLoad, adrJmp] s
    (adrEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (adrEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem adrNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg adrFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([adrMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := adrFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev adrNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem adrNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (adrNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (adrNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem adrNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [adrMul] 0 { s with instIdx := 0 } = some (adrNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase adrMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := adrMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase adrMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem adrMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase adrMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [adrMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem adrMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase adrMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [adrMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem adrNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) adrCtx adrNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (adrNextSEnd s wb wc))
        (adrNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := adrNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return adrCtx adrNext j [adrMul] adrRet adrMul [adrRet] s (adrNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (adrNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem adrNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) adrCtx adrNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := adrNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term adrCtx adrNext j [adrMul] adrRet adrMul [adrRet] s (adrNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (adrNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : adrNext.instructions = [adrMul] ++ [adrRet])
    (adrNext_thread s wb wc hb hc), adrRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `adrEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem adrEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (adrEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (adrEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (adrEntrySEnd s) = some (adrVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (adrVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (adrVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (adrVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def adrInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (adrVal s))

theorem adrInv_pres : ∀ bb ∈ adrFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    adrInv s → runBlock f' adrCtx bb s = ExecResult.OK s' → adrInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [adrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (adrEntrySEnd s)`
    have hnt : ∀ inst ∈ [adrCvA, adrCvB, adrLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof adrCtx adrEntry 0 [adrCvA, adrCvB, adrLoad] adrJmp adrCvA
             [adrCvB, adrLoad, adrJmp] s (adrEntrySEnd s) rfl rfl (by decide) hnt (adrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof adrCtx adrEntry 1 [adrCvA, adrCvB, adrLoad] adrJmp adrCvA
             [adrCvB, adrLoad, adrJmp] s (adrEntrySEnd s) rfl rfl (by decide) hnt (adrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof adrCtx adrEntry 2 [adrCvA, adrCvB, adrLoad] adrJmp adrCvA
             [adrCvB, adrLoad, adrJmp] s (adrEntrySEnd s) rfl rfl (by decide) hnt (adrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof adrCtx adrEntry 3 [adrCvA, adrCvB, adrLoad] adrJmp adrCvA
             [adrCvB, adrLoad, adrJmp] s (adrEntrySEnd s) rfl rfl (by decide) hnt (adrEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, adrEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := adrEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (adrEntrySEnd s)) = lookupVar "c" (adrEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 adrCtx adrNext s adrMul [adrRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error adrCtx adrNext adrMul [adrRet] s "undefined operand" j rfl
          (by decide) (adrMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 adrCtx adrNext s adrMul [adrRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error adrCtx adrNext adrMul [adrRet] s "undefined operand" j rfl
            (by decide) (adrMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 adrCtx adrNext s adrMul [adrRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof adrCtx adrNext 1 [adrMul] adrRet adrMul [adrRet] s
                   (adrNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (adrNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, adrNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 adrCtx adrNext s adrMul [adrRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof adrCtx adrNext 1 [adrMul] adrRet adrMul [adrRet] s
                   (adrNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (adrNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, adrNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 adrCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem adrFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 adrCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 adrCtx vs
      = runBlocks 10 adrCtx adrFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, adrCtx, adrFn, lookupFunction, fnEntryLabel, adrEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (adrEntrySEnd s0) with hs1
  have hentry : runBlock 9 adrCtx adrEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact adrEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb adrFn.blocks = some adrEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 adrCtx adrFn s0 = runBlocks 9 adrCtx adrFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := adrEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (adrVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (adrEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb adrFn.blocks = some adrNext := rfl
  have hhalt := adrNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (adrVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (ADDRESS) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=ADDRESS ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s ADDRESS exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_address_ok`) as a whole-function capstone — a bare `ADDRESS`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = adrVal s` (the contract address,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_adrFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 adrCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ adrFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [adrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [adrEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [adrNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan adrFn 0 0
      = some ((generateFnPlan adrFn 0 0).get!.1, (generateFnPlan adrFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel adrFn) adrFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv adrInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel adrFn) adrFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan adrFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := adrCtx) (fn := adrFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan adrFn 0 0).get!.1) (psFinal := (generateFnPlan adrFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ adrInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [adrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, adrEntry, adrCvA]
    · simp [runBlock, evalPhis, execBlock, adrNext, adrMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [adrFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [adrCvA, adrCvB, adrLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof adrCtx adrEntry 1 [adrCvA, adrCvB, adrLoad] adrJmp adrCvA
               [adrCvB, adrLoad, adrJmp] s (adrEntrySEnd s) rfl rfl (by decide) hnt (adrEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof adrCtx adrEntry 2 [adrCvA, adrCvB, adrLoad] adrJmp adrCvA
               [adrCvB, adrLoad, adrJmp] s (adrEntrySEnd s) rfl rfl (by decide) hnt (adrEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof adrCtx adrEntry 3 [adrCvA, adrCvB, adrLoad] adrJmp adrCvA
               [adrCvB, adrLoad, adrJmp] s (adrEntrySEnd s) rfl rfl (by decide) hnt (adrEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([adrCvA, adrCvB, adrLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [adrCvA, adrCvB, adrLoad]) (jmpInst := adrJmp) (hd := adrCvA) (tl := [adrCvB, adrLoad, adrJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := adrNext) (sEnd := adrEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := adrEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := adrEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof adrCtx adrNext 1 [adrMul] adrRet adrMul [adrRet] s
               (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (adrNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([adrMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [adrMul]) (retInst := adrRet) (hd := adrMul) (tl := [adrRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel adrFn) adrFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := adrNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s))
            = lookupVar "e" (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s)) from rfl,
            (adrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (adrVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s))
            = lookupVar "a" (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s)) from rfl,
            (adrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (adrVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s)) from rfl,
            (adrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (adrVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (adrNextSEnd s (EvmYul.UInt256.ofNat 0) (adrVal s)) from rfl,
            (adrNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (adrVal s)).2]; exact ha0)
        (hready := adrNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel adrFn) adrFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨adrEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel adrFn) adrFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan adrFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (ORIGIN) via the recipe route — `codegen_correct_orgFn_recipeW`

The environment read `ORIGIN`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_origin_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). ORIGIN carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = ORIGIN ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`ORIGIN` is a 0-input read (`fV v = addressToWord v.txCtx.origin`), emitted as a bare `ORIGIN` push,
leaving `[a, b, c]` with `c = orgVal s` (the origin address — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`orgNext_ready`). -/

def orgCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def orgCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def orgLoad : Instruction :=
  { id := 2, opcode := Opcode.ORIGIN, operands := [], outputs := ["c"] }
def orgJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def orgMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def orgRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def orgEntry : BasicBlock := { label := "entry", instructions := [orgCvA, orgCvB, orgLoad, orgJmp] }
def orgNext : BasicBlock := { label := "next", instructions := [orgMul, orgRet] }
def orgFn : IrFunction := { name := "main", blocks := [orgEntry, orgNext] }
def orgCtx : VenomContext := { functions := [orgFn], entry := some "main" }

theorem org_unresolved_asm : executePlan (generateFnPlan orgFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "ORIGIN", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word ORIGIN pushes (the transaction origin address, zero-extended); context-dependent, generally NON-zero. -/
abbrev orgVal (s : VenomState) : bytes32 := addressToWord s.txCtx.origin

/-- entry's body `[CV a; CV b; ORIGIN]` as a `RegularBodyH`: two `cv_step`s then the
    ORIGIN push via `RegularStepG`'s 0-input read arm (`asmStep_origin_ok`), output live. -/
theorem orgEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1 1 [orgCvA, orgCvB, orgLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "ORIGIN", (fun v : VenomState => addressToWord v.txCtx.origin),
     (fun s : AsmState => addressToWord s.txCtx.origin),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_origin_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, hcc, _, _, _⟩ := hrel
       show addressToWord s.txCtx.origin = addressToWord v.txCtx.origin
       rw [hcc]⟩)))))

/-- Body-end state of `orgEntry`: `a,b := callvalue`, `c := orgVal s` (the origin address). -/
abbrev orgEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (orgVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem orgEntry_thread (s : VenomState) :
    execBodyThread [orgCvA, orgCvB, orgLoad] 0 { s with instIdx := 0 } = some (orgEntrySEnd s) := by
  have hsub : stepInstBase orgLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (orgVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [orgLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase orgCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase orgCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase orgCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [orgCvB, orgLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (orgEntrySEnd s)
  rw [h1]
  show (match stepInstBase orgCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [orgLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (orgEntrySEnd s)
  rw [h2]
  show (match stepInstBase orgLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (orgEntrySEnd s)
  rw [hsub]
  rfl

/-- `orgEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem orgEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) orgCtx orgEntry s = ExecResult.OK (jumpTo "next" (orgEntrySEnd s)) :=
  runBlock_body_jmp orgCtx orgEntry j [orgCvA, orgCvB, orgLoad] orgJmp orgCvA [orgCvB, orgLoad, orgJmp] s
    (orgEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (orgEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem orgNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg orgFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([orgMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := orgFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev orgNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem orgNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (orgNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (orgNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem orgNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [orgMul] 0 { s with instIdx := 0 } = some (orgNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase orgMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := orgMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase orgMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem orgMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase orgMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [orgMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem orgMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase orgMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [orgMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem orgNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) orgCtx orgNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (orgNextSEnd s wb wc))
        (orgNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := orgNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return orgCtx orgNext j [orgMul] orgRet orgMul [orgRet] s (orgNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (orgNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem orgNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) orgCtx orgNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := orgNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term orgCtx orgNext j [orgMul] orgRet orgMul [orgRet] s (orgNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (orgNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : orgNext.instructions = [orgMul] ++ [orgRet])
    (orgNext_thread s wb wc hb hc), orgRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `orgEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem orgEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (orgEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (orgEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (orgEntrySEnd s) = some (orgVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (orgVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (orgVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (orgVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def orgInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (orgVal s))

theorem orgInv_pres : ∀ bb ∈ orgFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    orgInv s → runBlock f' orgCtx bb s = ExecResult.OK s' → orgInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [orgFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (orgEntrySEnd s)`
    have hnt : ∀ inst ∈ [orgCvA, orgCvB, orgLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof orgCtx orgEntry 0 [orgCvA, orgCvB, orgLoad] orgJmp orgCvA
             [orgCvB, orgLoad, orgJmp] s (orgEntrySEnd s) rfl rfl (by decide) hnt (orgEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof orgCtx orgEntry 1 [orgCvA, orgCvB, orgLoad] orgJmp orgCvA
             [orgCvB, orgLoad, orgJmp] s (orgEntrySEnd s) rfl rfl (by decide) hnt (orgEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof orgCtx orgEntry 2 [orgCvA, orgCvB, orgLoad] orgJmp orgCvA
             [orgCvB, orgLoad, orgJmp] s (orgEntrySEnd s) rfl rfl (by decide) hnt (orgEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof orgCtx orgEntry 3 [orgCvA, orgCvB, orgLoad] orgJmp orgCvA
             [orgCvB, orgLoad, orgJmp] s (orgEntrySEnd s) rfl rfl (by decide) hnt (orgEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, orgEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := orgEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (orgEntrySEnd s)) = lookupVar "c" (orgEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 orgCtx orgNext s orgMul [orgRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error orgCtx orgNext orgMul [orgRet] s "undefined operand" j rfl
          (by decide) (orgMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 orgCtx orgNext s orgMul [orgRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error orgCtx orgNext orgMul [orgRet] s "undefined operand" j rfl
            (by decide) (orgMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 orgCtx orgNext s orgMul [orgRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof orgCtx orgNext 1 [orgMul] orgRet orgMul [orgRet] s
                   (orgNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (orgNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, orgNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 orgCtx orgNext s orgMul [orgRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof orgCtx orgNext 1 [orgMul] orgRet orgMul [orgRet] s
                   (orgNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (orgNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, orgNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 orgCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem orgFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 orgCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 orgCtx vs
      = runBlocks 10 orgCtx orgFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, orgCtx, orgFn, lookupFunction, fnEntryLabel, orgEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (orgEntrySEnd s0) with hs1
  have hentry : runBlock 9 orgCtx orgEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact orgEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb orgFn.blocks = some orgEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 orgCtx orgFn s0 = runBlocks 9 orgCtx orgFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := orgEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (orgVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (orgEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb orgFn.blocks = some orgNext := rfl
  have hhalt := orgNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (orgVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (ORIGIN) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=ORIGIN ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s ORIGIN exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_origin_ok`) as a whole-function capstone — a bare `ORIGIN`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = orgVal s` (the origin address,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_orgFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 orgCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan orgFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ orgFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [orgFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [orgEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [orgNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan orgFn 0 0
      = some ((generateFnPlan orgFn 0 0).get!.1, (generateFnPlan orgFn 0 0).get!.2) := rfl
