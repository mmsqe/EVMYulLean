/-! ### ✅ A BINOP (SDIV) via the recipe route — `codegen_correct_sdvFn_recipeW`

The non-commutative binop `SDIV` (signed division), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_sdiv_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SDIV %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`SDIV %a %b` is emitted `DUP1 ; DUP3 ; SDIV` (both `a,b` live), leaving `[a, b, c]` with
`c = SDIV(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`sdvNext_ready`). -/

def sdvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def sdvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def sdvLoad : Instruction :=
  { id := 2, opcode := Opcode.SDIV, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def sdvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def sdvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def sdvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def sdvEntry : BasicBlock := { label := "entry", instructions := [sdvCvA, sdvCvB, sdvLoad, sdvJmp] }
def sdvNext : BasicBlock := { label := "next", instructions := [sdvMul, sdvRet] }
def sdvFn : IrFunction := { name := "main", blocks := [sdvEntry, sdvNext] }
def sdvCtx : VenomContext := { functions := [sdvFn], entry := some "main" }

theorem sdv_unresolved_asm : executePlan (generateFnPlan sdvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "SDIV", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop SDIV(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev sdvVal (s : VenomState) : bytes32 := (EvmYul.Venom.Hol.safeSdiv) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; SDIV %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    SDIV compute via `RegularStep`'s non-comm binop arm (`asmStep_sdiv_ok`), output live. -/
theorem sdvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1 1 [sdvCvA, sdvCvB, sdvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "SDIV", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.Venom.Hol.safeSdiv), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_sdiv_ok h hg⟩)⟩

/-- Body-end state of `sdvEntry`: `a,b := callvalue`, `c := sdvVal s` (SDIV(a,b) on the call value). -/
abbrev sdvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (sdvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem sdvEntry_thread (s : VenomState) :
    execBodyThread [sdvCvA, sdvCvB, sdvLoad] 0 { s with instIdx := 0 } = some (sdvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := sdvLoad) (f := EvmYul.Venom.Hol.safeSdiv) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase sdvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase sdvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase sdvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [sdvCvB, sdvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (sdvEntrySEnd s)
  rw [h1]
  show (match stepInstBase sdvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [sdvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (sdvEntrySEnd s)
  rw [h2]
  show (match stepInstBase sdvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (sdvEntrySEnd s)
  rw [hsub]
  rfl

/-- `sdvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem sdvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) sdvCtx sdvEntry s = ExecResult.OK (jumpTo "next" (sdvEntrySEnd s)) :=
  runBlock_body_jmp sdvCtx sdvEntry j [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA [sdvCvB, sdvLoad, sdvJmp] s
    (sdvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (sdvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem sdvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg sdvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([sdvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := sdvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev sdvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem sdvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (sdvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (sdvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem sdvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [sdvMul] 0 { s with instIdx := 0 } = some (sdvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase sdvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := sdvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase sdvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem sdvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase sdvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [sdvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem sdvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase sdvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [sdvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem sdvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) sdvCtx sdvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (sdvNextSEnd s wb wc))
        (sdvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := sdvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return sdvCtx sdvNext j [sdvMul] sdvRet sdvMul [sdvRet] s (sdvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sdvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem sdvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) sdvCtx sdvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := sdvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term sdvCtx sdvNext j [sdvMul] sdvRet sdvMul [sdvRet] s (sdvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sdvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : sdvNext.instructions = [sdvMul] ++ [sdvRet])
    (sdvNext_thread s wb wc hb hc), sdvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `sdvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem sdvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (sdvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (sdvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (sdvEntrySEnd s) = some (sdvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (sdvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (sdvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (sdvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def sdvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (sdvVal s))

theorem sdvInv_pres : ∀ bb ∈ sdvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    sdvInv s → runBlock f' sdvCtx bb s = ExecResult.OK s' → sdvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [sdvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (sdvEntrySEnd s)`
    have hnt : ∀ inst ∈ [sdvCvA, sdvCvB, sdvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof sdvCtx sdvEntry 0 [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA
             [sdvCvB, sdvLoad, sdvJmp] s (sdvEntrySEnd s) rfl rfl (by decide) hnt (sdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof sdvCtx sdvEntry 1 [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA
             [sdvCvB, sdvLoad, sdvJmp] s (sdvEntrySEnd s) rfl rfl (by decide) hnt (sdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof sdvCtx sdvEntry 2 [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA
             [sdvCvB, sdvLoad, sdvJmp] s (sdvEntrySEnd s) rfl rfl (by decide) hnt (sdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof sdvCtx sdvEntry 3 [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA
             [sdvCvB, sdvLoad, sdvJmp] s (sdvEntrySEnd s) rfl rfl (by decide) hnt (sdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, sdvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := sdvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (sdvEntrySEnd s)) = lookupVar "c" (sdvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 sdvCtx sdvNext s sdvMul [sdvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error sdvCtx sdvNext sdvMul [sdvRet] s "undefined operand" j rfl
          (by decide) (sdvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 sdvCtx sdvNext s sdvMul [sdvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error sdvCtx sdvNext sdvMul [sdvRet] s "undefined operand" j rfl
            (by decide) (sdvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sdvCtx sdvNext s sdvMul [sdvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sdvCtx sdvNext 1 [sdvMul] sdvRet sdvMul [sdvRet] s
                   (sdvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sdvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sdvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sdvCtx sdvNext s sdvMul [sdvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sdvCtx sdvNext 1 [sdvMul] sdvRet sdvMul [sdvRet] s
                   (sdvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sdvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sdvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 sdvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem sdvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 sdvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 sdvCtx vs
      = runBlocks 10 sdvCtx sdvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, sdvCtx, sdvFn, lookupFunction, fnEntryLabel, sdvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (sdvEntrySEnd s0) with hs1
  have hentry : runBlock 9 sdvCtx sdvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact sdvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb sdvFn.blocks = some sdvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 sdvCtx sdvFn s0 = runBlocks 9 sdvCtx sdvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := sdvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (sdvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (sdvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb sdvFn.blocks = some sdvNext := rfl
  have hhalt := sdvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (sdvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (SDIV) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=SDIV %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s SDIV exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_sdiv_ok`), emitted `DUP1 ; DUP3 ; SDIV`, leaving `c = SDIV(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_sdvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 sdvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ sdvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [sdvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [sdvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [sdvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan sdvFn 0 0
      = some ((generateFnPlan sdvFn 0 0).get!.1, (generateFnPlan sdvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel sdvFn) sdvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv sdvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel sdvFn) sdvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan sdvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := sdvCtx) (fn := sdvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan sdvFn 0 0).get!.1) (psFinal := (generateFnPlan sdvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ sdvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [sdvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, sdvEntry, sdvCvA]
    · simp [runBlock, evalPhis, execBlock, sdvNext, sdvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [sdvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [sdvCvA, sdvCvB, sdvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof sdvCtx sdvEntry 1 [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA
               [sdvCvB, sdvLoad, sdvJmp] s (sdvEntrySEnd s) rfl rfl (by decide) hnt (sdvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof sdvCtx sdvEntry 2 [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA
               [sdvCvB, sdvLoad, sdvJmp] s (sdvEntrySEnd s) rfl rfl (by decide) hnt (sdvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof sdvCtx sdvEntry 3 [sdvCvA, sdvCvB, sdvLoad] sdvJmp sdvCvA
               [sdvCvB, sdvLoad, sdvJmp] s (sdvEntrySEnd s) rfl rfl (by decide) hnt (sdvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([sdvCvA, sdvCvB, sdvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [sdvCvA, sdvCvB, sdvLoad]) (jmpInst := sdvJmp) (hd := sdvCvA) (tl := [sdvCvB, sdvLoad, sdvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := sdvNext) (sEnd := sdvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := sdvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := sdvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 5 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc8 : asm.pc = 8 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof sdvCtx sdvNext 1 [sdvMul] sdvRet sdvMul [sdvRet] s
               (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (sdvNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([sdvMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [sdvMul]) (retInst := sdvRet) (hd := sdvMul) (tl := [sdvRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel sdvFn) sdvFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := sdvNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s))
            = lookupVar "e" (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s)) from rfl,
            (sdvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sdvVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s))
            = lookupVar "a" (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s)) from rfl,
            (sdvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sdvVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s)) from rfl,
            (sdvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sdvVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (sdvNextSEnd s (EvmYul.UInt256.ofNat 0) (sdvVal s)) from rfl,
            (sdvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sdvVal s)).2]; exact ha0)
        (hready := sdvNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel sdvFn) sdvFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨sdvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel sdvFn) sdvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan sdvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (SMOD) via the recipe route — `codegen_correct_smvFn_recipeW`

The non-commutative binop `SMOD` (signed modulo), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_smod_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SMOD %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`SMOD %a %b` is emitted `DUP1 ; DUP3 ; SMOD` (both `a,b` live), leaving `[a, b, c]` with
`c = SMOD(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`smvNext_ready`). -/

def smvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def smvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def smvLoad : Instruction :=
  { id := 2, opcode := Opcode.SMOD, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def smvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def smvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def smvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def smvEntry : BasicBlock := { label := "entry", instructions := [smvCvA, smvCvB, smvLoad, smvJmp] }
def smvNext : BasicBlock := { label := "next", instructions := [smvMul, smvRet] }
def smvFn : IrFunction := { name := "main", blocks := [smvEntry, smvNext] }
def smvCtx : VenomContext := { functions := [smvFn], entry := some "main" }

theorem smv_unresolved_asm : executePlan (generateFnPlan smvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "SMOD", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop SMOD(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev smvVal (s : VenomState) : bytes32 := (EvmYul.Venom.Hol.safeSmod) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; SMOD %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    SMOD compute via `RegularStep`'s non-comm binop arm (`asmStep_smod_ok`), output live. -/
theorem smvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan smvFn 0 0).get!.1)).1 1 [smvCvA, smvCvB, smvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "SMOD", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.Venom.Hol.safeSmod), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_smod_ok h hg⟩)⟩

/-- Body-end state of `smvEntry`: `a,b := callvalue`, `c := smvVal s` (SMOD(a,b) on the call value). -/
abbrev smvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (smvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem smvEntry_thread (s : VenomState) :
    execBodyThread [smvCvA, smvCvB, smvLoad] 0 { s with instIdx := 0 } = some (smvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := smvLoad) (f := EvmYul.Venom.Hol.safeSmod) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase smvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase smvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase smvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [smvCvB, smvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (smvEntrySEnd s)
  rw [h1]
  show (match stepInstBase smvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [smvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (smvEntrySEnd s)
  rw [h2]
  show (match stepInstBase smvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (smvEntrySEnd s)
  rw [hsub]
  rfl

/-- `smvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem smvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) smvCtx smvEntry s = ExecResult.OK (jumpTo "next" (smvEntrySEnd s)) :=
  runBlock_body_jmp smvCtx smvEntry j [smvCvA, smvCvB, smvLoad] smvJmp smvCvA [smvCvB, smvLoad, smvJmp] s
    (smvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (smvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem smvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan smvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan smvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg smvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([smvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := smvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev smvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem smvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (smvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (smvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem smvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [smvMul] 0 { s with instIdx := 0 } = some (smvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase smvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := smvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase smvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem smvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase smvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [smvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem smvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase smvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [smvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem smvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) smvCtx smvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (smvNextSEnd s wb wc))
        (smvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := smvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return smvCtx smvNext j [smvMul] smvRet smvMul [smvRet] s (smvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (smvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem smvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) smvCtx smvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := smvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term smvCtx smvNext j [smvMul] smvRet smvMul [smvRet] s (smvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (smvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : smvNext.instructions = [smvMul] ++ [smvRet])
    (smvNext_thread s wb wc hb hc), smvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `smvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem smvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (smvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (smvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (smvEntrySEnd s) = some (smvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (smvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (smvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (smvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def smvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (smvVal s))

theorem smvInv_pres : ∀ bb ∈ smvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    smvInv s → runBlock f' smvCtx bb s = ExecResult.OK s' → smvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [smvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (smvEntrySEnd s)`
    have hnt : ∀ inst ∈ [smvCvA, smvCvB, smvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof smvCtx smvEntry 0 [smvCvA, smvCvB, smvLoad] smvJmp smvCvA
             [smvCvB, smvLoad, smvJmp] s (smvEntrySEnd s) rfl rfl (by decide) hnt (smvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof smvCtx smvEntry 1 [smvCvA, smvCvB, smvLoad] smvJmp smvCvA
             [smvCvB, smvLoad, smvJmp] s (smvEntrySEnd s) rfl rfl (by decide) hnt (smvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof smvCtx smvEntry 2 [smvCvA, smvCvB, smvLoad] smvJmp smvCvA
             [smvCvB, smvLoad, smvJmp] s (smvEntrySEnd s) rfl rfl (by decide) hnt (smvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof smvCtx smvEntry 3 [smvCvA, smvCvB, smvLoad] smvJmp smvCvA
             [smvCvB, smvLoad, smvJmp] s (smvEntrySEnd s) rfl rfl (by decide) hnt (smvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, smvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := smvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (smvEntrySEnd s)) = lookupVar "c" (smvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 smvCtx smvNext s smvMul [smvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error smvCtx smvNext smvMul [smvRet] s "undefined operand" j rfl
          (by decide) (smvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 smvCtx smvNext s smvMul [smvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error smvCtx smvNext smvMul [smvRet] s "undefined operand" j rfl
            (by decide) (smvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 smvCtx smvNext s smvMul [smvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof smvCtx smvNext 1 [smvMul] smvRet smvMul [smvRet] s
                   (smvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (smvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, smvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 smvCtx smvNext s smvMul [smvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof smvCtx smvNext 1 [smvMul] smvRet smvMul [smvRet] s
                   (smvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (smvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, smvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 smvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem smvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 smvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 smvCtx vs
      = runBlocks 10 smvCtx smvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, smvCtx, smvFn, lookupFunction, fnEntryLabel, smvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (smvEntrySEnd s0) with hs1
  have hentry : runBlock 9 smvCtx smvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact smvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb smvFn.blocks = some smvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 smvCtx smvFn s0 = runBlocks 9 smvCtx smvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := smvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (smvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (smvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb smvFn.blocks = some smvNext := rfl
  have hhalt := smvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (smvVal s0)
