      = some ((generateFnPlan bretFn 0 0).get!.1, (generateFnPlan bretFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel bretFn) bretFn 0 0 "entry" = initPlanState 0 :=
