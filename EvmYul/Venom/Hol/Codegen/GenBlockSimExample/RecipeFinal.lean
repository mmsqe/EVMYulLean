        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨slvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel slvFn) slvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (SGT) via the recipe route — `codegen_correct_sgvFn_recipeW`

The non-commutative binop `SGT` (signed greater-than), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_sgt_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SGT %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`SGT %a %b` is emitted `DUP1 ; DUP3 ; SGT` (both `a,b` live), leaving `[a, b, c]` with
`c = SGT(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`sgvNext_ready`). -/

def sgvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def sgvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def sgvLoad : Instruction :=
  { id := 2, opcode := Opcode.SGT, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def sgvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def sgvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def sgvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def sgvEntry : BasicBlock := { label := "entry", instructions := [sgvCvA, sgvCvB, sgvLoad, sgvJmp] }
def sgvNext : BasicBlock := { label := "next", instructions := [sgvMul, sgvRet] }
def sgvFn : IrFunction := { name := "main", blocks := [sgvEntry, sgvNext] }
def sgvCtx : VenomContext := { functions := [sgvFn], entry := some "main" }

theorem sgv_unresolved_asm : executePlan (generateFnPlan sgvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "SGT", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop SGT(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev sgvVal (s : VenomState) : bytes32 := (EvmYul.UInt256.sgt) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; SGT %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    SGT compute via `RegularStep`'s non-comm binop arm (`asmStep_sgt_ok`), output live. -/
theorem sgvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1 1 [sgvCvA, sgvCvB, sgvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "SGT", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.UInt256.sgt), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_sgt_ok h hg⟩)⟩

/-- Body-end state of `sgvEntry`: `a,b := callvalue`, `c := sgvVal s` (SGT(a,b) on the call value). -/
abbrev sgvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (sgvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem sgvEntry_thread (s : VenomState) :
    execBodyThread [sgvCvA, sgvCvB, sgvLoad] 0 { s with instIdx := 0 } = some (sgvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := sgvLoad) (f := EvmYul.UInt256.sgt) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase sgvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase sgvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase sgvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [sgvCvB, sgvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (sgvEntrySEnd s)
  rw [h1]
  show (match stepInstBase sgvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [sgvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (sgvEntrySEnd s)
  rw [h2]
  show (match stepInstBase sgvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (sgvEntrySEnd s)
  rw [hsub]
  rfl

/-- `sgvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem sgvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) sgvCtx sgvEntry s = ExecResult.OK (jumpTo "next" (sgvEntrySEnd s)) :=
  runBlock_body_jmp sgvCtx sgvEntry j [sgvCvA, sgvCvB, sgvLoad] sgvJmp sgvCvA [sgvCvB, sgvLoad, sgvJmp] s
    (sgvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (sgvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem sgvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan sgvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg sgvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([sgvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := sgvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev sgvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem sgvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (sgvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (sgvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem sgvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [sgvMul] 0 { s with instIdx := 0 } = some (sgvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase sgvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := sgvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase sgvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem sgvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase sgvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [sgvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem sgvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase sgvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [sgvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem sgvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) sgvCtx sgvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (sgvNextSEnd s wb wc))
        (sgvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := sgvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return sgvCtx sgvNext j [sgvMul] sgvRet sgvMul [sgvRet] s (sgvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sgvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem sgvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) sgvCtx sgvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := sgvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term sgvCtx sgvNext j [sgvMul] sgvRet sgvMul [sgvRet] s (sgvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sgvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : sgvNext.instructions = [sgvMul] ++ [sgvRet])
    (sgvNext_thread s wb wc hb hc), sgvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `sgvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem sgvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (sgvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (sgvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (sgvEntrySEnd s) = some (sgvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (sgvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (sgvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (sgvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def sgvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (sgvVal s))

theorem sgvInv_pres : ∀ bb ∈ sgvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    sgvInv s → runBlock f' sgvCtx bb s = ExecResult.OK s' → sgvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [sgvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (sgvEntrySEnd s)`
    have hnt : ∀ inst ∈ [sgvCvA, sgvCvB, sgvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof sgvCtx sgvEntry 0 [sgvCvA, sgvCvB, sgvLoad] sgvJmp sgvCvA
             [sgvCvB, sgvLoad, sgvJmp] s (sgvEntrySEnd s) rfl rfl (by decide) hnt (sgvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof sgvCtx sgvEntry 1 [sgvCvA, sgvCvB, sgvLoad] sgvJmp sgvCvA
             [sgvCvB, sgvLoad, sgvJmp] s (sgvEntrySEnd s) rfl rfl (by decide) hnt (sgvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof sgvCtx sgvEntry 2 [sgvCvA, sgvCvB, sgvLoad] sgvJmp sgvCvA
             [sgvCvB, sgvLoad, sgvJmp] s (sgvEntrySEnd s) rfl rfl (by decide) hnt (sgvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof sgvCtx sgvEntry 3 [sgvCvA, sgvCvB, sgvLoad] sgvJmp sgvCvA
             [sgvCvB, sgvLoad, sgvJmp] s (sgvEntrySEnd s) rfl rfl (by decide) hnt (sgvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, sgvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := sgvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (sgvEntrySEnd s)) = lookupVar "c" (sgvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 sgvCtx sgvNext s sgvMul [sgvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error sgvCtx sgvNext sgvMul [sgvRet] s "undefined operand" j rfl
          (by decide) (sgvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 sgvCtx sgvNext s sgvMul [sgvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error sgvCtx sgvNext sgvMul [sgvRet] s "undefined operand" j rfl
            (by decide) (sgvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sgvCtx sgvNext s sgvMul [sgvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sgvCtx sgvNext 1 [sgvMul] sgvRet sgvMul [sgvRet] s
                   (sgvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sgvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sgvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sgvCtx sgvNext s sgvMul [sgvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sgvCtx sgvNext 1 [sgvMul] sgvRet sgvMul [sgvRet] s
                   (sgvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sgvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sgvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 sgvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem sgvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 sgvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 sgvCtx vs
      = runBlocks 10 sgvCtx sgvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, sgvCtx, sgvFn, lookupFunction, fnEntryLabel, sgvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (sgvEntrySEnd s0) with hs1
  have hentry : runBlock 9 sgvCtx sgvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact sgvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb sgvFn.blocks = some sgvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 sgvCtx sgvFn s0 = runBlocks 9 sgvCtx sgvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := sgvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (sgvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (sgvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb sgvFn.blocks = some sgvNext := rfl
  have hhalt := sgvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (sgvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (SGT) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=SGT %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s SGT exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_sgt_ok`), emitted `DUP1 ; DUP3 ; SGT`, leaving `c = SGT(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_sgvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
