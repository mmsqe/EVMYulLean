/-! ### ✅ A BINOP (LT) via the recipe route — `codegen_correct_ltvFn_recipeW`

The non-commutative binop `LT` (unsigned less-than), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_lt_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = LT %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`LT %a %b` is emitted `DUP1 ; DUP3 ; LT` (both `a,b` live), leaving `[a, b, c]` with
`c = LT(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`ltvNext_ready`). -/

def ltvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def ltvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def ltvLoad : Instruction :=
  { id := 2, opcode := Opcode.LT, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def ltvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def ltvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def ltvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def ltvEntry : BasicBlock := { label := "entry", instructions := [ltvCvA, ltvCvB, ltvLoad, ltvJmp] }
def ltvNext : BasicBlock := { label := "next", instructions := [ltvMul, ltvRet] }
def ltvFn : IrFunction := { name := "main", blocks := [ltvEntry, ltvNext] }
def ltvCtx : VenomContext := { functions := [ltvFn], entry := some "main" }

theorem ltv_unresolved_asm : executePlan (generateFnPlan ltvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "LT", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop LT(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev ltvVal (s : VenomState) : bytes32 := ((fun x y => EvmYul.Venom.Hol.boolToWord (x < y))) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; LT %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    LT compute via `RegularStep`'s non-comm binop arm (`asmStep_lt_ok`), output live. -/
theorem ltvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1 1 [ltvCvA, ltvCvB, ltvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "LT", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", ((fun x y => EvmYul.Venom.Hol.boolToWord (x < y))), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_lt_ok h hg⟩)⟩

/-- Body-end state of `ltvEntry`: `a,b := callvalue`, `c := ltvVal s` (LT(a,b) on the call value). -/
abbrev ltvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (ltvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem ltvEntry_thread (s : VenomState) :
    execBodyThread [ltvCvA, ltvCvB, ltvLoad] 0 { s with instIdx := 0 } = some (ltvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := ltvLoad) (f := (fun x y => EvmYul.Venom.Hol.boolToWord (x < y))) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase ltvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase ltvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase ltvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [ltvCvB, ltvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (ltvEntrySEnd s)
  rw [h1]
  show (match stepInstBase ltvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [ltvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (ltvEntrySEnd s)
  rw [h2]
  show (match stepInstBase ltvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (ltvEntrySEnd s)
  rw [hsub]
  rfl

/-- `ltvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem ltvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) ltvCtx ltvEntry s = ExecResult.OK (jumpTo "next" (ltvEntrySEnd s)) :=
  runBlock_body_jmp ltvCtx ltvEntry j [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA [ltvCvB, ltvLoad, ltvJmp] s
    (ltvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (ltvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem ltvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg ltvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([ltvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := ltvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev ltvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem ltvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (ltvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (ltvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem ltvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [ltvMul] 0 { s with instIdx := 0 } = some (ltvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase ltvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := ltvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase ltvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem ltvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase ltvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [ltvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem ltvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase ltvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [ltvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem ltvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) ltvCtx ltvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (ltvNextSEnd s wb wc))
        (ltvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := ltvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return ltvCtx ltvNext j [ltvMul] ltvRet ltvMul [ltvRet] s (ltvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (ltvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem ltvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) ltvCtx ltvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := ltvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term ltvCtx ltvNext j [ltvMul] ltvRet ltvMul [ltvRet] s (ltvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (ltvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : ltvNext.instructions = [ltvMul] ++ [ltvRet])
    (ltvNext_thread s wb wc hb hc), ltvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `ltvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem ltvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (ltvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (ltvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (ltvEntrySEnd s) = some (ltvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (ltvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (ltvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (ltvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def ltvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (ltvVal s))

theorem ltvInv_pres : ∀ bb ∈ ltvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    ltvInv s → runBlock f' ltvCtx bb s = ExecResult.OK s' → ltvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [ltvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (ltvEntrySEnd s)`
    have hnt : ∀ inst ∈ [ltvCvA, ltvCvB, ltvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof ltvCtx ltvEntry 0 [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA
             [ltvCvB, ltvLoad, ltvJmp] s (ltvEntrySEnd s) rfl rfl (by decide) hnt (ltvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof ltvCtx ltvEntry 1 [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA
             [ltvCvB, ltvLoad, ltvJmp] s (ltvEntrySEnd s) rfl rfl (by decide) hnt (ltvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof ltvCtx ltvEntry 2 [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA
             [ltvCvB, ltvLoad, ltvJmp] s (ltvEntrySEnd s) rfl rfl (by decide) hnt (ltvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof ltvCtx ltvEntry 3 [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA
             [ltvCvB, ltvLoad, ltvJmp] s (ltvEntrySEnd s) rfl rfl (by decide) hnt (ltvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, ltvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := ltvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (ltvEntrySEnd s)) = lookupVar "c" (ltvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 ltvCtx ltvNext s ltvMul [ltvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error ltvCtx ltvNext ltvMul [ltvRet] s "undefined operand" j rfl
          (by decide) (ltvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 ltvCtx ltvNext s ltvMul [ltvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error ltvCtx ltvNext ltvMul [ltvRet] s "undefined operand" j rfl
            (by decide) (ltvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 ltvCtx ltvNext s ltvMul [ltvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof ltvCtx ltvNext 1 [ltvMul] ltvRet ltvMul [ltvRet] s
                   (ltvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (ltvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, ltvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 ltvCtx ltvNext s ltvMul [ltvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof ltvCtx ltvNext 1 [ltvMul] ltvRet ltvMul [ltvRet] s
                   (ltvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (ltvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, ltvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 ltvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem ltvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 ltvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 ltvCtx vs
      = runBlocks 10 ltvCtx ltvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, ltvCtx, ltvFn, lookupFunction, fnEntryLabel, ltvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (ltvEntrySEnd s0) with hs1
  have hentry : runBlock 9 ltvCtx ltvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact ltvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb ltvFn.blocks = some ltvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 ltvCtx ltvFn s0 = runBlocks 9 ltvCtx ltvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := ltvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (ltvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (ltvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb ltvFn.blocks = some ltvNext := rfl
  have hhalt := ltvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (ltvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (LT) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=LT %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s LT exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_lt_ok`), emitted `DUP1 ; DUP3 ; LT`, leaving `c = LT(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_ltvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 ltvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ ltvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [ltvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [ltvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [ltvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan ltvFn 0 0
      = some ((generateFnPlan ltvFn 0 0).get!.1, (generateFnPlan ltvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel ltvFn) ltvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv ltvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel ltvFn) ltvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan ltvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := ltvCtx) (fn := ltvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan ltvFn 0 0).get!.1) (psFinal := (generateFnPlan ltvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ ltvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [ltvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, ltvEntry, ltvCvA]
    · simp [runBlock, evalPhis, execBlock, ltvNext, ltvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [ltvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [ltvCvA, ltvCvB, ltvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof ltvCtx ltvEntry 1 [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA
               [ltvCvB, ltvLoad, ltvJmp] s (ltvEntrySEnd s) rfl rfl (by decide) hnt (ltvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof ltvCtx ltvEntry 2 [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA
               [ltvCvB, ltvLoad, ltvJmp] s (ltvEntrySEnd s) rfl rfl (by decide) hnt (ltvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof ltvCtx ltvEntry 3 [ltvCvA, ltvCvB, ltvLoad] ltvJmp ltvCvA
               [ltvCvB, ltvLoad, ltvJmp] s (ltvEntrySEnd s) rfl rfl (by decide) hnt (ltvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([ltvCvA, ltvCvB, ltvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [ltvCvA, ltvCvB, ltvLoad]) (jmpInst := ltvJmp) (hd := ltvCvA) (tl := [ltvCvB, ltvLoad, ltvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := ltvNext) (sEnd := ltvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := ltvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := ltvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 5 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc8 : asm.pc = 8 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof ltvCtx ltvNext 1 [ltvMul] ltvRet ltvMul [ltvRet] s
               (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (ltvNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([ltvMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [ltvMul]) (retInst := ltvRet) (hd := ltvMul) (tl := [ltvRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel ltvFn) ltvFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := ltvNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s))
            = lookupVar "e" (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s)) from rfl,
            (ltvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ltvVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s))
            = lookupVar "a" (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s)) from rfl,
            (ltvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ltvVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s)) from rfl,
            (ltvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ltvVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (ltvNextSEnd s (EvmYul.UInt256.ofNat 0) (ltvVal s)) from rfl,
            (ltvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (ltvVal s)).2]; exact ha0)
        (hready := ltvNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel ltvFn) ltvFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨ltvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel ltvFn) ltvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan ltvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (GT) via the recipe route — `codegen_correct_gtvFn_recipeW`

The non-commutative binop `GT` (unsigned greater-than), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_gt_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = GT %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`GT %a %b` is emitted `DUP1 ; DUP3 ; GT` (both `a,b` live), leaving `[a, b, c]` with
`c = GT(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`gtvNext_ready`). -/

def gtvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def gtvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def gtvLoad : Instruction :=
  { id := 2, opcode := Opcode.GT, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def gtvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def gtvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def gtvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def gtvEntry : BasicBlock := { label := "entry", instructions := [gtvCvA, gtvCvB, gtvLoad, gtvJmp] }
def gtvNext : BasicBlock := { label := "next", instructions := [gtvMul, gtvRet] }
def gtvFn : IrFunction := { name := "main", blocks := [gtvEntry, gtvNext] }
def gtvCtx : VenomContext := { functions := [gtvFn], entry := some "main" }

theorem gtv_unresolved_asm : executePlan (generateFnPlan gtvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "GT", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop GT(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev gtvVal (s : VenomState) : bytes32 := ((fun x y => EvmYul.Venom.Hol.boolToWord (x > y))) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; GT %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    GT compute via `RegularStep`'s non-comm binop arm (`asmStep_gt_ok`), output live. -/
theorem gtvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1 1 [gtvCvA, gtvCvB, gtvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "GT", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", ((fun x y => EvmYul.Venom.Hol.boolToWord (x > y))), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_gt_ok h hg⟩)⟩

/-- Body-end state of `gtvEntry`: `a,b := callvalue`, `c := gtvVal s` (GT(a,b) on the call value). -/
abbrev gtvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (gtvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem gtvEntry_thread (s : VenomState) :
    execBodyThread [gtvCvA, gtvCvB, gtvLoad] 0 { s with instIdx := 0 } = some (gtvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := gtvLoad) (f := (fun x y => EvmYul.Venom.Hol.boolToWord (x > y))) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase gtvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase gtvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase gtvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [gtvCvB, gtvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (gtvEntrySEnd s)
  rw [h1]
  show (match stepInstBase gtvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [gtvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (gtvEntrySEnd s)
  rw [h2]
  show (match stepInstBase gtvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (gtvEntrySEnd s)
  rw [hsub]
  rfl

/-- `gtvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem gtvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) gtvCtx gtvEntry s = ExecResult.OK (jumpTo "next" (gtvEntrySEnd s)) :=
  runBlock_body_jmp gtvCtx gtvEntry j [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA [gtvCvB, gtvLoad, gtvJmp] s
    (gtvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (gtvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem gtvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg gtvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([gtvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := gtvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev gtvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem gtvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (gtvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (gtvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem gtvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [gtvMul] 0 { s with instIdx := 0 } = some (gtvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase gtvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := gtvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase gtvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem gtvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase gtvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [gtvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem gtvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase gtvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [gtvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem gtvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) gtvCtx gtvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (gtvNextSEnd s wb wc))
        (gtvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := gtvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return gtvCtx gtvNext j [gtvMul] gtvRet gtvMul [gtvRet] s (gtvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (gtvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem gtvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) gtvCtx gtvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := gtvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term gtvCtx gtvNext j [gtvMul] gtvRet gtvMul [gtvRet] s (gtvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (gtvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : gtvNext.instructions = [gtvMul] ++ [gtvRet])
    (gtvNext_thread s wb wc hb hc), gtvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `gtvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem gtvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (gtvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (gtvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (gtvEntrySEnd s) = some (gtvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (gtvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (gtvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (gtvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def gtvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (gtvVal s))

theorem gtvInv_pres : ∀ bb ∈ gtvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    gtvInv s → runBlock f' gtvCtx bb s = ExecResult.OK s' → gtvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [gtvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (gtvEntrySEnd s)`
    have hnt : ∀ inst ∈ [gtvCvA, gtvCvB, gtvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof gtvCtx gtvEntry 0 [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA
             [gtvCvB, gtvLoad, gtvJmp] s (gtvEntrySEnd s) rfl rfl (by decide) hnt (gtvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof gtvCtx gtvEntry 1 [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA
             [gtvCvB, gtvLoad, gtvJmp] s (gtvEntrySEnd s) rfl rfl (by decide) hnt (gtvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof gtvCtx gtvEntry 2 [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA
             [gtvCvB, gtvLoad, gtvJmp] s (gtvEntrySEnd s) rfl rfl (by decide) hnt (gtvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof gtvCtx gtvEntry 3 [gtvCvA, gtvCvB, gtvLoad] gtvJmp gtvCvA
             [gtvCvB, gtvLoad, gtvJmp] s (gtvEntrySEnd s) rfl rfl (by decide) hnt (gtvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, gtvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := gtvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (gtvEntrySEnd s)) = lookupVar "c" (gtvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 gtvCtx gtvNext s gtvMul [gtvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error gtvCtx gtvNext gtvMul [gtvRet] s "undefined operand" j rfl
          (by decide) (gtvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 gtvCtx gtvNext s gtvMul [gtvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error gtvCtx gtvNext gtvMul [gtvRet] s "undefined operand" j rfl
            (by decide) (gtvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 gtvCtx gtvNext s gtvMul [gtvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof gtvCtx gtvNext 1 [gtvMul] gtvRet gtvMul [gtvRet] s
                   (gtvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (gtvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, gtvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 gtvCtx gtvNext s gtvMul [gtvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof gtvCtx gtvNext 1 [gtvMul] gtvRet gtvMul [gtvRet] s
                   (gtvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (gtvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, gtvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 gtvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem gtvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 gtvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 gtvCtx vs
      = runBlocks 10 gtvCtx gtvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, gtvCtx, gtvFn, lookupFunction, fnEntryLabel, gtvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (gtvEntrySEnd s0) with hs1
  have hentry : runBlock 9 gtvCtx gtvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact gtvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb gtvFn.blocks = some gtvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 gtvCtx gtvFn s0 = runBlocks 9 gtvCtx gtvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := gtvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (gtvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (gtvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb gtvFn.blocks = some gtvNext := rfl
  have hhalt := gtvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (gtvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (GT) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=GT %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s GT exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_gt_ok`), emitted `DUP1 ; DUP3 ; GT`, leaving `c = GT(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_gtvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 gtvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ gtvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [gtvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [gtvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [gtvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan gtvFn 0 0
      = some ((generateFnPlan gtvFn 0 0).get!.1, (generateFnPlan gtvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel gtvFn) gtvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv gtvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel gtvFn) gtvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan gtvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := gtvCtx) (fn := gtvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan gtvFn 0 0).get!.1) (psFinal := (generateFnPlan gtvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ gtvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [gtvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, gtvEntry, gtvCvA]
    · simp [runBlock, evalPhis, execBlock, gtvNext, gtvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [gtvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
