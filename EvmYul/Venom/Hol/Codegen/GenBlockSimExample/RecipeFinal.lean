        (hbLabel := by rw [hpc7]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc7]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc7]; decide) (hret := by simp only [hpc7]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨balEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel balFn) balFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan balFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan balFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan balFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan balFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ An ACCOUNT READ (EXTCODESIZE) via the recipe route — `codegen_correct_ecsFn_recipeW`

The world-state account read `EXTCODESIZE`, twin of the `BALANCE` capstone — same generic account-read
arm (`RegularStepG`'s 7th disjunct, `∃ x out name fRead`), just `fRead` reading `.code.length` rather
than `.balance` (`asmStep_extcodesize_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = EXTCODESIZE %a ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                     -- MUL consumes the TOP two (b,c)
```

`EXTCODESIZE %a` is a 1-input account read (`fRead addr accts = ofNat (lookupAccount (ofUInt256 addr) accts).code.length`),
emitted `DUP2 ; EXTCODESIZE`, leaving `[a, b, c]` with `c = ecsVal s` (the code size of the account at
address `callvalue` — context-dependent, generally NON-zero, so `c` cannot itself be a RETURN operand). In
`next` the consuming `MUL %b %c` eats the top two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`,
regardless of `c`), emptying the return window. `a` (bottom) is never buried — no f1a reorder. `entry` via
`hsupplyW_regularJmp`, `next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`ecsNext_ready`). -/

def ecsCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def ecsCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def ecsLoad : Instruction :=
  { id := 2, opcode := Opcode.EXTCODESIZE, operands := [Operand.Var "a"], outputs := ["c"] }
def ecsJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def ecsMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def ecsRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def ecsEntry : BasicBlock := { label := "entry", instructions := [ecsCvA, ecsCvB, ecsLoad, ecsJmp] }
def ecsNext : BasicBlock := { label := "next", instructions := [ecsMul, ecsRet] }
def ecsFn : IrFunction := { name := "main", blocks := [ecsEntry, ecsNext] }
def ecsCtx : VenomContext := { functions := [ecsFn], entry := some "main" }

theorem ecs_unresolved_asm : executePlan (generateFnPlan ecsFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP2", AsmInst.AsmOp "EXTCODESIZE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The code size EXTCODESIZE reads for the account at address `a` (= the call value); context-dependent, generally NON-zero. -/
abbrev ecsVal (s : VenomState) : bytes32 :=
  EvmYul.UInt256.ofNat (lookupAccount (AccountAddress.ofUInt256 s.callCtx.callvalue) s.accounts).code.length

/-- entry's body `[CV a; CV b; EXTCODESIZE %a]` as a `RegularBodyH`: two `cv_step`s then the
    EXTCODESIZE read via `RegularStepG`'s account-read arm (`asmStep_extcodesize_ok`), output live. -/
theorem ecsEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1 1 [ecsCvA, ecsCvB, ecsLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"a", "c", "EXTCODESIZE",
     (fun addr accts => EvmYul.UInt256.ofNat (lookupAccount (AccountAddress.ofUInt256 addr) accts).code.length),
     rfl, by decide, rfl, fun _ => rfl, rfl, rfl,
     by decide, by decide, by decide, by decide, fun _ h hg => asmStep_extcodesize_ok h hg⟩))))))

/-- Body-end state of `ecsEntry`: `a,b := callvalue`, `c := ecsVal s` (the account code size at address `a`). -/
abbrev ecsEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (ecsVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem ecsEntry_thread (s : VenomState) :
    execBodyThread [ecsCvA, ecsCvB, ecsLoad] 0 { s with instIdx := 0 } = some (ecsEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub : stepInstBase ecsLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (ecsVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    have he : evalOperand (Operand.Var "a") ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := hla
    simp only [ecsLoad, stepInstBase, execRead1, he]
    rfl
  have h1 : stepInstBase ecsCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase ecsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase ecsCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [ecsCvB, ecsLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (ecsEntrySEnd s)
  rw [h1]
  show (match stepInstBase ecsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [ecsLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (ecsEntrySEnd s)
  rw [h2]
  show (match stepInstBase ecsLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (ecsEntrySEnd s)
  rw [hsub]
  rfl

/-- `ecsEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem ecsEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) ecsCtx ecsEntry s = ExecResult.OK (jumpTo "next" (ecsEntrySEnd s)) :=
  runBlock_body_jmp ecsCtx ecsEntry j [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA [ecsCvB, ecsLoad, ecsJmp] s
    (ecsEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (ecsEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem ecsNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg ecsFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([ecsMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := ecsFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev ecsNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem ecsNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (ecsNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (ecsNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem ecsNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [ecsMul] 0 { s with instIdx := 0 } = some (ecsNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase ecsMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := ecsMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase ecsMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem ecsMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase ecsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [ecsMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem ecsMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase ecsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [ecsMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem ecsNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) ecsCtx ecsNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (ecsNextSEnd s wb wc))
        (ecsNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := ecsNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return ecsCtx ecsNext j [ecsMul] ecsRet ecsMul [ecsRet] s (ecsNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (ecsNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem ecsNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) ecsCtx ecsNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := ecsNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term ecsCtx ecsNext j [ecsMul] ecsRet ecsMul [ecsRet] s (ecsNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (ecsNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : ecsNext.instructions = [ecsMul] ++ [ecsRet])
    (ecsNext_thread s wb wc hb hc), ecsRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `ecsEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem ecsEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (ecsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (ecsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (ecsEntrySEnd s) = some (ecsVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (ecsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (ecsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (ecsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def ecsInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (ecsVal s))

theorem ecsInv_pres : ∀ bb ∈ ecsFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    ecsInv s → runBlock f' ecsCtx bb s = ExecResult.OK s' → ecsInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [ecsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (ecsEntrySEnd s)`
    have hnt : ∀ inst ∈ [ecsCvA, ecsCvB, ecsLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof ecsCtx ecsEntry 0 [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA
             [ecsCvB, ecsLoad, ecsJmp] s (ecsEntrySEnd s) rfl rfl (by decide) hnt (ecsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof ecsCtx ecsEntry 1 [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA
             [ecsCvB, ecsLoad, ecsJmp] s (ecsEntrySEnd s) rfl rfl (by decide) hnt (ecsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof ecsCtx ecsEntry 2 [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA
             [ecsCvB, ecsLoad, ecsJmp] s (ecsEntrySEnd s) rfl rfl (by decide) hnt (ecsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof ecsCtx ecsEntry 3 [ecsCvA, ecsCvB, ecsLoad] ecsJmp ecsCvA
             [ecsCvB, ecsLoad, ecsJmp] s (ecsEntrySEnd s) rfl rfl (by decide) hnt (ecsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, ecsEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := ecsEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (ecsEntrySEnd s)) = lookupVar "c" (ecsEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 ecsCtx ecsNext s ecsMul [ecsRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error ecsCtx ecsNext ecsMul [ecsRet] s "undefined operand" j rfl
          (by decide) (ecsMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 ecsCtx ecsNext s ecsMul [ecsRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error ecsCtx ecsNext ecsMul [ecsRet] s "undefined operand" j rfl
            (by decide) (ecsMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 ecsCtx ecsNext s ecsMul [ecsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof ecsCtx ecsNext 1 [ecsMul] ecsRet ecsMul [ecsRet] s
                   (ecsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (ecsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, ecsNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 ecsCtx ecsNext s ecsMul [ecsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof ecsCtx ecsNext 1 [ecsMul] ecsRet ecsMul [ecsRet] s
                   (ecsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (ecsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, ecsNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 ecsCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem ecsFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 ecsCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 ecsCtx vs
      = runBlocks 10 ecsCtx ecsFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, ecsCtx, ecsFn, lookupFunction, fnEntryLabel, ecsEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (ecsEntrySEnd s0) with hs1
  have hentry : runBlock 9 ecsCtx ecsEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact ecsEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb ecsFn.blocks = some ecsEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 ecsCtx ecsFn s0 = runBlocks 9 ecsCtx ecsFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := ecsEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (ecsVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (ecsEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb ecsFn.blocks = some ecsNext := rfl
  have hhalt := ecsNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (ecsVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **An ACCOUNT READ (EXTCODESIZE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=EXTCODESIZE %a ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s EXTCODESIZE exercises `RegularStepG`'s generic
    account-read arm (`∃ x out name fRead`, `asmStep_extcodesize_ok`), emitted `DUP2 ; EXTCODESIZE`, leaving
    `c = ecsVal s` (the code size of the account at address `callvalue`, context-dependent). `next`'s MUL
    consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒ `e = 0`
    (`uint256_zero_mul`) empties the return window. `next` ends in a body-then-RETURN handled by
    `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_ecsFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 ecsCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ ecsFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [ecsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [ecsEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [ecsNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan ecsFn 0 0
      = some ((generateFnPlan ecsFn 0 0).get!.1, (generateFnPlan ecsFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel ecsFn) ecsFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv ecsInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel ecsFn) ecsFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan ecsFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan ecsFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := ecsCtx) (fn := ecsFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan ecsFn 0 0).get!.1) (psFinal := (generateFnPlan ecsFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ ecsInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [ecsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, ecsEntry, ecsCvA]
    · simp [runBlock, evalPhis, execBlock, ecsNext, ecsMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [ecsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
