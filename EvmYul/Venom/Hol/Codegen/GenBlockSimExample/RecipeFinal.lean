          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨anvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel anvFn) anvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (OR) via the recipe route — `codegen_correct_orvFn_recipeW`

The commutative binop `OR` (bitwise or), a duplicating var/var compute via `RegularStep`'s
comm arm (`asmStep_or_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = OR %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`OR %a %b` is emitted `DUP1 ; DUP3 ; OR` (both `a,b` live), leaving `[a, b, c]` with
`c = OR(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`orvNext_ready`). -/

def orvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def orvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def orvLoad : Instruction :=
  { id := 2, opcode := Opcode.OR, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def orvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def orvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def orvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def orvEntry : BasicBlock := { label := "entry", instructions := [orvCvA, orvCvB, orvLoad, orvJmp] }
def orvNext : BasicBlock := { label := "next", instructions := [orvMul, orvRet] }
def orvFn : IrFunction := { name := "main", blocks := [orvEntry, orvNext] }
def orvCtx : VenomContext := { functions := [orvFn], entry := some "main" }

theorem orv_unresolved_asm : executePlan (generateFnPlan orvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "OR", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop OR(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev orvVal (s : VenomState) : bytes32 := (fun a b => a ||| b) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; OR %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    OR compute via `RegularStep`'s non-comm binop arm (`asmStep_or_ok`), output live. -/
theorem orvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1 1 [orvCvA, orvCvB, orvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "OR", rfl, rfl, by decide, by decide,
    Or.inl ⟨"a", "b", (fun a b => a ||| b), by decide, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_or_ok h hg⟩⟩

/-- Body-end state of `orvEntry`: `a,b := callvalue`, `c := orvVal s` (OR(a,b) on the call value). -/
abbrev orvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (orvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem orvEntry_thread (s : VenomState) :
    execBodyThread [orvCvA, orvCvB, orvLoad] 0 { s with instIdx := 0 } = some (orvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := orvLoad) (f := fun a b => a ||| b) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase orvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase orvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase orvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [orvCvB, orvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (orvEntrySEnd s)
  rw [h1]
  show (match stepInstBase orvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [orvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (orvEntrySEnd s)
  rw [h2]
  show (match stepInstBase orvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (orvEntrySEnd s)
  rw [hsub]
  rfl

/-- `orvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem orvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) orvCtx orvEntry s = ExecResult.OK (jumpTo "next" (orvEntrySEnd s)) :=
  runBlock_body_jmp orvCtx orvEntry j [orvCvA, orvCvB, orvLoad] orvJmp orvCvA [orvCvB, orvLoad, orvJmp] s
    (orvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (orvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem orvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg orvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([orvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := orvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev orvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem orvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (orvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (orvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem orvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [orvMul] 0 { s with instIdx := 0 } = some (orvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase orvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := orvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase orvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem orvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase orvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [orvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem orvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase orvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [orvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem orvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) orvCtx orvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (orvNextSEnd s wb wc))
        (orvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := orvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return orvCtx orvNext j [orvMul] orvRet orvMul [orvRet] s (orvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (orvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem orvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) orvCtx orvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := orvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term orvCtx orvNext j [orvMul] orvRet orvMul [orvRet] s (orvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (orvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : orvNext.instructions = [orvMul] ++ [orvRet])
    (orvNext_thread s wb wc hb hc), orvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `orvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem orvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (orvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (orvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (orvEntrySEnd s) = some (orvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (orvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (orvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (orvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def orvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (orvVal s))

theorem orvInv_pres : ∀ bb ∈ orvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    orvInv s → runBlock f' orvCtx bb s = ExecResult.OK s' → orvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [orvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (orvEntrySEnd s)`
    have hnt : ∀ inst ∈ [orvCvA, orvCvB, orvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof orvCtx orvEntry 0 [orvCvA, orvCvB, orvLoad] orvJmp orvCvA
             [orvCvB, orvLoad, orvJmp] s (orvEntrySEnd s) rfl rfl (by decide) hnt (orvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof orvCtx orvEntry 1 [orvCvA, orvCvB, orvLoad] orvJmp orvCvA
             [orvCvB, orvLoad, orvJmp] s (orvEntrySEnd s) rfl rfl (by decide) hnt (orvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof orvCtx orvEntry 2 [orvCvA, orvCvB, orvLoad] orvJmp orvCvA
             [orvCvB, orvLoad, orvJmp] s (orvEntrySEnd s) rfl rfl (by decide) hnt (orvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof orvCtx orvEntry 3 [orvCvA, orvCvB, orvLoad] orvJmp orvCvA
             [orvCvB, orvLoad, orvJmp] s (orvEntrySEnd s) rfl rfl (by decide) hnt (orvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, orvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := orvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (orvEntrySEnd s)) = lookupVar "c" (orvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 orvCtx orvNext s orvMul [orvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error orvCtx orvNext orvMul [orvRet] s "undefined operand" j rfl
          (by decide) (orvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 orvCtx orvNext s orvMul [orvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error orvCtx orvNext orvMul [orvRet] s "undefined operand" j rfl
            (by decide) (orvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 orvCtx orvNext s orvMul [orvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof orvCtx orvNext 1 [orvMul] orvRet orvMul [orvRet] s
                   (orvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (orvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, orvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 orvCtx orvNext s orvMul [orvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof orvCtx orvNext 1 [orvMul] orvRet orvMul [orvRet] s
                   (orvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (orvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, orvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 orvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem orvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 orvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 orvCtx vs
      = runBlocks 10 orvCtx orvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, orvCtx, orvFn, lookupFunction, fnEntryLabel, orvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (orvEntrySEnd s0) with hs1
  have hentry : runBlock 9 orvCtx orvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact orvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb orvFn.blocks = some orvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 orvCtx orvFn s0 = runBlocks 9 orvCtx orvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := orvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (orvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (orvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb orvFn.blocks = some orvNext := rfl
  have hhalt := orvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (orvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (OR) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=OR %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s OR exercises `RegularStep`'s non-commutative
    commutative binop arm (`asmStep_or_ok`), emitted `DUP1 ; DUP3 ; OR`, leaving `c = OR(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_orvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 orvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan orvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ orvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [orvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [orvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [orvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan orvFn 0 0
      = some ((generateFnPlan orvFn 0 0).get!.1, (generateFnPlan orvFn 0 0).get!.2) := rfl
