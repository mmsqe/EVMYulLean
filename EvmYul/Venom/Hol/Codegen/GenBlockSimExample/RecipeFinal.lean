               [byvCvB, byvLoad, byvJmp] s (byvEntrySEnd s) rfl rfl (by decide) hnt (byvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof byvCtx byvEntry 2 [byvCvA, byvCvB, byvLoad] byvJmp byvCvA
               [byvCvB, byvLoad, byvJmp] s (byvEntrySEnd s) rfl rfl (by decide) hnt (byvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof byvCtx byvEntry 3 [byvCvA, byvCvB, byvLoad] byvJmp byvCvA
               [byvCvB, byvLoad, byvJmp] s (byvEntrySEnd s) rfl rfl (by decide) hnt (byvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([byvCvA, byvCvB, byvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [byvCvA, byvCvB, byvLoad]) (jmpInst := byvJmp) (hd := byvCvA) (tl := [byvCvB, byvLoad, byvJmp])
