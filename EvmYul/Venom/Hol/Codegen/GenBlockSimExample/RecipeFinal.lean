        (hvoff := by rw [show operandVal (balNextSEnd s (EvmYul.UInt256.ofNat 0) (balVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (balNextSEnd s (EvmYul.UInt256.ofNat 0) (balVal s)) from rfl,
