        (hvsz := by rw [show operandVal (anvNextSEnd s (EvmYul.UInt256.ofNat 0) (anvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (anvNextSEnd s (EvmYul.UInt256.ofNat 0) (anvVal s)) from rfl,
