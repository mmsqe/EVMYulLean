/-! ### ✅ A BINOP (SIGNEXTEND) via the recipe route — `codegen_correct_sxvFn_recipeW`

The non-commutative binop `SIGNEXTEND` (sign extension), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_signextend_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SIGNEXTEND %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`SIGNEXTEND %a %b` is emitted `DUP1 ; DUP3 ; SIGNEXTEND` (both `a,b` live), leaving `[a, b, c]` with
`c = SIGNEXTEND(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`sxvNext_ready`). -/

def sxvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def sxvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def sxvLoad : Instruction :=
  { id := 2, opcode := Opcode.SIGNEXTEND, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def sxvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def sxvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def sxvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def sxvEntry : BasicBlock := { label := "entry", instructions := [sxvCvA, sxvCvB, sxvLoad, sxvJmp] }
def sxvNext : BasicBlock := { label := "next", instructions := [sxvMul, sxvRet] }
def sxvFn : IrFunction := { name := "main", blocks := [sxvEntry, sxvNext] }
def sxvCtx : VenomContext := { functions := [sxvFn], entry := some "main" }

theorem sxv_unresolved_asm : executePlan (generateFnPlan sxvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "SIGNEXTEND", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop SIGNEXTEND(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev sxvVal (s : VenomState) : bytes32 := (EvmYul.Venom.Hol.signExtend) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; SIGNEXTEND %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    SIGNEXTEND compute via `RegularStep`'s non-comm binop arm (`asmStep_signextend_ok`), output live. -/
theorem sxvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1 1 [sxvCvA, sxvCvB, sxvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "SIGNEXTEND", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.Venom.Hol.signExtend), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_signextend_ok h hg⟩)⟩

/-- Body-end state of `sxvEntry`: `a,b := callvalue`, `c := sxvVal s` (SIGNEXTEND(a,b) on the call value). -/
abbrev sxvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (sxvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem sxvEntry_thread (s : VenomState) :
    execBodyThread [sxvCvA, sxvCvB, sxvLoad] 0 { s with instIdx := 0 } = some (sxvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := sxvLoad) (f := EvmYul.Venom.Hol.signExtend) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase sxvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase sxvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase sxvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [sxvCvB, sxvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (sxvEntrySEnd s)
  rw [h1]
  show (match stepInstBase sxvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [sxvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (sxvEntrySEnd s)
  rw [h2]
  show (match stepInstBase sxvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (sxvEntrySEnd s)
  rw [hsub]
  rfl

/-- `sxvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem sxvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) sxvCtx sxvEntry s = ExecResult.OK (jumpTo "next" (sxvEntrySEnd s)) :=
  runBlock_body_jmp sxvCtx sxvEntry j [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA [sxvCvB, sxvLoad, sxvJmp] s
    (sxvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (sxvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem sxvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg sxvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([sxvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := sxvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev sxvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem sxvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (sxvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (sxvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem sxvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [sxvMul] 0 { s with instIdx := 0 } = some (sxvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase sxvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := sxvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase sxvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem sxvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase sxvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [sxvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem sxvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase sxvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [sxvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem sxvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) sxvCtx sxvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (sxvNextSEnd s wb wc))
        (sxvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := sxvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return sxvCtx sxvNext j [sxvMul] sxvRet sxvMul [sxvRet] s (sxvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sxvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem sxvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) sxvCtx sxvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := sxvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term sxvCtx sxvNext j [sxvMul] sxvRet sxvMul [sxvRet] s (sxvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (sxvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : sxvNext.instructions = [sxvMul] ++ [sxvRet])
    (sxvNext_thread s wb wc hb hc), sxvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `sxvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem sxvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (sxvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (sxvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (sxvEntrySEnd s) = some (sxvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (sxvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (sxvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (sxvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def sxvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (sxvVal s))

theorem sxvInv_pres : ∀ bb ∈ sxvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    sxvInv s → runBlock f' sxvCtx bb s = ExecResult.OK s' → sxvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [sxvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (sxvEntrySEnd s)`
    have hnt : ∀ inst ∈ [sxvCvA, sxvCvB, sxvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof sxvCtx sxvEntry 0 [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA
             [sxvCvB, sxvLoad, sxvJmp] s (sxvEntrySEnd s) rfl rfl (by decide) hnt (sxvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof sxvCtx sxvEntry 1 [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA
             [sxvCvB, sxvLoad, sxvJmp] s (sxvEntrySEnd s) rfl rfl (by decide) hnt (sxvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof sxvCtx sxvEntry 2 [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA
             [sxvCvB, sxvLoad, sxvJmp] s (sxvEntrySEnd s) rfl rfl (by decide) hnt (sxvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof sxvCtx sxvEntry 3 [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA
             [sxvCvB, sxvLoad, sxvJmp] s (sxvEntrySEnd s) rfl rfl (by decide) hnt (sxvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, sxvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := sxvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (sxvEntrySEnd s)) = lookupVar "c" (sxvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 sxvCtx sxvNext s sxvMul [sxvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error sxvCtx sxvNext sxvMul [sxvRet] s "undefined operand" j rfl
          (by decide) (sxvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 sxvCtx sxvNext s sxvMul [sxvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error sxvCtx sxvNext sxvMul [sxvRet] s "undefined operand" j rfl
            (by decide) (sxvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sxvCtx sxvNext s sxvMul [sxvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sxvCtx sxvNext 1 [sxvMul] sxvRet sxvMul [sxvRet] s
                   (sxvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sxvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sxvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 sxvCtx sxvNext s sxvMul [sxvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof sxvCtx sxvNext 1 [sxvMul] sxvRet sxvMul [sxvRet] s
                   (sxvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (sxvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, sxvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 sxvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem sxvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 sxvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 sxvCtx vs
      = runBlocks 10 sxvCtx sxvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, sxvCtx, sxvFn, lookupFunction, fnEntryLabel, sxvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (sxvEntrySEnd s0) with hs1
  have hentry : runBlock 9 sxvCtx sxvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact sxvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb sxvFn.blocks = some sxvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 sxvCtx sxvFn s0 = runBlocks 9 sxvCtx sxvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := sxvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (sxvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (sxvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb sxvFn.blocks = some sxvNext := rfl
  have hhalt := sxvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (sxvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (SIGNEXTEND) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=SIGNEXTEND %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s SIGNEXTEND exercises `RegularStep`'s non-commutative
    non-commutative binop arm (`asmStep_signextend_ok`), emitted `DUP1 ; DUP3 ; SIGNEXTEND`, leaving `c = SIGNEXTEND(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_sxvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 sxvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ sxvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [sxvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [sxvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [sxvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan sxvFn 0 0
      = some ((generateFnPlan sxvFn 0 0).get!.1, (generateFnPlan sxvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel sxvFn) sxvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv sxvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel sxvFn) sxvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan sxvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := sxvCtx) (fn := sxvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan sxvFn 0 0).get!.1) (psFinal := (generateFnPlan sxvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ sxvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [sxvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, sxvEntry, sxvCvA]
    · simp [runBlock, evalPhis, execBlock, sxvNext, sxvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [sxvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [sxvCvA, sxvCvB, sxvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof sxvCtx sxvEntry 1 [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA
               [sxvCvB, sxvLoad, sxvJmp] s (sxvEntrySEnd s) rfl rfl (by decide) hnt (sxvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof sxvCtx sxvEntry 2 [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA
               [sxvCvB, sxvLoad, sxvJmp] s (sxvEntrySEnd s) rfl rfl (by decide) hnt (sxvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof sxvCtx sxvEntry 3 [sxvCvA, sxvCvB, sxvLoad] sxvJmp sxvCvA
               [sxvCvB, sxvLoad, sxvJmp] s (sxvEntrySEnd s) rfl rfl (by decide) hnt (sxvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([sxvCvA, sxvCvB, sxvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [sxvCvA, sxvCvB, sxvLoad]) (jmpInst := sxvJmp) (hd := sxvCvA) (tl := [sxvCvB, sxvLoad, sxvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := sxvNext) (sEnd := sxvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := sxvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := sxvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 5 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc8 : asm.pc = 8 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof sxvCtx sxvNext 1 [sxvMul] sxvRet sxvMul [sxvRet] s
               (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (sxvNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([sxvMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [sxvMul]) (retInst := sxvRet) (hd := sxvMul) (tl := [sxvRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel sxvFn) sxvFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := sxvNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s))
            = lookupVar "e" (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s)) from rfl,
            (sxvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sxvVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s))
            = lookupVar "a" (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s)) from rfl,
            (sxvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sxvVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s)) from rfl,
            (sxvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sxvVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (sxvNextSEnd s (EvmYul.UInt256.ofNat 0) (sxvVal s)) from rfl,
            (sxvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (sxvVal s)).2]; exact ha0)
        (hready := sxvNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel sxvFn) sxvFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨sxvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel sxvFn) sxvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan sxvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (BYTE) via the recipe route — `codegen_correct_byvFn_recipeW`

The non-commutative binop `BYTE` (byte extraction), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_byte_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = BYTE %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`BYTE %a %b` is emitted `DUP1 ; DUP3 ; BYTE` (both `a,b` live), leaving `[a, b, c]` with
`c = BYTE(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`byvNext_ready`). -/

def byvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def byvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def byvLoad : Instruction :=
  { id := 2, opcode := Opcode.BYTE, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def byvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def byvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def byvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def byvEntry : BasicBlock := { label := "entry", instructions := [byvCvA, byvCvB, byvLoad, byvJmp] }
def byvNext : BasicBlock := { label := "next", instructions := [byvMul, byvRet] }
def byvFn : IrFunction := { name := "main", blocks := [byvEntry, byvNext] }
def byvCtx : VenomContext := { functions := [byvFn], entry := some "main" }

theorem byv_unresolved_asm : executePlan (generateFnPlan byvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "BYTE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop BYTE(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev byvVal (s : VenomState) : bytes32 := (EvmYul.Venom.Hol.evmByte) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; BYTE %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    BYTE compute via `RegularStep`'s non-comm binop arm (`asmStep_byte_ok`), output live. -/
theorem byvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1 1 [byvCvA, byvCvB, byvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "BYTE", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.Venom.Hol.evmByte), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_byte_ok h hg⟩)⟩

/-- Body-end state of `byvEntry`: `a,b := callvalue`, `c := byvVal s` (BYTE(a,b) on the call value). -/
abbrev byvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (byvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem byvEntry_thread (s : VenomState) :
    execBodyThread [byvCvA, byvCvB, byvLoad] 0 { s with instIdx := 0 } = some (byvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := byvLoad) (f := EvmYul.Venom.Hol.evmByte) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase byvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase byvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase byvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [byvCvB, byvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (byvEntrySEnd s)
  rw [h1]
  show (match stepInstBase byvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [byvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (byvEntrySEnd s)
  rw [h2]
  show (match stepInstBase byvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (byvEntrySEnd s)
  rw [hsub]
  rfl

/-- `byvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem byvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) byvCtx byvEntry s = ExecResult.OK (jumpTo "next" (byvEntrySEnd s)) :=
  runBlock_body_jmp byvCtx byvEntry j [byvCvA, byvCvB, byvLoad] byvJmp byvCvA [byvCvB, byvLoad, byvJmp] s
    (byvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (byvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem byvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg byvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([byvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := byvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev byvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem byvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (byvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (byvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem byvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [byvMul] 0 { s with instIdx := 0 } = some (byvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase byvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := byvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase byvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem byvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase byvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [byvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem byvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase byvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [byvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem byvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) byvCtx byvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (byvNextSEnd s wb wc))
        (byvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := byvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return byvCtx byvNext j [byvMul] byvRet byvMul [byvRet] s (byvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (byvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem byvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) byvCtx byvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := byvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term byvCtx byvNext j [byvMul] byvRet byvMul [byvRet] s (byvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (byvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : byvNext.instructions = [byvMul] ++ [byvRet])
    (byvNext_thread s wb wc hb hc), byvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `byvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem byvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (byvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (byvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (byvEntrySEnd s) = some (byvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (byvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (byvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (byvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def byvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (byvVal s))

theorem byvInv_pres : ∀ bb ∈ byvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    byvInv s → runBlock f' byvCtx bb s = ExecResult.OK s' → byvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [byvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (byvEntrySEnd s)`
    have hnt : ∀ inst ∈ [byvCvA, byvCvB, byvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof byvCtx byvEntry 0 [byvCvA, byvCvB, byvLoad] byvJmp byvCvA
             [byvCvB, byvLoad, byvJmp] s (byvEntrySEnd s) rfl rfl (by decide) hnt (byvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof byvCtx byvEntry 1 [byvCvA, byvCvB, byvLoad] byvJmp byvCvA
             [byvCvB, byvLoad, byvJmp] s (byvEntrySEnd s) rfl rfl (by decide) hnt (byvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof byvCtx byvEntry 2 [byvCvA, byvCvB, byvLoad] byvJmp byvCvA
             [byvCvB, byvLoad, byvJmp] s (byvEntrySEnd s) rfl rfl (by decide) hnt (byvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof byvCtx byvEntry 3 [byvCvA, byvCvB, byvLoad] byvJmp byvCvA
             [byvCvB, byvLoad, byvJmp] s (byvEntrySEnd s) rfl rfl (by decide) hnt (byvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, byvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := byvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (byvEntrySEnd s)) = lookupVar "c" (byvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 byvCtx byvNext s byvMul [byvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error byvCtx byvNext byvMul [byvRet] s "undefined operand" j rfl
          (by decide) (byvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 byvCtx byvNext s byvMul [byvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error byvCtx byvNext byvMul [byvRet] s "undefined operand" j rfl
            (by decide) (byvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 byvCtx byvNext s byvMul [byvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof byvCtx byvNext 1 [byvMul] byvRet byvMul [byvRet] s
                   (byvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (byvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, byvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 byvCtx byvNext s byvMul [byvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof byvCtx byvNext 1 [byvMul] byvRet byvMul [byvRet] s
                   (byvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (byvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, byvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 byvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem byvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 byvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 byvCtx vs
      = runBlocks 10 byvCtx byvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, byvCtx, byvFn, lookupFunction, fnEntryLabel, byvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (byvEntrySEnd s0) with hs1
  have hentry : runBlock 9 byvCtx byvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact byvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb byvFn.blocks = some byvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 byvCtx byvFn s0 = runBlocks 9 byvCtx byvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := byvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (byvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (byvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb byvFn.blocks = some byvNext := rfl
  have hhalt := byvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (byvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (BYTE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=BYTE %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s BYTE exercises `RegularStep`'s non-commutative
    non-commutative binop arm (`asmStep_byte_ok`), emitted `DUP1 ; DUP3 ; BYTE`, leaving `c = BYTE(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_byvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 byvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ byvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [byvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [byvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [byvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan byvFn 0 0
      = some ((generateFnPlan byvFn 0 0).get!.1, (generateFnPlan byvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel byvFn) byvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv byvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel byvFn) byvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan byvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan byvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := byvCtx) (fn := byvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan byvFn 0 0).get!.1) (psFinal := (generateFnPlan byvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ byvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [byvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, byvEntry, byvCvA]
    · simp [runBlock, evalPhis, execBlock, byvNext, byvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [byvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
