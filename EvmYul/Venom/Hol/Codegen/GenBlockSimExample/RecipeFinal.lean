        (hready := sblNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel sblFn) sblFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨sblEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel sblFn) sblFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan sblFn 0 0).get!.1)).1.length
      omega

/-! ### ✅ A BINOP (DIV) via the recipe route — `codegen_correct_dvvFn_recipeW`

The non-commutative binop `DIV` (unsigned division), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_div_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = DIV %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`DIV %a %b` is emitted `DUP1 ; DUP3 ; DIV` (both `a,b` live), leaving `[a, b, c]` with
`c = DIV(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`dvvNext_ready`). -/

def dvvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def dvvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def dvvLoad : Instruction :=
  { id := 2, opcode := Opcode.Div, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def dvvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def dvvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def dvvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def dvvEntry : BasicBlock := { label := "entry", instructions := [dvvCvA, dvvCvB, dvvLoad, dvvJmp] }
def dvvNext : BasicBlock := { label := "next", instructions := [dvvMul, dvvRet] }
def dvvFn : IrFunction := { name := "main", blocks := [dvvEntry, dvvNext] }
def dvvCtx : VenomContext := { functions := [dvvFn], entry := some "main" }

theorem dvv_unresolved_asm : executePlan (generateFnPlan dvvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "DIV", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop DIV(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev dvvVal (s : VenomState) : bytes32 := (EvmYul.Venom.Hol.safeDiv) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; DIV %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    DIV compute via `RegularStep`'s non-comm binop arm (`asmStep_div_ok`), output live. -/
theorem dvvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1 1 [dvvCvA, dvvCvB, dvvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "DIV", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.Venom.Hol.safeDiv), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_div_ok h hg⟩)⟩

/-- Body-end state of `dvvEntry`: `a,b := callvalue`, `c := dvvVal s` (DIV(a,b) on the call value). -/
abbrev dvvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (dvvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem dvvEntry_thread (s : VenomState) :
    execBodyThread [dvvCvA, dvvCvB, dvvLoad] 0 { s with instIdx := 0 } = some (dvvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := dvvLoad) (f := EvmYul.Venom.Hol.safeDiv) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase dvvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase dvvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase dvvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [dvvCvB, dvvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (dvvEntrySEnd s)
  rw [h1]
  show (match stepInstBase dvvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [dvvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (dvvEntrySEnd s)
  rw [h2]
  show (match stepInstBase dvvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (dvvEntrySEnd s)
  rw [hsub]
  rfl

/-- `dvvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem dvvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) dvvCtx dvvEntry s = ExecResult.OK (jumpTo "next" (dvvEntrySEnd s)) :=
  runBlock_body_jmp dvvCtx dvvEntry j [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA [dvvCvB, dvvLoad, dvvJmp] s
    (dvvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (dvvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem dvvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg dvvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([dvvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := dvvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev dvvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem dvvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (dvvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (dvvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem dvvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [dvvMul] 0 { s with instIdx := 0 } = some (dvvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase dvvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := dvvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase dvvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem dvvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase dvvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [dvvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem dvvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase dvvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [dvvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem dvvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) dvvCtx dvvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (dvvNextSEnd s wb wc))
        (dvvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := dvvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return dvvCtx dvvNext j [dvvMul] dvvRet dvvMul [dvvRet] s (dvvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (dvvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem dvvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) dvvCtx dvvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := dvvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term dvvCtx dvvNext j [dvvMul] dvvRet dvvMul [dvvRet] s (dvvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (dvvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : dvvNext.instructions = [dvvMul] ++ [dvvRet])
    (dvvNext_thread s wb wc hb hc), dvvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `dvvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem dvvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (dvvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (dvvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (dvvEntrySEnd s) = some (dvvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (dvvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (dvvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (dvvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def dvvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (dvvVal s))

theorem dvvInv_pres : ∀ bb ∈ dvvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    dvvInv s → runBlock f' dvvCtx bb s = ExecResult.OK s' → dvvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [dvvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (dvvEntrySEnd s)`
    have hnt : ∀ inst ∈ [dvvCvA, dvvCvB, dvvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof dvvCtx dvvEntry 0 [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA
             [dvvCvB, dvvLoad, dvvJmp] s (dvvEntrySEnd s) rfl rfl (by decide) hnt (dvvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof dvvCtx dvvEntry 1 [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA
             [dvvCvB, dvvLoad, dvvJmp] s (dvvEntrySEnd s) rfl rfl (by decide) hnt (dvvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof dvvCtx dvvEntry 2 [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA
             [dvvCvB, dvvLoad, dvvJmp] s (dvvEntrySEnd s) rfl rfl (by decide) hnt (dvvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof dvvCtx dvvEntry 3 [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA
             [dvvCvB, dvvLoad, dvvJmp] s (dvvEntrySEnd s) rfl rfl (by decide) hnt (dvvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, dvvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := dvvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (dvvEntrySEnd s)) = lookupVar "c" (dvvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 dvvCtx dvvNext s dvvMul [dvvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error dvvCtx dvvNext dvvMul [dvvRet] s "undefined operand" j rfl
          (by decide) (dvvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 dvvCtx dvvNext s dvvMul [dvvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error dvvCtx dvvNext dvvMul [dvvRet] s "undefined operand" j rfl
            (by decide) (dvvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 dvvCtx dvvNext s dvvMul [dvvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof dvvCtx dvvNext 1 [dvvMul] dvvRet dvvMul [dvvRet] s
                   (dvvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (dvvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, dvvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 dvvCtx dvvNext s dvvMul [dvvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof dvvCtx dvvNext 1 [dvvMul] dvvRet dvvMul [dvvRet] s
                   (dvvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (dvvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, dvvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 dvvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem dvvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 dvvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 dvvCtx vs
      = runBlocks 10 dvvCtx dvvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, dvvCtx, dvvFn, lookupFunction, fnEntryLabel, dvvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (dvvEntrySEnd s0) with hs1
  have hentry : runBlock 9 dvvCtx dvvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact dvvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb dvvFn.blocks = some dvvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 dvvCtx dvvFn s0 = runBlocks 9 dvvCtx dvvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := dvvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (dvvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (dvvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb dvvFn.blocks = some dvvNext := rfl
  have hhalt := dvvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (dvvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (DIV) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=DIV %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s DIV exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_div_ok`), emitted `DUP1 ; DUP3 ; DIV`, leaving `c = DIV(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_dvvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 dvvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ dvvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [dvvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [dvvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [dvvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan dvvFn 0 0
      = some ((generateFnPlan dvvFn 0 0).get!.1, (generateFnPlan dvvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel dvvFn) dvvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv dvvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel dvvFn) dvvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan dvvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := dvvCtx) (fn := dvvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan dvvFn 0 0).get!.1) (psFinal := (generateFnPlan dvvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ dvvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [dvvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, dvvEntry, dvvCvA]
    · simp [runBlock, evalPhis, execBlock, dvvNext, dvvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [dvvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [dvvCvA, dvvCvB, dvvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof dvvCtx dvvEntry 1 [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA
               [dvvCvB, dvvLoad, dvvJmp] s (dvvEntrySEnd s) rfl rfl (by decide) hnt (dvvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof dvvCtx dvvEntry 2 [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA
               [dvvCvB, dvvLoad, dvvJmp] s (dvvEntrySEnd s) rfl rfl (by decide) hnt (dvvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof dvvCtx dvvEntry 3 [dvvCvA, dvvCvB, dvvLoad] dvvJmp dvvCvA
               [dvvCvB, dvvLoad, dvvJmp] s (dvvEntrySEnd s) rfl rfl (by decide) hnt (dvvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([dvvCvA, dvvCvB, dvvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [dvvCvA, dvvCvB, dvvLoad]) (jmpInst := dvvJmp) (hd := dvvCvA) (tl := [dvvCvB, dvvLoad, dvvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := dvvNext) (sEnd := dvvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := dvvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := dvvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 5 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc8 : asm.pc = 8 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof dvvCtx dvvNext 1 [dvvMul] dvvRet dvvMul [dvvRet] s
               (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (dvvNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([dvvMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [dvvMul]) (retInst := dvvRet) (hd := dvvMul) (tl := [dvvRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel dvvFn) dvvFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := dvvNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s))
            = lookupVar "e" (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s)) from rfl,
            (dvvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (dvvVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s))
            = lookupVar "a" (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s)) from rfl,
            (dvvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (dvvVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s)) from rfl,
            (dvvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (dvvVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (dvvNextSEnd s (EvmYul.UInt256.ofNat 0) (dvvVal s)) from rfl,
            (dvvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (dvvVal s)).2]; exact ha0)
        (hready := dvvNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel dvvFn) dvvFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨dvvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel dvvFn) dvvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan dvvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (MOD) via the recipe route — `codegen_correct_mdvFn_recipeW`

The non-commutative binop `MOD` (unsigned modulo), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_mod_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = MOD %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`MOD %a %b` is emitted `DUP1 ; DUP3 ; MOD` (both `a,b` live), leaving `[a, b, c]` with
`c = MOD(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`mdvNext_ready`). -/

def mdvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def mdvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def mdvLoad : Instruction :=
  { id := 2, opcode := Opcode.Mod, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def mdvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def mdvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def mdvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def mdvEntry : BasicBlock := { label := "entry", instructions := [mdvCvA, mdvCvB, mdvLoad, mdvJmp] }
def mdvNext : BasicBlock := { label := "next", instructions := [mdvMul, mdvRet] }
def mdvFn : IrFunction := { name := "main", blocks := [mdvEntry, mdvNext] }
def mdvCtx : VenomContext := { functions := [mdvFn], entry := some "main" }

theorem mdv_unresolved_asm : executePlan (generateFnPlan mdvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "MOD", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop MOD(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev mdvVal (s : VenomState) : bytes32 := (EvmYul.Venom.Hol.safeMod) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; MOD %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    MOD compute via `RegularStep`'s non-comm binop arm (`asmStep_mod_ok`), output live. -/
theorem mdvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1 1 [mdvCvA, mdvCvB, mdvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "MOD", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.Venom.Hol.safeMod), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_mod_ok h hg⟩)⟩

/-- Body-end state of `mdvEntry`: `a,b := callvalue`, `c := mdvVal s` (MOD(a,b) on the call value). -/
abbrev mdvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (mdvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem mdvEntry_thread (s : VenomState) :
    execBodyThread [mdvCvA, mdvCvB, mdvLoad] 0 { s with instIdx := 0 } = some (mdvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := mdvLoad) (f := EvmYul.Venom.Hol.safeMod) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase mdvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase mdvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase mdvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [mdvCvB, mdvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (mdvEntrySEnd s)
  rw [h1]
  show (match stepInstBase mdvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [mdvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (mdvEntrySEnd s)
  rw [h2]
  show (match stepInstBase mdvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (mdvEntrySEnd s)
  rw [hsub]
  rfl

/-- `mdvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem mdvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) mdvCtx mdvEntry s = ExecResult.OK (jumpTo "next" (mdvEntrySEnd s)) :=
  runBlock_body_jmp mdvCtx mdvEntry j [mdvCvA, mdvCvB, mdvLoad] mdvJmp mdvCvA [mdvCvB, mdvLoad, mdvJmp] s
    (mdvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (mdvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem mdvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg mdvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([mdvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := mdvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev mdvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem mdvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (mdvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (mdvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem mdvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [mdvMul] 0 { s with instIdx := 0 } = some (mdvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase mdvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := mdvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase mdvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem mdvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase mdvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [mdvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem mdvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase mdvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [mdvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem mdvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) mdvCtx mdvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (mdvNextSEnd s wb wc))
        (mdvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := mdvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return mdvCtx mdvNext j [mdvMul] mdvRet mdvMul [mdvRet] s (mdvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (mdvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem mdvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) mdvCtx mdvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := mdvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term mdvCtx mdvNext j [mdvMul] mdvRet mdvMul [mdvRet] s (mdvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (mdvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : mdvNext.instructions = [mdvMul] ++ [mdvRet])
    (mdvNext_thread s wb wc hb hc), mdvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `mdvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem mdvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (mdvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (mdvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (mdvEntrySEnd s) = some (mdvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (mdvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (mdvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (mdvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def mdvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (mdvVal s))

theorem mdvInv_pres : ∀ bb ∈ mdvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    mdvInv s → runBlock f' mdvCtx bb s = ExecResult.OK s' → mdvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [mdvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (mdvEntrySEnd s)`
    have hnt : ∀ inst ∈ [mdvCvA, mdvCvB, mdvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof mdvCtx mdvEntry 0 [mdvCvA, mdvCvB, mdvLoad] mdvJmp mdvCvA
             [mdvCvB, mdvLoad, mdvJmp] s (mdvEntrySEnd s) rfl rfl (by decide) hnt (mdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof mdvCtx mdvEntry 1 [mdvCvA, mdvCvB, mdvLoad] mdvJmp mdvCvA
             [mdvCvB, mdvLoad, mdvJmp] s (mdvEntrySEnd s) rfl rfl (by decide) hnt (mdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof mdvCtx mdvEntry 2 [mdvCvA, mdvCvB, mdvLoad] mdvJmp mdvCvA
             [mdvCvB, mdvLoad, mdvJmp] s (mdvEntrySEnd s) rfl rfl (by decide) hnt (mdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof mdvCtx mdvEntry 3 [mdvCvA, mdvCvB, mdvLoad] mdvJmp mdvCvA
             [mdvCvB, mdvLoad, mdvJmp] s (mdvEntrySEnd s) rfl rfl (by decide) hnt (mdvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, mdvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := mdvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (mdvEntrySEnd s)) = lookupVar "c" (mdvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 mdvCtx mdvNext s mdvMul [mdvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error mdvCtx mdvNext mdvMul [mdvRet] s "undefined operand" j rfl
          (by decide) (mdvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 mdvCtx mdvNext s mdvMul [mdvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error mdvCtx mdvNext mdvMul [mdvRet] s "undefined operand" j rfl
            (by decide) (mdvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 mdvCtx mdvNext s mdvMul [mdvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof mdvCtx mdvNext 1 [mdvMul] mdvRet mdvMul [mdvRet] s
                   (mdvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (mdvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, mdvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 mdvCtx mdvNext s mdvMul [mdvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof mdvCtx mdvNext 1 [mdvMul] mdvRet mdvMul [mdvRet] s
                   (mdvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (mdvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, mdvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 mdvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem mdvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 mdvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 mdvCtx vs
      = runBlocks 10 mdvCtx mdvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, mdvCtx, mdvFn, lookupFunction, fnEntryLabel, mdvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (mdvEntrySEnd s0) with hs1
  have hentry : runBlock 9 mdvCtx mdvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact mdvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb mdvFn.blocks = some mdvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 mdvCtx mdvFn s0 = runBlocks 9 mdvCtx mdvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := mdvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (mdvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (mdvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb mdvFn.blocks = some mdvNext := rfl
  have hhalt := mdvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (mdvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (MOD) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=MOD %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s MOD exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_mod_ok`), emitted `DUP1 ; DUP3 ; MOD`, leaving `c = MOD(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_mdvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 mdvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ mdvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [mdvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [mdvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [mdvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan mdvFn 0 0
      = some ((generateFnPlan mdvFn 0 0).get!.1, (generateFnPlan mdvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel mdvFn) mdvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv mdvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan mdvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel mdvFn) mdvFn 0 0)
