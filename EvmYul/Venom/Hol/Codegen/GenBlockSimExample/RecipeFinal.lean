/-! ### ✅ A BINOP (XOR) via the recipe route — `codegen_correct_xrvFn_recipeW`

The commutative binop `XOR` (bitwise xor), a duplicating var/var compute via `RegularStep`'s
comm arm (`asmStep_xor_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = XOR %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`XOR %a %b` is emitted `DUP1 ; DUP3 ; XOR` (both `a,b` live), leaving `[a, b, c]` with
`c = XOR(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`xrvNext_ready`). -/

def xrvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def xrvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def xrvLoad : Instruction :=
  { id := 2, opcode := Opcode.XOR, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def xrvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def xrvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def xrvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def xrvEntry : BasicBlock := { label := "entry", instructions := [xrvCvA, xrvCvB, xrvLoad, xrvJmp] }
def xrvNext : BasicBlock := { label := "next", instructions := [xrvMul, xrvRet] }
def xrvFn : IrFunction := { name := "main", blocks := [xrvEntry, xrvNext] }
def xrvCtx : VenomContext := { functions := [xrvFn], entry := some "main" }

theorem xrv_unresolved_asm : executePlan (generateFnPlan xrvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "XOR", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop XOR(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev xrvVal (s : VenomState) : bytes32 := (fun a b => a ^^^ b) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; XOR %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    XOR compute via `RegularStep`'s non-comm binop arm (`asmStep_xor_ok`), output live. -/
theorem xrvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1 1 [xrvCvA, xrvCvB, xrvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "XOR", rfl, rfl, by decide, by decide,
    Or.inl ⟨"a", "b", (fun a b => a ^^^ b), by decide, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_xor_ok h hg⟩⟩

/-- Body-end state of `xrvEntry`: `a,b := callvalue`, `c := xrvVal s` (XOR(a,b) on the call value). -/
abbrev xrvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (xrvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem xrvEntry_thread (s : VenomState) :
    execBodyThread [xrvCvA, xrvCvB, xrvLoad] 0 { s with instIdx := 0 } = some (xrvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := xrvLoad) (f := fun a b => a ^^^ b) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase xrvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase xrvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase xrvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [xrvCvB, xrvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (xrvEntrySEnd s)
  rw [h1]
  show (match stepInstBase xrvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [xrvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (xrvEntrySEnd s)
  rw [h2]
  show (match stepInstBase xrvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (xrvEntrySEnd s)
  rw [hsub]
  rfl

/-- `xrvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem xrvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) xrvCtx xrvEntry s = ExecResult.OK (jumpTo "next" (xrvEntrySEnd s)) :=
  runBlock_body_jmp xrvCtx xrvEntry j [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA [xrvCvB, xrvLoad, xrvJmp] s
    (xrvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (xrvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem xrvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg xrvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([xrvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := xrvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev xrvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem xrvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (xrvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (xrvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem xrvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [xrvMul] 0 { s with instIdx := 0 } = some (xrvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase xrvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := xrvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase xrvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem xrvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase xrvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [xrvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem xrvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase xrvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [xrvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem xrvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) xrvCtx xrvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (xrvNextSEnd s wb wc))
        (xrvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := xrvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return xrvCtx xrvNext j [xrvMul] xrvRet xrvMul [xrvRet] s (xrvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (xrvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem xrvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) xrvCtx xrvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := xrvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term xrvCtx xrvNext j [xrvMul] xrvRet xrvMul [xrvRet] s (xrvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (xrvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : xrvNext.instructions = [xrvMul] ++ [xrvRet])
    (xrvNext_thread s wb wc hb hc), xrvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `xrvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem xrvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (xrvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (xrvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (xrvEntrySEnd s) = some (xrvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (xrvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (xrvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (xrvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def xrvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (xrvVal s))

theorem xrvInv_pres : ∀ bb ∈ xrvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    xrvInv s → runBlock f' xrvCtx bb s = ExecResult.OK s' → xrvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [xrvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (xrvEntrySEnd s)`
    have hnt : ∀ inst ∈ [xrvCvA, xrvCvB, xrvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof xrvCtx xrvEntry 0 [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA
             [xrvCvB, xrvLoad, xrvJmp] s (xrvEntrySEnd s) rfl rfl (by decide) hnt (xrvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof xrvCtx xrvEntry 1 [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA
             [xrvCvB, xrvLoad, xrvJmp] s (xrvEntrySEnd s) rfl rfl (by decide) hnt (xrvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof xrvCtx xrvEntry 2 [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA
             [xrvCvB, xrvLoad, xrvJmp] s (xrvEntrySEnd s) rfl rfl (by decide) hnt (xrvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof xrvCtx xrvEntry 3 [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA
             [xrvCvB, xrvLoad, xrvJmp] s (xrvEntrySEnd s) rfl rfl (by decide) hnt (xrvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, xrvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := xrvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (xrvEntrySEnd s)) = lookupVar "c" (xrvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 xrvCtx xrvNext s xrvMul [xrvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error xrvCtx xrvNext xrvMul [xrvRet] s "undefined operand" j rfl
          (by decide) (xrvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 xrvCtx xrvNext s xrvMul [xrvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error xrvCtx xrvNext xrvMul [xrvRet] s "undefined operand" j rfl
            (by decide) (xrvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 xrvCtx xrvNext s xrvMul [xrvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof xrvCtx xrvNext 1 [xrvMul] xrvRet xrvMul [xrvRet] s
                   (xrvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (xrvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, xrvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 xrvCtx xrvNext s xrvMul [xrvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof xrvCtx xrvNext 1 [xrvMul] xrvRet xrvMul [xrvRet] s
                   (xrvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (xrvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, xrvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 xrvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem xrvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 xrvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 xrvCtx vs
      = runBlocks 10 xrvCtx xrvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, xrvCtx, xrvFn, lookupFunction, fnEntryLabel, xrvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (xrvEntrySEnd s0) with hs1
  have hentry : runBlock 9 xrvCtx xrvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact xrvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb xrvFn.blocks = some xrvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 xrvCtx xrvFn s0 = runBlocks 9 xrvCtx xrvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := xrvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (xrvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (xrvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb xrvFn.blocks = some xrvNext := rfl
  have hhalt := xrvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (xrvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (XOR) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=XOR %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s XOR exercises `RegularStep`'s non-commutative
    commutative binop arm (`asmStep_xor_ok`), emitted `DUP1 ; DUP3 ; XOR`, leaving `c = XOR(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_xrvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 xrvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ xrvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [xrvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [xrvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [xrvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan xrvFn 0 0
      = some ((generateFnPlan xrvFn 0 0).get!.1, (generateFnPlan xrvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel xrvFn) xrvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv xrvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel xrvFn) xrvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan xrvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := xrvCtx) (fn := xrvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan xrvFn 0 0).get!.1) (psFinal := (generateFnPlan xrvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ xrvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [xrvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, xrvEntry, xrvCvA]
    · simp [runBlock, evalPhis, execBlock, xrvNext, xrvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [xrvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [xrvCvA, xrvCvB, xrvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof xrvCtx xrvEntry 1 [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA
               [xrvCvB, xrvLoad, xrvJmp] s (xrvEntrySEnd s) rfl rfl (by decide) hnt (xrvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof xrvCtx xrvEntry 2 [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA
               [xrvCvB, xrvLoad, xrvJmp] s (xrvEntrySEnd s) rfl rfl (by decide) hnt (xrvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof xrvCtx xrvEntry 3 [xrvCvA, xrvCvB, xrvLoad] xrvJmp xrvCvA
               [xrvCvB, xrvLoad, xrvJmp] s (xrvEntrySEnd s) rfl rfl (by decide) hnt (xrvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([xrvCvA, xrvCvB, xrvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [xrvCvA, xrvCvB, xrvLoad]) (jmpInst := xrvJmp) (hd := xrvCvA) (tl := [xrvCvB, xrvLoad, xrvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := xrvNext) (sEnd := xrvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := xrvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := xrvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 5 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc8 : asm.pc = 8 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof xrvCtx xrvNext 1 [xrvMul] xrvRet xrvMul [xrvRet] s
               (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (xrvNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([xrvMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [xrvMul]) (retInst := xrvRet) (hd := xrvMul) (tl := [xrvRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel xrvFn) xrvFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := xrvNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s))
            = lookupVar "e" (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s)) from rfl,
            (xrvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (xrvVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s))
            = lookupVar "a" (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s)) from rfl,
            (xrvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (xrvVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s)) from rfl,
            (xrvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (xrvVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (xrvNextSEnd s (EvmYul.UInt256.ofNat 0) (xrvVal s)) from rfl,
            (xrvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (xrvVal s)).2]; exact ha0)
        (hready := xrvNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel xrvFn) xrvFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨xrvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel xrvFn) xrvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan xrvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (EQ) via the recipe route — `codegen_correct_eqvFn_recipeW`

The commutative binop `EQ` (equality), a duplicating var/var compute via `RegularStep`'s
comm arm (`asmStep_eq_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = EQ %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`EQ %a %b` is emitted `DUP1 ; DUP3 ; EQ` (both `a,b` live), leaving `[a, b, c]` with
`c = EQ(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`eqvNext_ready`). -/

def eqvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def eqvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def eqvLoad : Instruction :=
  { id := 2, opcode := Opcode.EQ, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def eqvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def eqvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def eqvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def eqvEntry : BasicBlock := { label := "entry", instructions := [eqvCvA, eqvCvB, eqvLoad, eqvJmp] }
def eqvNext : BasicBlock := { label := "next", instructions := [eqvMul, eqvRet] }
def eqvFn : IrFunction := { name := "main", blocks := [eqvEntry, eqvNext] }
def eqvCtx : VenomContext := { functions := [eqvFn], entry := some "main" }

theorem eqv_unresolved_asm : executePlan (generateFnPlan eqvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "EQ", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop EQ(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev eqvVal (s : VenomState) : bytes32 := (fun x y => EvmYul.Venom.Hol.boolToWord (x = y)) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; EQ %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    EQ compute via `RegularStep`'s non-comm binop arm (`asmStep_eq_ok`), output live. -/
theorem eqvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan eqvFn 0 0).get!.1)).1 1 [eqvCvA, eqvCvB, eqvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "EQ", rfl, rfl, by decide, by decide,
    Or.inl ⟨"a", "b", (fun x y => EvmYul.Venom.Hol.boolToWord (x = y)), by decide, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_eq_ok h hg⟩⟩

/-- Body-end state of `eqvEntry`: `a,b := callvalue`, `c := eqvVal s` (EQ(a,b) on the call value). -/
abbrev eqvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (eqvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem eqvEntry_thread (s : VenomState) :
    execBodyThread [eqvCvA, eqvCvB, eqvLoad] 0 { s with instIdx := 0 } = some (eqvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := eqvLoad) (f := fun x y => EvmYul.Venom.Hol.boolToWord (x = y)) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase eqvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase eqvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase eqvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [eqvCvB, eqvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (eqvEntrySEnd s)
  rw [h1]
  show (match stepInstBase eqvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [eqvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (eqvEntrySEnd s)
  rw [h2]
  show (match stepInstBase eqvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (eqvEntrySEnd s)
  rw [hsub]
  rfl

/-- `eqvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem eqvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) eqvCtx eqvEntry s = ExecResult.OK (jumpTo "next" (eqvEntrySEnd s)) :=
  runBlock_body_jmp eqvCtx eqvEntry j [eqvCvA, eqvCvB, eqvLoad] eqvJmp eqvCvA [eqvCvB, eqvLoad, eqvJmp] s
    (eqvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (eqvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem eqvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan eqvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan eqvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg eqvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([eqvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := eqvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev eqvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem eqvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (eqvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (eqvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem eqvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [eqvMul] 0 { s with instIdx := 0 } = some (eqvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase eqvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := eqvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase eqvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem eqvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase eqvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [eqvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem eqvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase eqvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [eqvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem eqvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) eqvCtx eqvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (eqvNextSEnd s wb wc))
        (eqvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := eqvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return eqvCtx eqvNext j [eqvMul] eqvRet eqvMul [eqvRet] s (eqvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (eqvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem eqvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) eqvCtx eqvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := eqvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term eqvCtx eqvNext j [eqvMul] eqvRet eqvMul [eqvRet] s (eqvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (eqvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : eqvNext.instructions = [eqvMul] ++ [eqvRet])
    (eqvNext_thread s wb wc hb hc), eqvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `eqvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem eqvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (eqvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (eqvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (eqvEntrySEnd s) = some (eqvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (eqvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (eqvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (eqvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def eqvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (eqvVal s))

theorem eqvInv_pres : ∀ bb ∈ eqvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    eqvInv s → runBlock f' eqvCtx bb s = ExecResult.OK s' → eqvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [eqvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (eqvEntrySEnd s)`
    have hnt : ∀ inst ∈ [eqvCvA, eqvCvB, eqvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof eqvCtx eqvEntry 0 [eqvCvA, eqvCvB, eqvLoad] eqvJmp eqvCvA
             [eqvCvB, eqvLoad, eqvJmp] s (eqvEntrySEnd s) rfl rfl (by decide) hnt (eqvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof eqvCtx eqvEntry 1 [eqvCvA, eqvCvB, eqvLoad] eqvJmp eqvCvA
             [eqvCvB, eqvLoad, eqvJmp] s (eqvEntrySEnd s) rfl rfl (by decide) hnt (eqvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof eqvCtx eqvEntry 2 [eqvCvA, eqvCvB, eqvLoad] eqvJmp eqvCvA
             [eqvCvB, eqvLoad, eqvJmp] s (eqvEntrySEnd s) rfl rfl (by decide) hnt (eqvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof eqvCtx eqvEntry 3 [eqvCvA, eqvCvB, eqvLoad] eqvJmp eqvCvA
             [eqvCvB, eqvLoad, eqvJmp] s (eqvEntrySEnd s) rfl rfl (by decide) hnt (eqvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, eqvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := eqvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (eqvEntrySEnd s)) = lookupVar "c" (eqvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 eqvCtx eqvNext s eqvMul [eqvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error eqvCtx eqvNext eqvMul [eqvRet] s "undefined operand" j rfl
          (by decide) (eqvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 eqvCtx eqvNext s eqvMul [eqvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error eqvCtx eqvNext eqvMul [eqvRet] s "undefined operand" j rfl
            (by decide) (eqvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 eqvCtx eqvNext s eqvMul [eqvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof eqvCtx eqvNext 1 [eqvMul] eqvRet eqvMul [eqvRet] s
                   (eqvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (eqvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, eqvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 eqvCtx eqvNext s eqvMul [eqvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof eqvCtx eqvNext 1 [eqvMul] eqvRet eqvMul [eqvRet] s
                   (eqvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (eqvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, eqvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 eqvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem eqvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 eqvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 eqvCtx vs
      = runBlocks 10 eqvCtx eqvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, eqvCtx, eqvFn, lookupFunction, fnEntryLabel, eqvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (eqvEntrySEnd s0) with hs1
  have hentry : runBlock 9 eqvCtx eqvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact eqvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb eqvFn.blocks = some eqvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 eqvCtx eqvFn s0 = runBlocks 9 eqvCtx eqvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := eqvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (eqvVal s0) := by
