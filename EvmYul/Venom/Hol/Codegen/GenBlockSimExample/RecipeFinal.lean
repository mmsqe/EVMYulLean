/-! ### ✅ A BINOP (SHR) via the recipe route — `codegen_correct_srvFn_recipeW`

The non-commutative binop `SHR` (logical shift-right), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_shr_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SHR %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`SHR %a %b` is emitted `DUP1 ; DUP3 ; SHR` (both `a,b` live), leaving `[a, b, c]` with
`c = SHR(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`srvNext_ready`). -/

def srvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def srvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def srvLoad : Instruction :=
  { id := 2, opcode := Opcode.SHR, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def srvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def srvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def srvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def srvEntry : BasicBlock := { label := "entry", instructions := [srvCvA, srvCvB, srvLoad, srvJmp] }
def srvNext : BasicBlock := { label := "next", instructions := [srvMul, srvRet] }
def srvFn : IrFunction := { name := "main", blocks := [srvEntry, srvNext] }
def srvCtx : VenomContext := { functions := [srvFn], entry := some "main" }

theorem srv_unresolved_asm : executePlan (generateFnPlan srvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "SHR", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop SHR(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev srvVal (s : VenomState) : bytes32 := ((fun n w => w >>> n)) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; SHR %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    SHR compute via `RegularStep`'s non-comm binop arm (`asmStep_shr_ok`), output live. -/
theorem srvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1 1 [srvCvA, srvCvB, srvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "SHR", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", ((fun n w => w >>> n)), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_shr_ok h hg⟩)⟩

/-- Body-end state of `srvEntry`: `a,b := callvalue`, `c := srvVal s` (SHR(a,b) on the call value). -/
abbrev srvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (srvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem srvEntry_thread (s : VenomState) :
    execBodyThread [srvCvA, srvCvB, srvLoad] 0 { s with instIdx := 0 } = some (srvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := srvLoad) (f := (fun n w => w >>> n)) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase srvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase srvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase srvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [srvCvB, srvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (srvEntrySEnd s)
  rw [h1]
  show (match stepInstBase srvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [srvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (srvEntrySEnd s)
  rw [h2]
  show (match stepInstBase srvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (srvEntrySEnd s)
  rw [hsub]
  rfl

/-- `srvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem srvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) srvCtx srvEntry s = ExecResult.OK (jumpTo "next" (srvEntrySEnd s)) :=
  runBlock_body_jmp srvCtx srvEntry j [srvCvA, srvCvB, srvLoad] srvJmp srvCvA [srvCvB, srvLoad, srvJmp] s
    (srvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (srvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem srvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg srvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([srvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := srvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev srvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem srvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (srvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (srvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem srvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [srvMul] 0 { s with instIdx := 0 } = some (srvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase srvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := srvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase srvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem srvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase srvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [srvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem srvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase srvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [srvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem srvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) srvCtx srvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (srvNextSEnd s wb wc))
        (srvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := srvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return srvCtx srvNext j [srvMul] srvRet srvMul [srvRet] s (srvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (srvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem srvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) srvCtx srvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := srvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term srvCtx srvNext j [srvMul] srvRet srvMul [srvRet] s (srvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (srvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : srvNext.instructions = [srvMul] ++ [srvRet])
    (srvNext_thread s wb wc hb hc), srvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `srvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem srvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (srvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (srvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (srvEntrySEnd s) = some (srvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (srvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (srvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (srvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def srvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (srvVal s))

theorem srvInv_pres : ∀ bb ∈ srvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    srvInv s → runBlock f' srvCtx bb s = ExecResult.OK s' → srvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [srvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (srvEntrySEnd s)`
    have hnt : ∀ inst ∈ [srvCvA, srvCvB, srvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof srvCtx srvEntry 0 [srvCvA, srvCvB, srvLoad] srvJmp srvCvA
             [srvCvB, srvLoad, srvJmp] s (srvEntrySEnd s) rfl rfl (by decide) hnt (srvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof srvCtx srvEntry 1 [srvCvA, srvCvB, srvLoad] srvJmp srvCvA
             [srvCvB, srvLoad, srvJmp] s (srvEntrySEnd s) rfl rfl (by decide) hnt (srvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof srvCtx srvEntry 2 [srvCvA, srvCvB, srvLoad] srvJmp srvCvA
             [srvCvB, srvLoad, srvJmp] s (srvEntrySEnd s) rfl rfl (by decide) hnt (srvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof srvCtx srvEntry 3 [srvCvA, srvCvB, srvLoad] srvJmp srvCvA
             [srvCvB, srvLoad, srvJmp] s (srvEntrySEnd s) rfl rfl (by decide) hnt (srvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, srvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := srvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (srvEntrySEnd s)) = lookupVar "c" (srvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 srvCtx srvNext s srvMul [srvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error srvCtx srvNext srvMul [srvRet] s "undefined operand" j rfl
          (by decide) (srvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 srvCtx srvNext s srvMul [srvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error srvCtx srvNext srvMul [srvRet] s "undefined operand" j rfl
            (by decide) (srvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 srvCtx srvNext s srvMul [srvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof srvCtx srvNext 1 [srvMul] srvRet srvMul [srvRet] s
                   (srvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (srvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, srvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 srvCtx srvNext s srvMul [srvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof srvCtx srvNext 1 [srvMul] srvRet srvMul [srvRet] s
                   (srvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (srvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, srvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 srvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem srvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 srvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 srvCtx vs
      = runBlocks 10 srvCtx srvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, srvCtx, srvFn, lookupFunction, fnEntryLabel, srvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (srvEntrySEnd s0) with hs1
  have hentry : runBlock 9 srvCtx srvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact srvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb srvFn.blocks = some srvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 srvCtx srvFn s0 = runBlocks 9 srvCtx srvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := srvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (srvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (srvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb srvFn.blocks = some srvNext := rfl
  have hhalt := srvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (srvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (SHR) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=SHR %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s SHR exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_shr_ok`), emitted `DUP1 ; DUP3 ; SHR`, leaving `c = SHR(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_srvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 srvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ srvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [srvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [srvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [srvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan srvFn 0 0
      = some ((generateFnPlan srvFn 0 0).get!.1, (generateFnPlan srvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel srvFn) srvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv srvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel srvFn) srvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan srvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := srvCtx) (fn := srvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan srvFn 0 0).get!.1) (psFinal := (generateFnPlan srvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ srvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [srvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, srvEntry, srvCvA]
    · simp [runBlock, evalPhis, execBlock, srvNext, srvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [srvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [srvCvA, srvCvB, srvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof srvCtx srvEntry 1 [srvCvA, srvCvB, srvLoad] srvJmp srvCvA
               [srvCvB, srvLoad, srvJmp] s (srvEntrySEnd s) rfl rfl (by decide) hnt (srvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof srvCtx srvEntry 2 [srvCvA, srvCvB, srvLoad] srvJmp srvCvA
               [srvCvB, srvLoad, srvJmp] s (srvEntrySEnd s) rfl rfl (by decide) hnt (srvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof srvCtx srvEntry 3 [srvCvA, srvCvB, srvLoad] srvJmp srvCvA
               [srvCvB, srvLoad, srvJmp] s (srvEntrySEnd s) rfl rfl (by decide) hnt (srvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([srvCvA, srvCvB, srvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [srvCvA, srvCvB, srvLoad]) (jmpInst := srvJmp) (hd := srvCvA) (tl := [srvCvB, srvLoad, srvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := srvNext) (sEnd := srvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := srvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := srvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 5 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc8 : asm.pc = 8 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof srvCtx srvNext 1 [srvMul] srvRet srvMul [srvRet] s
               (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (srvNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([srvMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [srvMul]) (retInst := srvRet) (hd := srvMul) (tl := [srvRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel srvFn) srvFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := srvNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s))
            = lookupVar "e" (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s)) from rfl,
            (srvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (srvVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s))
            = lookupVar "a" (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s)) from rfl,
            (srvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (srvVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s)) from rfl,
            (srvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (srvVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (srvNextSEnd s (EvmYul.UInt256.ofNat 0) (srvVal s)) from rfl,
            (srvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (srvVal s)).2]; exact ha0)
        (hready := srvNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel srvFn) srvFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨srvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel srvFn) srvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan srvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (SAR) via the recipe route — `codegen_correct_savFn_recipeW`

The non-commutative binop `SAR` (arithmetic shift-right), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_sar_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SAR %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`SAR %a %b` is emitted `DUP1 ; DUP3 ; SAR` (both `a,b` live), leaving `[a, b, c]` with
`c = SAR(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`savNext_ready`). -/

def savCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def savCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def savLoad : Instruction :=
  { id := 2, opcode := Opcode.SAR, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def savJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def savMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def savRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def savEntry : BasicBlock := { label := "entry", instructions := [savCvA, savCvB, savLoad, savJmp] }
def savNext : BasicBlock := { label := "next", instructions := [savMul, savRet] }
def savFn : IrFunction := { name := "main", blocks := [savEntry, savNext] }
def savCtx : VenomContext := { functions := [savFn], entry := some "main" }

theorem sav_unresolved_asm : executePlan (generateFnPlan savFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "SAR", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop SAR(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev savVal (s : VenomState) : bytes32 := (EvmYul.UInt256.sar) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; SAR %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    SAR compute via `RegularStep`'s non-comm binop arm (`asmStep_sar_ok`), output live. -/
theorem savEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).1 1 [savCvA, savCvB, savLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "SAR", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.UInt256.sar), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_sar_ok h hg⟩)⟩

/-- Body-end state of `savEntry`: `a,b := callvalue`, `c := savVal s` (SAR(a,b) on the call value). -/
abbrev savEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (savVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem savEntry_thread (s : VenomState) :
    execBodyThread [savCvA, savCvB, savLoad] 0 { s with instIdx := 0 } = some (savEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := savLoad) (f := EvmYul.UInt256.sar) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase savCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase savCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase savCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [savCvB, savLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (savEntrySEnd s)
  rw [h1]
  show (match stepInstBase savCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [savLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (savEntrySEnd s)
  rw [h2]
  show (match stepInstBase savLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (savEntrySEnd s)
  rw [hsub]
  rfl

/-- `savEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem savEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) savCtx savEntry s = ExecResult.OK (jumpTo "next" (savEntrySEnd s)) :=
  runBlock_body_jmp savCtx savEntry j [savCvA, savCvB, savLoad] savJmp savCvA [savCvB, savLoad, savJmp] s
    (savEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (savEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem savNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan savFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg savFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([savMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := savFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev savNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem savNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (savNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (savNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem savNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [savMul] 0 { s with instIdx := 0 } = some (savNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase savMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := savMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase savMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem savMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase savMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [savMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem savMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase savMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [savMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem savNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) savCtx savNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (savNextSEnd s wb wc))
        (savNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := savNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return savCtx savNext j [savMul] savRet savMul [savRet] s (savNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (savNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem savNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) savCtx savNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := savNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term savCtx savNext j [savMul] savRet savMul [savRet] s (savNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (savNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : savNext.instructions = [savMul] ++ [savRet])
    (savNext_thread s wb wc hb hc), savRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `savEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem savEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (savEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (savEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (savEntrySEnd s) = some (savVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (savVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (savVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (savVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def savInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (savVal s))

theorem savInv_pres : ∀ bb ∈ savFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    savInv s → runBlock f' savCtx bb s = ExecResult.OK s' → savInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [savFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (savEntrySEnd s)`
    have hnt : ∀ inst ∈ [savCvA, savCvB, savLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof savCtx savEntry 0 [savCvA, savCvB, savLoad] savJmp savCvA
             [savCvB, savLoad, savJmp] s (savEntrySEnd s) rfl rfl (by decide) hnt (savEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof savCtx savEntry 1 [savCvA, savCvB, savLoad] savJmp savCvA
             [savCvB, savLoad, savJmp] s (savEntrySEnd s) rfl rfl (by decide) hnt (savEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof savCtx savEntry 2 [savCvA, savCvB, savLoad] savJmp savCvA
             [savCvB, savLoad, savJmp] s (savEntrySEnd s) rfl rfl (by decide) hnt (savEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof savCtx savEntry 3 [savCvA, savCvB, savLoad] savJmp savCvA
             [savCvB, savLoad, savJmp] s (savEntrySEnd s) rfl rfl (by decide) hnt (savEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, savEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := savEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (savEntrySEnd s)) = lookupVar "c" (savEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 savCtx savNext s savMul [savRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error savCtx savNext savMul [savRet] s "undefined operand" j rfl
          (by decide) (savMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 savCtx savNext s savMul [savRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error savCtx savNext savMul [savRet] s "undefined operand" j rfl
            (by decide) (savMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 savCtx savNext s savMul [savRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof savCtx savNext 1 [savMul] savRet savMul [savRet] s
                   (savNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (savNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, savNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 savCtx savNext s savMul [savRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof savCtx savNext 1 [savMul] savRet savMul [savRet] s
                   (savNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (savNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, savNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 savCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem savFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 savCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 savCtx vs
      = runBlocks 10 savCtx savFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, savCtx, savFn, lookupFunction, fnEntryLabel, savEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (savEntrySEnd s0) with hs1
  have hentry : runBlock 9 savCtx savEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact savEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb savFn.blocks = some savEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 savCtx savFn s0 = runBlocks 9 savCtx savFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := savEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (savVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (savEntrySEnd s0) from rfl, hc1]
