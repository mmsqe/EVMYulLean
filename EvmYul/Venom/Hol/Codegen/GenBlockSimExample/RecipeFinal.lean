      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan gtvFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A BINOP (SLT) via the recipe route — `codegen_correct_slvFn_recipeW`

The non-commutative binop `SLT` (signed less-than), a duplicating var/var compute via `RegularStep`'s
non-comm arm (`asmStep_slt_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = SLT %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`SLT %a %b` is emitted `DUP1 ; DUP3 ; SLT` (both `a,b` live), leaving `[a, b, c]` with
`c = SLT(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`slvNext_ready`). -/

def slvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def slvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def slvLoad : Instruction :=
  { id := 2, opcode := Opcode.SLT, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def slvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def slvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def slvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def slvEntry : BasicBlock := { label := "entry", instructions := [slvCvA, slvCvB, slvLoad, slvJmp] }
def slvNext : BasicBlock := { label := "next", instructions := [slvMul, slvRet] }
def slvFn : IrFunction := { name := "main", blocks := [slvEntry, slvNext] }
def slvCtx : VenomContext := { functions := [slvFn], entry := some "main" }

theorem slv_unresolved_asm : executePlan (generateFnPlan slvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "SLT", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop SLT(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev slvVal (s : VenomState) : bytes32 := (EvmYul.UInt256.slt) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; SLT %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    SLT compute via `RegularStep`'s non-comm binop arm (`asmStep_slt_ok`), output live. -/
theorem slvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1 1 [slvCvA, slvCvB, slvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "SLT", rfl, rfl, by decide, by decide,
    Or.inr (Or.inl ⟨"a", "b", (EvmYul.UInt256.slt), by decide, by decide, rfl, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_slt_ok h hg⟩)⟩

/-- Body-end state of `slvEntry`: `a,b := callvalue`, `c := slvVal s` (SLT(a,b) on the call value). -/
abbrev slvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (slvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem slvEntry_thread (s : VenomState) :
    execBodyThread [slvCvA, slvCvB, slvLoad] 0 { s with instIdx := 0 } = some (slvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := slvLoad) (f := EvmYul.UInt256.slt) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase slvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase slvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase slvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [slvCvB, slvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (slvEntrySEnd s)
  rw [h1]
  show (match stepInstBase slvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [slvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (slvEntrySEnd s)
  rw [h2]
  show (match stepInstBase slvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (slvEntrySEnd s)
  rw [hsub]
  rfl

/-- `slvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem slvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) slvCtx slvEntry s = ExecResult.OK (jumpTo "next" (slvEntrySEnd s)) :=
  runBlock_body_jmp slvCtx slvEntry j [slvCvA, slvCvB, slvLoad] slvJmp slvCvA [slvCvB, slvLoad, slvJmp] s
    (slvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (slvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem slvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg slvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([slvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := slvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev slvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem slvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (slvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (slvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem slvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [slvMul] 0 { s with instIdx := 0 } = some (slvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase slvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := slvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase slvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem slvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase slvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [slvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem slvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase slvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [slvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem slvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) slvCtx slvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (slvNextSEnd s wb wc))
        (slvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := slvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return slvCtx slvNext j [slvMul] slvRet slvMul [slvRet] s (slvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (slvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem slvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) slvCtx slvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := slvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term slvCtx slvNext j [slvMul] slvRet slvMul [slvRet] s (slvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (slvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : slvNext.instructions = [slvMul] ++ [slvRet])
    (slvNext_thread s wb wc hb hc), slvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `slvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem slvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (slvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (slvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (slvEntrySEnd s) = some (slvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (slvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (slvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (slvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def slvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (slvVal s))

theorem slvInv_pres : ∀ bb ∈ slvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    slvInv s → runBlock f' slvCtx bb s = ExecResult.OK s' → slvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [slvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (slvEntrySEnd s)`
    have hnt : ∀ inst ∈ [slvCvA, slvCvB, slvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof slvCtx slvEntry 0 [slvCvA, slvCvB, slvLoad] slvJmp slvCvA
             [slvCvB, slvLoad, slvJmp] s (slvEntrySEnd s) rfl rfl (by decide) hnt (slvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof slvCtx slvEntry 1 [slvCvA, slvCvB, slvLoad] slvJmp slvCvA
             [slvCvB, slvLoad, slvJmp] s (slvEntrySEnd s) rfl rfl (by decide) hnt (slvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof slvCtx slvEntry 2 [slvCvA, slvCvB, slvLoad] slvJmp slvCvA
             [slvCvB, slvLoad, slvJmp] s (slvEntrySEnd s) rfl rfl (by decide) hnt (slvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof slvCtx slvEntry 3 [slvCvA, slvCvB, slvLoad] slvJmp slvCvA
             [slvCvB, slvLoad, slvJmp] s (slvEntrySEnd s) rfl rfl (by decide) hnt (slvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, slvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := slvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (slvEntrySEnd s)) = lookupVar "c" (slvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 slvCtx slvNext s slvMul [slvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error slvCtx slvNext slvMul [slvRet] s "undefined operand" j rfl
          (by decide) (slvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 slvCtx slvNext s slvMul [slvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error slvCtx slvNext slvMul [slvRet] s "undefined operand" j rfl
            (by decide) (slvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 slvCtx slvNext s slvMul [slvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof slvCtx slvNext 1 [slvMul] slvRet slvMul [slvRet] s
                   (slvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (slvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, slvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 slvCtx slvNext s slvMul [slvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof slvCtx slvNext 1 [slvMul] slvRet slvMul [slvRet] s
                   (slvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (slvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, slvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 slvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem slvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 slvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 slvCtx vs
      = runBlocks 10 slvCtx slvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, slvCtx, slvFn, lookupFunction, fnEntryLabel, slvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (slvEntrySEnd s0) with hs1
  have hentry : runBlock 9 slvCtx slvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact slvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb slvFn.blocks = some slvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 slvCtx slvFn s0 = runBlocks 9 slvCtx slvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := slvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (slvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (slvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb slvFn.blocks = some slvNext := rfl
  have hhalt := slvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (slvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (SLT) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=SLT %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s SLT exercises `RegularStep`'s non-commutative
    binop arm (`asmStep_slt_ok`), emitted `DUP1 ; DUP3 ; SLT`, leaving `c = SLT(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_slvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 slvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ slvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [slvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [slvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [slvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan slvFn 0 0
      = some ((generateFnPlan slvFn 0 0).get!.1, (generateFnPlan slvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel slvFn) slvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv slvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel slvFn) slvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan slvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan slvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := slvCtx) (fn := slvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan slvFn 0 0).get!.1) (psFinal := (generateFnPlan slvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ slvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [slvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, slvEntry, slvCvA]
    · simp [runBlock, evalPhis, execBlock, slvNext, slvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [slvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [slvCvA, slvCvB, slvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof slvCtx slvEntry 1 [slvCvA, slvCvB, slvLoad] slvJmp slvCvA
               [slvCvB, slvLoad, slvJmp] s (slvEntrySEnd s) rfl rfl (by decide) hnt (slvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof slvCtx slvEntry 2 [slvCvA, slvCvB, slvLoad] slvJmp slvCvA
               [slvCvB, slvLoad, slvJmp] s (slvEntrySEnd s) rfl rfl (by decide) hnt (slvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof slvCtx slvEntry 3 [slvCvA, slvCvB, slvLoad] slvJmp slvCvA
               [slvCvB, slvLoad, slvJmp] s (slvEntrySEnd s) rfl rfl (by decide) hnt (slvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([slvCvA, slvCvB, slvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [slvCvA, slvCvB, slvLoad]) (jmpInst := slvJmp) (hd := slvCvA) (tl := [slvCvB, slvLoad, slvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := slvNext) (sEnd := slvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := slvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := slvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
