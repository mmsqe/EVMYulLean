      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan iszFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan iszFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan iszFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan iszFn 0 0).get!.1)).1.length
      omega

/-! ### ✅ A BINOP (MUL) via the recipe route — `codegen_correct_mlvFn_recipeW`

The commutative binop `MUL` (multiplication), a duplicating var/var compute via `RegularStep`'s
comm arm (`asmStep_mul_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = MUL %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`MUL %a %b` is emitted `DUP1 ; DUP3 ; MUL` (both `a,b` live), leaving `[a, b, c]` with
`c = MUL(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`mlvNext_ready`). -/

def mlvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def mlvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def mlvLoad : Instruction :=
  { id := 2, opcode := Opcode.MUL, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def mlvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def mlvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def mlvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def mlvEntry : BasicBlock := { label := "entry", instructions := [mlvCvA, mlvCvB, mlvLoad, mlvJmp] }
def mlvNext : BasicBlock := { label := "next", instructions := [mlvMul, mlvRet] }
def mlvFn : IrFunction := { name := "main", blocks := [mlvEntry, mlvNext] }
def mlvCtx : VenomContext := { functions := [mlvFn], entry := some "main" }

theorem mlv_unresolved_asm : executePlan (generateFnPlan mlvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "MUL", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop MUL(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev mlvVal (s : VenomState) : bytes32 := (fun a b => a * b) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; MUL %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    MUL compute via `RegularStep`'s non-comm binop arm (`asmStep_mul_ok`), output live. -/
theorem mlvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1 1 [mlvCvA, mlvCvB, mlvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "MUL", rfl, rfl, by decide, by decide,
    Or.inl ⟨"a", "b", (fun a b => a * b), by decide, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_mul_ok h hg⟩⟩

/-- Body-end state of `mlvEntry`: `a,b := callvalue`, `c := mlvVal s` (MUL(a,b) on the call value). -/
abbrev mlvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (mlvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem mlvEntry_thread (s : VenomState) :
    execBodyThread [mlvCvA, mlvCvB, mlvLoad] 0 { s with instIdx := 0 } = some (mlvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := mlvLoad) (f := fun a b => a * b) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase mlvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase mlvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase mlvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [mlvCvB, mlvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (mlvEntrySEnd s)
  rw [h1]
  show (match stepInstBase mlvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [mlvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (mlvEntrySEnd s)
  rw [h2]
  show (match stepInstBase mlvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (mlvEntrySEnd s)
  rw [hsub]
  rfl

/-- `mlvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem mlvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) mlvCtx mlvEntry s = ExecResult.OK (jumpTo "next" (mlvEntrySEnd s)) :=
  runBlock_body_jmp mlvCtx mlvEntry j [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA [mlvCvB, mlvLoad, mlvJmp] s
    (mlvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (mlvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem mlvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg mlvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([mlvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := mlvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev mlvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem mlvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (mlvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (mlvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem mlvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [mlvMul] 0 { s with instIdx := 0 } = some (mlvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase mlvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := mlvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase mlvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem mlvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase mlvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [mlvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem mlvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase mlvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [mlvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem mlvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) mlvCtx mlvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (mlvNextSEnd s wb wc))
        (mlvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := mlvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return mlvCtx mlvNext j [mlvMul] mlvRet mlvMul [mlvRet] s (mlvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (mlvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem mlvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) mlvCtx mlvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := mlvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term mlvCtx mlvNext j [mlvMul] mlvRet mlvMul [mlvRet] s (mlvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (mlvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : mlvNext.instructions = [mlvMul] ++ [mlvRet])
    (mlvNext_thread s wb wc hb hc), mlvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `mlvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem mlvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (mlvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (mlvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (mlvEntrySEnd s) = some (mlvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (mlvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (mlvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (mlvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def mlvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (mlvVal s))

theorem mlvInv_pres : ∀ bb ∈ mlvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    mlvInv s → runBlock f' mlvCtx bb s = ExecResult.OK s' → mlvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [mlvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (mlvEntrySEnd s)`
    have hnt : ∀ inst ∈ [mlvCvA, mlvCvB, mlvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof mlvCtx mlvEntry 0 [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA
             [mlvCvB, mlvLoad, mlvJmp] s (mlvEntrySEnd s) rfl rfl (by decide) hnt (mlvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof mlvCtx mlvEntry 1 [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA
             [mlvCvB, mlvLoad, mlvJmp] s (mlvEntrySEnd s) rfl rfl (by decide) hnt (mlvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof mlvCtx mlvEntry 2 [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA
             [mlvCvB, mlvLoad, mlvJmp] s (mlvEntrySEnd s) rfl rfl (by decide) hnt (mlvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof mlvCtx mlvEntry 3 [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA
             [mlvCvB, mlvLoad, mlvJmp] s (mlvEntrySEnd s) rfl rfl (by decide) hnt (mlvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, mlvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := mlvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (mlvEntrySEnd s)) = lookupVar "c" (mlvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 mlvCtx mlvNext s mlvMul [mlvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error mlvCtx mlvNext mlvMul [mlvRet] s "undefined operand" j rfl
          (by decide) (mlvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 mlvCtx mlvNext s mlvMul [mlvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error mlvCtx mlvNext mlvMul [mlvRet] s "undefined operand" j rfl
            (by decide) (mlvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 mlvCtx mlvNext s mlvMul [mlvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof mlvCtx mlvNext 1 [mlvMul] mlvRet mlvMul [mlvRet] s
                   (mlvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (mlvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, mlvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 mlvCtx mlvNext s mlvMul [mlvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof mlvCtx mlvNext 1 [mlvMul] mlvRet mlvMul [mlvRet] s
                   (mlvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (mlvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, mlvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 mlvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem mlvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 mlvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 mlvCtx vs
      = runBlocks 10 mlvCtx mlvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, mlvCtx, mlvFn, lookupFunction, fnEntryLabel, mlvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (mlvEntrySEnd s0) with hs1
  have hentry : runBlock 9 mlvCtx mlvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact mlvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb mlvFn.blocks = some mlvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 mlvCtx mlvFn s0 = runBlocks 9 mlvCtx mlvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := mlvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (mlvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (mlvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb mlvFn.blocks = some mlvNext := rfl
  have hhalt := mlvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (mlvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (MUL) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=MUL %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s MUL exercises `RegularStep`'s non-commutative
    commutative binop arm (`asmStep_mul_ok`), emitted `DUP1 ; DUP3 ; MUL`, leaving `c = MUL(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_mlvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 mlvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ mlvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [mlvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [mlvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [mlvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan mlvFn 0 0
      = some ((generateFnPlan mlvFn 0 0).get!.1, (generateFnPlan mlvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel mlvFn) mlvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv mlvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel mlvFn) mlvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan mlvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := mlvCtx) (fn := mlvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan mlvFn 0 0).get!.1) (psFinal := (generateFnPlan mlvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ mlvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [mlvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, mlvEntry, mlvCvA]
    · simp [runBlock, evalPhis, execBlock, mlvNext, mlvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [mlvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [mlvCvA, mlvCvB, mlvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof mlvCtx mlvEntry 1 [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA
               [mlvCvB, mlvLoad, mlvJmp] s (mlvEntrySEnd s) rfl rfl (by decide) hnt (mlvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof mlvCtx mlvEntry 2 [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA
               [mlvCvB, mlvLoad, mlvJmp] s (mlvEntrySEnd s) rfl rfl (by decide) hnt (mlvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof mlvCtx mlvEntry 3 [mlvCvA, mlvCvB, mlvLoad] mlvJmp mlvCvA
               [mlvCvB, mlvLoad, mlvJmp] s (mlvEntrySEnd s) rfl rfl (by decide) hnt (mlvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([mlvCvA, mlvCvB, mlvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [mlvCvA, mlvCvB, mlvLoad]) (jmpInst := mlvJmp) (hd := mlvCvA) (tl := [mlvCvB, mlvLoad, mlvJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 10) (bb' := mlvNext) (sEnd := mlvEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := mlvEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := mlvEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 5 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc8 : asm.pc = 8 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof mlvCtx mlvNext 1 [mlvMul] mlvRet mlvMul [mlvRet] s
               (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (mlvNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([mlvMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [mlvMul]) (retInst := mlvRet) (hd := mlvMul) (tl := [mlvRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel mlvFn) mlvFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := mlvNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s))
            = lookupVar "e" (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s)) from rfl,
            (mlvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (mlvVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s))
            = lookupVar "a" (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s)) from rfl,
            (mlvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (mlvVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s)) from rfl,
            (mlvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (mlvVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (mlvNextSEnd s (EvmYul.UInt256.ofNat 0) (mlvVal s)) from rfl,
            (mlvNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (mlvVal s)).2]; exact ha0)
        (hready := mlvNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel mlvFn) mlvFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc8]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc8]; decide) (hret := by simp only [hpc8]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨mlvEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel mlvFn) mlvFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan mlvFn 0 0).get!.1)).1.length
      omega

/-! ### ✅ A BINOP (AND) via the recipe route — `codegen_correct_anvFn_recipeW`

The commutative binop `AND` (bitwise and), a duplicating var/var compute via `RegularStep`'s
comm arm (`asmStep_and_ok`):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = AND %a %b ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                                   -- MUL consumes the TOP two (b,c)
```

`AND %a %b` is emitted `DUP1 ; DUP3 ; AND` (both `a,b` live), leaving `[a, b, c]` with
`c = AND(a,b)` (context-dependent in general). In `next` the consuming `MUL %b %c` eats the top
two (`b, c`); since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the
return window. `a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`,
`next` via `hsupplyW_regularReturnTo` fed the consuming `MUL` (`anvNext_ready`). -/

def anvCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def anvCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def anvLoad : Instruction :=
  { id := 2, opcode := Opcode.AND, operands := [Operand.Var "a", Operand.Var "b"], outputs := ["c"] }
def anvJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def anvMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def anvRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def anvEntry : BasicBlock := { label := "entry", instructions := [anvCvA, anvCvB, anvLoad, anvJmp] }
def anvNext : BasicBlock := { label := "next", instructions := [anvMul, anvRet] }
def anvFn : IrFunction := { name := "main", blocks := [anvEntry, anvNext] }
def anvCtx : VenomContext := { functions := [anvFn], entry := some "main" }

theorem anv_unresolved_asm : executePlan (generateFnPlan anvFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "DUP1", AsmInst.AsmOp "DUP3", AsmInst.AsmOp "AND", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The binop AND(a,b) on the call value; context-dependent, generally NON-zero. -/
abbrev anvVal (s : VenomState) : bytes32 := (fun a b => a &&& b) s.callCtx.callvalue s.callCtx.callvalue

/-- entry's body `[CV a; CV b; AND %a %b]` as a `RegularBodyH`: two `cv_step`s then the
    AND compute via `RegularStep`'s non-comm binop arm (`asmStep_and_ok`), output live. -/
theorem anvEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1 1 [anvCvA, anvCvB, anvLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨Or.inl ?_, by decide⟩
  exact ⟨"c", "AND", rfl, rfl, by decide, by decide,
    Or.inl ⟨"a", "b", (fun a b => a &&& b), by decide, fun _ => rfl, rfl,
      by decide, by decide, by decide, by decide, by decide, fun _ h hg => asmStep_and_ok h hg⟩⟩

/-- Body-end state of `anvEntry`: `a,b := callvalue`, `c := anvVal s` (AND(a,b) on the call value). -/
abbrev anvEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (anvVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem anvEntry_thread (s : VenomState) :
    execBodyThread [anvCvA, anvCvB, anvLoad] 0 { s with instIdx := 0 } = some (anvEntrySEnd s) := by
  have hla : lookupVar "a" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue := by
    show lookupVar "a" (updateVar "b" s.callCtx.callvalue
      (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 })) = some s.callCtx.callvalue
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  have hlb : lookupVar "b" ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = some s.callCtx.callvalue :=
    lookupVar_updateVar_self _ _ _
  have hsub := stepInstBase_binopVar (inst := anvLoad) (f := fun a b => a &&& b) (x := "a") (y := "b")
    (out := "c") (wx := s.callCtx.callvalue) (wy := s.callCtx.callvalue) rfl rfl rfl hla hlb
  have h1 : stepInstBase anvCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase anvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase anvCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [anvCvB, anvLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (anvEntrySEnd s)
  rw [h1]
  show (match stepInstBase anvCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [anvLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (anvEntrySEnd s)
  rw [h2]
  show (match stepInstBase anvLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (anvEntrySEnd s)
  rw [hsub]
  rfl

/-- `anvEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem anvEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) anvCtx anvEntry s = ExecResult.OK (jumpTo "next" (anvEntrySEnd s)) :=
  runBlock_body_jmp anvCtx anvEntry j [anvCvA, anvCvB, anvLoad] anvJmp anvCvA [anvCvB, anvLoad, anvJmp] s
    (anvEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (anvEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem anvNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg anvFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([anvMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := anvFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev anvNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem anvNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (anvNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (anvNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem anvNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [anvMul] 0 { s with instIdx := 0 } = some (anvNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase anvMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := anvMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase anvMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem anvMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase anvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [anvMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem anvMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase anvMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [anvMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem anvNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) anvCtx anvNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (anvNextSEnd s wb wc))
        (anvNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := anvNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return anvCtx anvNext j [anvMul] anvRet anvMul [anvRet] s (anvNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (anvNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem anvNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) anvCtx anvNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := anvNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term anvCtx anvNext j [anvMul] anvRet anvMul [anvRet] s (anvNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (anvNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : anvNext.instructions = [anvMul] ++ [anvRet])
    (anvNext_thread s wb wc hb hc), anvRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `anvEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem anvEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (anvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (anvEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (anvEntrySEnd s) = some (anvVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (anvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (anvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (anvVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def anvInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (anvVal s))

theorem anvInv_pres : ∀ bb ∈ anvFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    anvInv s → runBlock f' anvCtx bb s = ExecResult.OK s' → anvInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [anvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (anvEntrySEnd s)`
    have hnt : ∀ inst ∈ [anvCvA, anvCvB, anvLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof anvCtx anvEntry 0 [anvCvA, anvCvB, anvLoad] anvJmp anvCvA
             [anvCvB, anvLoad, anvJmp] s (anvEntrySEnd s) rfl rfl (by decide) hnt (anvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof anvCtx anvEntry 1 [anvCvA, anvCvB, anvLoad] anvJmp anvCvA
             [anvCvB, anvLoad, anvJmp] s (anvEntrySEnd s) rfl rfl (by decide) hnt (anvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof anvCtx anvEntry 2 [anvCvA, anvCvB, anvLoad] anvJmp anvCvA
             [anvCvB, anvLoad, anvJmp] s (anvEntrySEnd s) rfl rfl (by decide) hnt (anvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof anvCtx anvEntry 3 [anvCvA, anvCvB, anvLoad] anvJmp anvCvA
             [anvCvB, anvLoad, anvJmp] s (anvEntrySEnd s) rfl rfl (by decide) hnt (anvEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, anvEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := anvEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (anvEntrySEnd s)) = lookupVar "c" (anvEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 anvCtx anvNext s anvMul [anvRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error anvCtx anvNext anvMul [anvRet] s "undefined operand" j rfl
          (by decide) (anvMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 anvCtx anvNext s anvMul [anvRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error anvCtx anvNext anvMul [anvRet] s "undefined operand" j rfl
            (by decide) (anvMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 anvCtx anvNext s anvMul [anvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof anvCtx anvNext 1 [anvMul] anvRet anvMul [anvRet] s
                   (anvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (anvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, anvNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 anvCtx anvNext s anvMul [anvRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof anvCtx anvNext 1 [anvMul] anvRet anvMul [anvRet] s
                   (anvNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (anvNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, anvNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 anvCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem anvFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 anvCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 anvCtx vs
      = runBlocks 10 anvCtx anvFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, anvCtx, anvFn, lookupFunction, fnEntryLabel, anvEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (anvEntrySEnd s0) with hs1
  have hentry : runBlock 9 anvCtx anvEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact anvEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb anvFn.blocks = some anvEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 anvCtx anvFn s0 = runBlocks 9 anvCtx anvFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := anvEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (anvVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (anvEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb anvFn.blocks = some anvNext := rfl
  have hhalt := anvNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (anvVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A BINOP (AND) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=AND %a %b ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s AND exercises `RegularStep`'s non-commutative
    commutative binop arm (`asmStep_and_ok`), emitted `DUP1 ; DUP3 ; AND`, leaving `c = AND(a,b)` (context-dependent).
    `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a reorder); `b = 0` ⇒
    `e = 0` (`uint256_zero_mul`) empties the return window. `next` via `hsupplyW_regularReturnTo`;
    `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_anvFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 anvCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ anvFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [anvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [anvEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [anvNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan anvFn 0 0
      = some ((generateFnPlan anvFn 0 0).get!.1, (generateFnPlan anvFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel anvFn) anvFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv anvInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel anvFn) anvFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan anvFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan anvFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := anvCtx) (fn := anvFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan anvFn 0 0).get!.1) (psFinal := (generateFnPlan anvFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ anvInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [anvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, anvEntry, anvCvA]
    · simp [runBlock, evalPhis, execBlock, anvNext, anvMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [anvFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [anvCvA, anvCvB, anvLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof anvCtx anvEntry 1 [anvCvA, anvCvB, anvLoad] anvJmp anvCvA
               [anvCvB, anvLoad, anvJmp] s (anvEntrySEnd s) rfl rfl (by decide) hnt (anvEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof anvCtx anvEntry 2 [anvCvA, anvCvB, anvLoad] anvJmp anvCvA
               [anvCvB, anvLoad, anvJmp] s (anvEntrySEnd s) rfl rfl (by decide) hnt (anvEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof anvCtx anvEntry 3 [anvCvA, anvCvB, anvLoad] anvJmp anvCvA
               [anvCvB, anvLoad, anvJmp] s (anvEntrySEnd s) rfl rfl (by decide) hnt (anvEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([anvCvA, anvCvB, anvLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [anvCvA, anvCvB, anvLoad]) (jmpInst := anvJmp) (hd := anvCvA) (tl := [anvCvB, anvLoad, anvJmp])
