        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (anvNextSEnd s (EvmYul.UInt256.ofNat 0) (anvVal s))
            = lookupVar "a" (anvNextSEnd s (EvmYul.UInt256.ofNat 0) (anvVal s)) from rfl,
