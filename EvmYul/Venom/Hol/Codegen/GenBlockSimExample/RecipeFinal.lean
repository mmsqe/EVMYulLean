/-! ### ✅ A 0-input READ (CHAINID) via the recipe route — `codegen_correct_chdFn_recipeW`

The environment read `CHAINID`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_chainid_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). CHAINID carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = CHAINID ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`CHAINID` is a 0-input read (`fV v = v.txCtx.chainid`), emitted as a bare `CHAINID` push,
leaving `[a, b, c]` with `c = chdVal s` (the chain id — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`chdNext_ready`). -/

def chdCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def chdCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def chdLoad : Instruction :=
  { id := 2, opcode := Opcode.CHAINID, operands := [], outputs := ["c"] }
def chdJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def chdMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def chdRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def chdEntry : BasicBlock := { label := "entry", instructions := [chdCvA, chdCvB, chdLoad, chdJmp] }
def chdNext : BasicBlock := { label := "next", instructions := [chdMul, chdRet] }
def chdFn : IrFunction := { name := "main", blocks := [chdEntry, chdNext] }
def chdCtx : VenomContext := { functions := [chdFn], entry := some "main" }

theorem chd_unresolved_asm : executePlan (generateFnPlan chdFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "CHAINID", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word CHAINID pushes (the chain id); context-dependent, generally NON-zero. -/
abbrev chdVal (s : VenomState) : bytes32 := s.txCtx.chainid

/-- entry's body `[CV a; CV b; CHAINID]` as a `RegularBodyH`: two `cv_step`s then the
    CHAINID push via `RegularStepG`'s 0-input read arm (`asmStep_chainid_ok`), output live. -/
theorem chdEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1 1 [chdCvA, chdCvB, chdLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "CHAINID", (fun v : VenomState => v.txCtx.chainid),
     (fun s : AsmState => s.txCtx.chainid),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_chainid_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, hcc, _, _, _⟩ := hrel
       show s.txCtx.chainid = v.txCtx.chainid
       rw [hcc]⟩)))))

/-- Body-end state of `chdEntry`: `a,b := callvalue`, `c := chdVal s` (the chain id). -/
abbrev chdEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (chdVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem chdEntry_thread (s : VenomState) :
    execBodyThread [chdCvA, chdCvB, chdLoad] 0 { s with instIdx := 0 } = some (chdEntrySEnd s) := by
  have hsub : stepInstBase chdLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (chdVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [chdLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase chdCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase chdCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase chdCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [chdCvB, chdLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (chdEntrySEnd s)
  rw [h1]
  show (match stepInstBase chdCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [chdLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (chdEntrySEnd s)
  rw [h2]
  show (match stepInstBase chdLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (chdEntrySEnd s)
  rw [hsub]
  rfl

/-- `chdEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem chdEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) chdCtx chdEntry s = ExecResult.OK (jumpTo "next" (chdEntrySEnd s)) :=
  runBlock_body_jmp chdCtx chdEntry j [chdCvA, chdCvB, chdLoad] chdJmp chdCvA [chdCvB, chdLoad, chdJmp] s
    (chdEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (chdEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem chdNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg chdFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([chdMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := chdFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev chdNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem chdNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (chdNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (chdNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem chdNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [chdMul] 0 { s with instIdx := 0 } = some (chdNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase chdMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := chdMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase chdMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem chdMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase chdMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [chdMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem chdMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase chdMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [chdMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem chdNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) chdCtx chdNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (chdNextSEnd s wb wc))
        (chdNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := chdNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return chdCtx chdNext j [chdMul] chdRet chdMul [chdRet] s (chdNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (chdNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem chdNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) chdCtx chdNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := chdNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term chdCtx chdNext j [chdMul] chdRet chdMul [chdRet] s (chdNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (chdNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : chdNext.instructions = [chdMul] ++ [chdRet])
    (chdNext_thread s wb wc hb hc), chdRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `chdEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem chdEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (chdEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (chdEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (chdEntrySEnd s) = some (chdVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (chdVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (chdVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (chdVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def chdInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (chdVal s))

theorem chdInv_pres : ∀ bb ∈ chdFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    chdInv s → runBlock f' chdCtx bb s = ExecResult.OK s' → chdInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [chdFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (chdEntrySEnd s)`
    have hnt : ∀ inst ∈ [chdCvA, chdCvB, chdLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof chdCtx chdEntry 0 [chdCvA, chdCvB, chdLoad] chdJmp chdCvA
             [chdCvB, chdLoad, chdJmp] s (chdEntrySEnd s) rfl rfl (by decide) hnt (chdEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof chdCtx chdEntry 1 [chdCvA, chdCvB, chdLoad] chdJmp chdCvA
             [chdCvB, chdLoad, chdJmp] s (chdEntrySEnd s) rfl rfl (by decide) hnt (chdEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof chdCtx chdEntry 2 [chdCvA, chdCvB, chdLoad] chdJmp chdCvA
             [chdCvB, chdLoad, chdJmp] s (chdEntrySEnd s) rfl rfl (by decide) hnt (chdEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof chdCtx chdEntry 3 [chdCvA, chdCvB, chdLoad] chdJmp chdCvA
             [chdCvB, chdLoad, chdJmp] s (chdEntrySEnd s) rfl rfl (by decide) hnt (chdEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, chdEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := chdEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (chdEntrySEnd s)) = lookupVar "c" (chdEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 chdCtx chdNext s chdMul [chdRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error chdCtx chdNext chdMul [chdRet] s "undefined operand" j rfl
          (by decide) (chdMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 chdCtx chdNext s chdMul [chdRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error chdCtx chdNext chdMul [chdRet] s "undefined operand" j rfl
            (by decide) (chdMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 chdCtx chdNext s chdMul [chdRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof chdCtx chdNext 1 [chdMul] chdRet chdMul [chdRet] s
                   (chdNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (chdNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, chdNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 chdCtx chdNext s chdMul [chdRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof chdCtx chdNext 1 [chdMul] chdRet chdMul [chdRet] s
                   (chdNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (chdNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, chdNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 chdCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem chdFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 chdCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 chdCtx vs
      = runBlocks 10 chdCtx chdFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, chdCtx, chdFn, lookupFunction, fnEntryLabel, chdEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (chdEntrySEnd s0) with hs1
  have hentry : runBlock 9 chdCtx chdEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact chdEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb chdFn.blocks = some chdEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 chdCtx chdFn s0 = runBlocks 9 chdCtx chdFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := chdEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (chdVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (chdEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb chdFn.blocks = some chdNext := rfl
  have hhalt := chdNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (chdVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (CHAINID) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=CHAINID ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s CHAINID exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_chainid_ok`) as a whole-function capstone — a bare `CHAINID`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = chdVal s` (the chain id,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_chdFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 chdCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ chdFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [chdFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [chdEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl | rfl | rfl <;> (unfold codegenReadyInst; decide)
    · simp only [chdNext, List.mem_cons, List.not_mem_nil, or_false] at hinst
      rcases hinst with rfl | rfl <;> (unfold codegenReadyInst; decide)
  have hgen : generateFnPlan chdFn 0 0
      = some ((generateFnPlan chdFn 0 0).get!.1, (generateFnPlan chdFn 0 0).get!.2) := rfl
  have hpsE : psOfFn (fnPlanFuel chdFn) chdFn 0 0 "entry" = initPlanState 0 :=
    psOfFn_entry rfl hfnready (by simp only [fnPlanFuel]; omega)
  refine codegen_correct_ofBlocks_recipeW_inv chdInv
    (lo := lo) (pcOf := pcOfLabel (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1)
    (psOf := psOfFn (fnPlanFuel chdFn) chdFn 0 0)
    (wOf := fun l => (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1 l)
    (offsets := (computeLabelOffsets (executePlan (generateFnPlan chdFn 0 0).get!.1)).2)
    (fuel := 10) (ctx := chdCtx) (fn := chdFn) (fnEom := 0) (lblCtr := 0)
    (entryName := "main") (entryLbl := "entry")
    (ops := (generateFnPlan chdFn 0 0).get!.1) (psFinal := (generateFnPlan chdFn 0 0).get!.2)
    hgen rfl rfl rfl ?_ ?_ chdInv_pres ?_
    ⟨by simpa using hvshalt, by simpa using hzero, fun h => by simp at h⟩
  case _ =>
    intro bb hbb s
    simp only [chdFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp [runBlock, evalPhis, execBlock, chdEntry, chdCvA]
    · simp [runBlock, evalPhis, execBlock, chdNext, chdMul]
  case _ =>
    intro bb hbb s asm N k hE hinv hlbleq
    obtain ⟨⟨bb0, hlk_s, hvrel, hpc_asm⟩, hwN, hhalt⟩ := hE
    simp only [chdFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · -- entry: CALLVALUE ×2 + ADD (duplicating) + JMP next
      have hlbl : s.currentBb = "entry" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      have hpc0 : asm.pc = 0 := by rw [hpc_asm]; exact pcOfLabel_entry_zero rfl hfnready hgen
      have hnt : ∀ inst ∈ [chdCvA, chdCvB, chdLoad], isTerminator inst.opcode = false := by
        intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide
      match k with
      | 0 => exact Or.inl (runBlock_oof chdCtx chdEntry 1 [chdCvA, chdCvB, chdLoad] chdJmp chdCvA
               [chdCvB, chdLoad, chdJmp] s (chdEntrySEnd s) rfl rfl (by decide) hnt (chdEntry_thread s) (by decide))
      | 1 => exact Or.inl (runBlock_oof chdCtx chdEntry 2 [chdCvA, chdCvB, chdLoad] chdJmp chdCvA
               [chdCvB, chdLoad, chdJmp] s (chdEntrySEnd s) rfl rfl (by decide) hnt (chdEntry_thread s) (by decide))
      | 2 => exact Or.inl (runBlock_oof chdCtx chdEntry 3 [chdCvA, chdCvB, chdLoad] chdJmp chdCvA
               [chdCvB, chdLoad, chdJmp] s (chdEntrySEnd s) rfl rfl (by decide) hnt (chdEntry_thread s) (by decide))
      | (j+3) =>
      rw [show j+3+1 = ([chdCvA, chdCvB, chdLoad] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularJmp
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [chdCvA, chdCvB, chdLoad]) (jmpInst := chdJmp) (hd := chdCvA) (tl := [chdCvB, chdLoad, chdJmp])
        (nextLiveness := ["a", "b", "c"]) (curBbLabel := "entry") (dem := 1) (S := [])
        (ps0 := initPlanState 0) (lbl := "next") (off := 8) (bb' := chdNext) (sEnd := chdEntrySEnd s)
        (hbb := rfl) (hjmpop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := hnt) (hthread := chdEntry_thread s) (hnothalt := by simpa [updateVar] using hhalt)
        (hreg := chdEntry_body)
        (hsd := ⟨by intro op; rfl, by simp [initPlanState], by intro z hz; simp [initPlanState] at hz⟩)
        (hsv := by simp [StackIsVars, initPlanState])
        (hrel := by rw [hpsE] at hvrel; exact hvrel)
        (hbLabel := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc0]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 3 := hj; interval_cases j <;> rfl)
        (hps := rfl) (hpc := by rw [hpc0]; decide) (hpush := by simp only [hpc0]; rfl)
        (hoff_lk := by decide)
        (hoff := by decide) (hpc2 := by rw [hpc0]; decide)
        (hjump := by simp only [hpc0]; rfl)
        (hidx_lk := by decide) (hlk' := rfl)
        (hw := by decide))
    · -- next: the CONSUMING ADD + body-then-RETURN
      have hlbl : s.currentBb = "next" := hlbleq
      rw [hlbl] at hvrel hpc_asm
      obtain ⟨_, _, hnext⟩ := hinv
      obtain ⟨ha0, hb0, hc0⟩ := hnext hlbl
      have hpc6 : asm.pc = 6 := by rw [hpc_asm]; decide
      match k with
      | 0 => exact Or.inl (runBlock_oof chdCtx chdNext 1 [chdMul] chdRet chdMul [chdRet] s
               (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s)) rfl rfl (by decide)
               (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
               (chdNext_thread s _ _ hb0 hc0) (by decide))
      | (j+1) =>
      rw [show j+1+1 = ([chdMul] : List Instruction).length + (j+1) from by
        simp only [List.length_cons, List.length_nil]; omega]
      refine Or.inr (hsupplyW_regularReturnTo
        (liveness := exLiveness) (dfg := DfgAnalysis.empty) (cfg := exCfg) (restFuel := j)
        (front := [chdMul]) (retInst := chdRet) (hd := chdMul) (tl := [chdRet])
        (nextLiveness := ["e", "a"]) (curBbLabel := "next") (dem := 1)
        (S := ["a", "b", "c"]) (Sn := ["a", "e"])
        (ps0 := psOfFn (fnPlanFuel chdFn) chdFn 0 0 "next") (offv := "e") (szv := "a") (base := [])
        (woff := EvmYul.UInt256.ofNat 0) (wsz := EvmYul.UInt256.ofNat 0)
        (sEnd := chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s))
        (hbb := rfl) (hop := rfl) (hoperands := rfl) (hcons := rfl) (hphi := by decide)
        (hnonterm := by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
        (hthread := chdNext_thread s _ _ hb0 hc0)
        (hevaloff := by rw [show evalOperand (Operand.Var "e")
              (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s))
            = lookupVar "e" (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s)) from rfl,
            (chdNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (chdVal s)).1, uint256_zero_mul])
        (hevalsz := by rw [show evalOperand (Operand.Var "a")
              (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s))
            = lookupVar "a" (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s)) from rfl,
            (chdNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (chdVal s)).2]; exact ha0)
        (hvoff := by rw [show operandVal (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s)) lo
              (Operand.Var "e")
            = lookupVar "e" (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s)) from rfl,
            (chdNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (chdVal s)).1, uint256_zero_mul])
        (hvsz := by rw [show operandVal (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s)) lo
              (Operand.Var "a")
            = lookupVar "a" (chdNextSEnd s (EvmYul.UInt256.ofNat 0) (chdVal s)) from rfl,
            (chdNextSEnd_lookup s (EvmYul.UInt256.ofNat 0) (chdVal s)).2]; exact ha0)
        (hready := chdNext_ready)
        (hsd := ⟨by intro op; rfl, by decide, by
          intro z hz
          rw [show (psOfFn (fnPlanFuel chdFn) chdFn 0 0 "next").stack
            = [Operand.Var "a", Operand.Var "b", Operand.Var "c"] from rfl] at hz
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
          rcases hz with h | h | h <;> injection h with h' <;> subst h'
          · exact ⟨_, ha0⟩
          · exact ⟨_, hb0⟩
          · exact ⟨_, hc0⟩⟩)
        (hsv := rfl)
        (hrel := hvrel)
        (hbLabel := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                       have hj' : j < 1 := hj; interval_cases j; rfl)
        (hblock := by rw [hpc6]; refine ⟨by decide, fun j hj => ?_⟩
                      have hj' : j < 1 := hj; interval_cases j; rfl)
        (hps'stack := by decide)
        (hpc := by rw [hpc6]; decide) (hret := by simp only [hpc6]; rfl)
        (hcov0 := Or.inl (by simp [EvmYul.uint256_ofNat_toNat]))
        (hbelow := by simp [EvmYul.uint256_ofNat_toNat])
        (hlenu := by simp [EvmYul.uint256_ofNat_toNat]) (hw := by decide))
  case _ =>
    refine ⟨⟨chdEntry, rfl, ?_, ?_⟩, ?_, hvshalt⟩
    · show venomAsmRel lo (psOfFn (fnPlanFuel chdFn) chdFn 0 0 "entry") _ as
      rw [hpsE]; exact hrel
    · show as.pc = pcOfLabel (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1 "entry"
      rw [haspc]; exact (pcOfLabel_entry_zero rfl hfnready hgen).symm
    · show (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1.length - pcOfLabel (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1 "entry" ≤ (asmResolve (executePlan (generateFnPlan chdFn 0 0).get!.1)).1.length
      omega


/-! ### ✅ A 0-input READ (COINBASE) via the recipe route — `codegen_correct_cbsFn_recipeW`

The environment read `COINBASE`, exercising `RegularStepG`'s generic 0-input read arm (the 6th disjunct,
`∃ out name fV fA`, `asmStep_coinbase_ok`) as a WHOLE-FUNCTION capstone — that arm was previously only
witnessed by the bespoke `cv_step` helper (CALLVALUE, always value 0). COINBASE carries a NON-zero output,
and its emit has no operand-delivery `DUP` (a 9-instruction program vs the reads' 10):

```
entry:  %a = CALLVALUE ; %b = CALLVALUE ; %c = COINBASE ; JMP next   -- a,b,c all live → delivered
next:   %e = MUL %b %c ; RETURN %e, %a                             -- MUL consumes the TOP two (b,c)
```

`COINBASE` is a 0-input read (`fV v = addressToWord v.blockCtx.coinbase`), emitted as a bare `COINBASE` push,
leaving `[a, b, c]` with `c = cbsVal s` (the coinbase address — context-dependent, generally NON-zero, so
`c` cannot itself be a RETURN operand). In `next` the consuming `MUL %b %c` eats the top two (`b, c`);
since `b = 0`, `e = 0 * c = 0` (via `uint256_zero_mul`, regardless of `c`), emptying the return window.
`a` (bottom) is never buried — no f1a reorder. `entry` via `hsupplyW_regularJmp`, `next` via
`hsupplyW_regularReturnTo` fed the consuming `MUL` (`cbsNext_ready`). -/

def cbsCvA : Instruction := { id := 0, opcode := Opcode.CALLVALUE, operands := [], outputs := ["a"] }
def cbsCvB : Instruction := { id := 1, opcode := Opcode.CALLVALUE, operands := [], outputs := ["b"] }
def cbsLoad : Instruction :=
  { id := 2, opcode := Opcode.COINBASE, operands := [], outputs := ["c"] }
def cbsJmp : Instruction := { id := 3, opcode := Opcode.JMP, operands := [Operand.Label "next"], outputs := [] }
def cbsMul : Instruction :=
  { id := 4, opcode := Opcode.MUL, operands := [Operand.Var "b", Operand.Var "c"], outputs := ["e"] }
def cbsRet : Instruction :=
  { id := 5, opcode := Opcode.RETURN, operands := [Operand.Var "e", Operand.Var "a"], outputs := [] }
def cbsEntry : BasicBlock := { label := "entry", instructions := [cbsCvA, cbsCvB, cbsLoad, cbsJmp] }
def cbsNext : BasicBlock := { label := "next", instructions := [cbsMul, cbsRet] }
def cbsFn : IrFunction := { name := "main", blocks := [cbsEntry, cbsNext] }
def cbsCtx : VenomContext := { functions := [cbsFn], entry := some "main" }

theorem cbs_unresolved_asm : executePlan (generateFnPlan cbsFn 0 0).get!.1 =
    [AsmInst.AsmLabel "entry", AsmInst.AsmOp "CALLVALUE", AsmInst.AsmOp "CALLVALUE",
     AsmInst.AsmOp "COINBASE", AsmInst.AsmPushLabel "next",
     AsmInst.AsmOp "JUMP", AsmInst.AsmLabel "next", AsmInst.AsmOp "MUL", AsmInst.AsmOp "RETURN"] := by rfl

/-- The word COINBASE pushes (the block coinbase address, zero-extended); context-dependent, generally NON-zero. -/
abbrev cbsVal (s : VenomState) : bytes32 := addressToWord s.blockCtx.coinbase

/-- entry's body `[CV a; CV b; COINBASE]` as a `RegularBodyH`: two `cv_step`s then the
    COINBASE push via `RegularStepG`'s 0-input read arm (`asmStep_coinbase_ok`), output live. -/
theorem cbsEntry_body {lo : AssocList String Nat} {offsetToPc : AssocList Nat Nat} :
    RegularBodyH lo ["a", "b", "c"] offsetToPc
      (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1 1 [cbsCvA, cbsCvB, cbsLoad] [] := by
  refine ⟨cv_step (out := "a") (S := []) rfl (by decide) (by decide),
          cv_step (out := "b") (S := ["a"]) rfl (by decide) (by decide), ?_, trivial⟩
  refine Or.inl ⟨?_, by decide⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
    ⟨"c", "COINBASE", (fun v : VenomState => addressToWord v.blockCtx.coinbase),
     (fun s : AsmState => addressToWord s.blockCtx.coinbase),
     rfl, by decide, rfl, rfl, rfl, by decide, by decide, fun _ => rfl,
     (fun _ h hg => asmStep_coinbase_ok h hg),
     fun _ v s hrel => by
       obtain ⟨_, _, _, _, _, _, _, _, _, hcc, _, _⟩ := hrel
       show addressToWord s.blockCtx.coinbase = addressToWord v.blockCtx.coinbase
       rw [hcc]⟩)))))

/-- Body-end state of `cbsEntry`: `a,b := callvalue`, `c := cbsVal s` (the coinbase address). -/
abbrev cbsEntrySEnd (s : VenomState) : VenomState :=
  { updateVar "c" (cbsVal s)
      { updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 }
    with instIdx := 3 }

theorem cbsEntry_thread (s : VenomState) :
    execBodyThread [cbsCvA, cbsCvB, cbsLoad] 0 { s with instIdx := 0 } = some (cbsEntrySEnd s) := by
  have hsub : stepInstBase cbsLoad ({ updateVar "b" s.callCtx.callvalue
        { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
      with instIdx := 2 } : VenomState) = ExecResult.OK (updateVar "c" (cbsVal s)
        ({ updateVar "b" s.callCtx.callvalue
          { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
        with instIdx := 2 })) := by
    simp only [cbsLoad, stepInstBase, execRead0]
    rfl
  have h1 : stepInstBase cbsCvA { s with instIdx := 0 }
      = ExecResult.OK (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }) := rfl
  have h2 : stepInstBase cbsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
        with instIdx := 1 } : VenomState)
      = ExecResult.OK (updateVar "b" s.callCtx.callvalue
          ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 })) := rfl
  show (match stepInstBase cbsCvA { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [cbsCvB, cbsLoad] 1 { s' with instIdx := 1 }
        | _ => none) = some (cbsEntrySEnd s)
  rw [h1]
  show (match stepInstBase cbsCvB ({ updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }
          with instIdx := 1 }) with
        | ExecResult.OK s' => execBodyThread [cbsLoad] 2 { s' with instIdx := 2 }
        | _ => none) = some (cbsEntrySEnd s)
  rw [h2]
  show (match stepInstBase cbsLoad ({ updateVar "b" s.callCtx.callvalue
            { updateVar "a" s.callCtx.callvalue { s with instIdx := 0 } with instIdx := 1 }
          with instIdx := 2 }) with
        | ExecResult.OK s' => execBodyThread [] 3 { s' with instIdx := 3 }
        | _ => none) = some (cbsEntrySEnd s)
  rw [hsub]
  rfl

/-- `cbsEntry`'s OK result is `jumpTo "next"` of the body-end state (fuel ≥ 4). -/
theorem cbsEntry_runBlock (s : VenomState) (j : Nat) (hnh : s.halted = false) :
    runBlock (3 + (j + 1)) cbsCtx cbsEntry s = ExecResult.OK (jumpTo "next" (cbsEntrySEnd s)) :=
  runBlock_body_jmp cbsCtx cbsEntry j [cbsCvA, cbsCvB, cbsLoad] cbsJmp cbsCvA [cbsCvB, cbsLoad, cbsJmp] s
    (cbsEntrySEnd s) "next" rfl rfl rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
        rcases hi with rfl | rfl | rfl <;> decide)
    (cbsEntry_thread s) (by simpa [updateVar] using hnh)

/-- `next`'s consuming `MUL %b %c` (mirror order, `bytes32_mul_comm`) as a `BodyStepsReadyHTo`:
    it eats the top two `[b, c]` off the entry stack `[a, b, c]`, leaving `[a, e]`. -/
theorem cbsNext_ready {lo : AssocList String Nat} :
    BodyStepsReadyHTo lo (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).2
      (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1
      (fun z p => generateRegularInstPlan exLiveness DfgAnalysis.empty exCfg cbsFn z.1
        ["e", "a"] false true "next" p)
      (fun _ => 1) ([cbsMul].zipIdx 0) ["a", "b", "c"] ["a", "e"] :=
  bodyStepsReadyHTo_singleton
    (bodyStepHTo_commBinopDeadMirror (liveness := exLiveness) (dfg := DfgAnalysis.empty)
      (cfg := exCfg) (fn := cbsFn) (curBbLabel := "next") (base := ["a"]) (x := "b") (y := "c")
      (out := "e") (idx := 0)
      rfl (by decide) bytes32_mul_comm (fun _ => rfl) rfl rfl (by decide) (by decide) (by decide)
      (by decide) (by decide) (fun _ h hg => asmStep_mul_ok h hg))

abbrev cbsNextSEnd (s : VenomState) (wb wc : bytes32) : VenomState :=
  { updateVar "e" (wb * wc) { s with instIdx := 0 } with instIdx := 1 }

theorem cbsNextSEnd_lookup (s : VenomState) (wb wc : bytes32) :
    lookupVar "e" (cbsNextSEnd s wb wc) = some (wb * wc)
    ∧ lookupVar "a" (cbsNextSEnd s wb wc) = lookupVar "a" s := by
  refine ⟨lookupVar_updateVar_self _ _ _, ?_⟩
  show lookupVar "a" (updateVar "e" (wb * wc) { s with instIdx := 0 }) = _
  rw [lookupVar_updateVar_ne _ _ _ _ (by decide)]; rfl

theorem cbsNext_thread (s : VenomState) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) :
    execBodyThread [cbsMul] 0 { s with instIdx := 0 } = some (cbsNextSEnd s wb wc) := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = some wc := hc
  have hstep : stepInstBase cbsMul { s with instIdx := 0 }
      = ExecResult.OK (updateVar "e" (wb * wc) { s with instIdx := 0 }) :=
    stepInstBase_binopVar (inst := cbsMul) (f := fun a b => a * b) (x := "b") (y := "c")
      (out := "e") rfl rfl rfl hb' hc'
  show (match stepInstBase cbsMul { s with instIdx := 0 } with
        | ExecResult.OK s' => execBodyThread [] 1 { s' with instIdx := 1 } | _ => none) = _
  rw [hstep]; rfl

/-- The MUL errors when `b` is undefined (the shape `runBlock_body_head_error` consumes). -/
theorem cbsMul_error_b (s : VenomState) (hb : lookupVar "b" s = none) :
    stepInstBase cbsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = none := hb
  simp [cbsMul, stepInstBase, execPure2, evalOperand, hb']

/-- The MUL errors when `c` is undefined (given `b` defined). -/
theorem cbsMul_error_c (s : VenomState) (wb : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = none) :
    stepInstBase cbsMul { s with instIdx := 0 } = ExecResult.Error "undefined operand" := by
  have hb' : lookupVar "b" { s with instIdx := 0 } = some wb := hb
  have hc' : lookupVar "c" { s with instIdx := 0 } = none := hc
  simp [cbsMul, stepInstBase, execPure2, evalOperand, hb', hc']

/-- `next` halts when `a, b, c` are all defined: ADD then RETURN reads `e = b+c` and `a`. -/
theorem cbsNext_halts (s : VenomState) (j : Nat) (wb wc wa : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc)
    (ha : lookupVar "a" s = some wa) :
    runBlock (1 + (j + 1)) cbsCtx cbsNext s = ExecResult.Halt
      (haltState (setReturndata (readMemory (wb * wc).toNat wa.toNat (cbsNextSEnd s wb wc))
        (cbsNextSEnd s wb wc))) := by
  obtain ⟨he, haa⟩ := cbsNextSEnd_lookup s wb wc
  rw [ha] at haa
  exact runBlock_body_return cbsCtx cbsNext j [cbsMul] cbsRet cbsMul [cbsRet] s (cbsNextSEnd s wb wc)
    (Operand.Var "e") (Operand.Var "a") (wb * wc) wa rfl rfl rfl he haa rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (cbsNext_thread s wb wc hb hc)

/-- `next` errors when `a` is undefined (given `b, c` defined): ADD succeeds, RETURN faults on `a`. -/
theorem cbsNext_error_a (s : VenomState) (j : Nat) (wb wc : bytes32)
    (hb : lookupVar "b" s = some wb) (hc : lookupVar "c" s = some wc) (ha : lookupVar "a" s = none) :
    runBlock (1 + (j + 1)) cbsCtx cbsNext s = ExecResult.Error "return: undefined operand" := by
  obtain ⟨he, haa⟩ := cbsNextSEnd_lookup s wb wc
  rw [ha] at haa
  refine runBlock_body_term cbsCtx cbsNext j [cbsMul] cbsRet cbsMul [cbsRet] s (cbsNextSEnd s wb wc)
    (ExecResult.Error "return: undefined operand") rfl rfl (by decide)
    (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
    (cbsNext_thread s wb wc hb hc) ?_
  intro inst hget
  simp [execBlock, getInstruction_bodyEnd (by rfl : cbsNext.instructions = [cbsMul] ++ [cbsRet])
    (cbsNext_thread s wb wc hb hc), cbsRet, stepInstBase, evalOperand, he, haa, isExternalCall]

/-- lookupVar of `cbsEntrySEnd`: `a, b` are the call value, `c = callvalue - callvalue`. -/
theorem cbsEntrySEnd_lookup (s : VenomState) :
    lookupVar "a" (cbsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "b" (cbsEntrySEnd s) = some s.callCtx.callvalue
    ∧ lookupVar "c" (cbsEntrySEnd s) = some (cbsVal s) := by
  refine ⟨?_, ?_, ?_⟩
  · show lookupVar "a" (updateVar "c" (cbsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_ne _ _ _ _ (by decide),
      lookupVar_updateVar_self]
  · show lookupVar "b" (updateVar "c" (cbsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_ne _ _ _ _ (by decide), lookupVar_updateVar_self]
  · show lookupVar "c" (updateVar "c" (cbsVal s)
      (updateVar "b" s.callCtx.callvalue (updateVar "a" s.callCtx.callvalue { s with instIdx := 0 }))) = _
    rw [lookupVar_updateVar_self]

/-- The invariant: unhalted, zero call value, and at `next` the delivered `a, b, c` are all zero. -/
def cbsInv (s : VenomState) : Prop :=
  s.halted = false ∧ s.callCtx.callvalue = EvmYul.UInt256.ofNat 0 ∧
  (s.currentBb = "next" → lookupVar "a" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "b" s = some (EvmYul.UInt256.ofNat 0)
                        ∧ lookupVar "c" s = some (cbsVal s))

theorem cbsInv_pres : ∀ bb ∈ cbsFn.blocks, ∀ (s s' : VenomState) (f' : Nat),
    cbsInv s → runBlock f' cbsCtx bb s = ExecResult.OK s' → cbsInv s' := by
  intro bb hbb s s' f' hinv hrun
  obtain ⟨hnh, hcv, _⟩ := hinv
  simp only [cbsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
  rcases hbb with rfl | rfl
  · -- entry: fuel ≤ 3 is out-of-fuel (Error); fuel ≥ 4 lands on `jumpTo "next" (cbsEntrySEnd s)`
    have hnt : ∀ inst ∈ [cbsCvA, cbsCvB, cbsLoad], isTerminator inst.opcode = false := by
      intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl <;> decide
    match f' with
    | 0 => obtain ⟨e, he⟩ := runBlock_oof cbsCtx cbsEntry 0 [cbsCvA, cbsCvB, cbsLoad] cbsJmp cbsCvA
             [cbsCvB, cbsLoad, cbsJmp] s (cbsEntrySEnd s) rfl rfl (by decide) hnt (cbsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 1 => obtain ⟨e, he⟩ := runBlock_oof cbsCtx cbsEntry 1 [cbsCvA, cbsCvB, cbsLoad] cbsJmp cbsCvA
             [cbsCvB, cbsLoad, cbsJmp] s (cbsEntrySEnd s) rfl rfl (by decide) hnt (cbsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 2 => obtain ⟨e, he⟩ := runBlock_oof cbsCtx cbsEntry 2 [cbsCvA, cbsCvB, cbsLoad] cbsJmp cbsCvA
             [cbsCvB, cbsLoad, cbsJmp] s (cbsEntrySEnd s) rfl rfl (by decide) hnt (cbsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | 3 => obtain ⟨e, he⟩ := runBlock_oof cbsCtx cbsEntry 3 [cbsCvA, cbsCvB, cbsLoad] cbsJmp cbsCvA
             [cbsCvB, cbsLoad, cbsJmp] s (cbsEntrySEnd s) rfl rfl (by decide) hnt (cbsEntry_thread s) (by decide)
           rw [he] at hrun; exact absurd hrun (by simp)
    | (j+4) =>
      rw [show j+4 = 3+(j+1) from by omega, cbsEntry_runBlock s j hnh] at hrun
      injection hrun with h; subst h
      obtain ⟨ha0, hb0, hc0⟩ := cbsEntrySEnd_lookup s
      rw [hcv] at ha0 hb0
      refine ⟨by simpa [jumpTo, updateVar] using hnh, by simp [jumpTo, updateVar, hcv], fun _ => ⟨ha0, hb0, ?_⟩⟩
      rw [show lookupVar "c" (jumpTo "next" (cbsEntrySEnd s)) = lookupVar "c" (cbsEntrySEnd s) from rfl, hc0]
      rfl
  · -- next: RETURN never yields OK (ADD errors on undefined b/c, RETURN errors on undefined a, else Halt)
    rcases hlb : lookupVar "b" s with _ | wb
    · match f' with
      | 0 => rw [runBlock_no_phi 0 cbsCtx cbsNext s cbsMul [cbsRet] rfl (by decide)] at hrun
             simp [execBlock] at hrun
      | (j+1) =>
        rw [runBlock_body_head_error cbsCtx cbsNext cbsMul [cbsRet] s "undefined operand" j rfl
          (by decide) (cbsMul_error_b s hlb) (by decide) (by decide)] at hrun
        exact absurd hrun (by simp)
    · rcases hlc : lookupVar "c" s with _ | wc
      · match f' with
        | 0 => rw [runBlock_no_phi 0 cbsCtx cbsNext s cbsMul [cbsRet] rfl (by decide)] at hrun
               simp [execBlock] at hrun
        | (j+1) =>
          rw [runBlock_body_head_error cbsCtx cbsNext cbsMul [cbsRet] s "undefined operand" j rfl
            (by decide) (cbsMul_error_c s wb hlb hlc) (by decide) (by decide)] at hrun
          exact absurd hrun (by simp)
      · rcases hla : lookupVar "a" s with _ | wa
        · match f' with
          | 0 => rw [runBlock_no_phi 0 cbsCtx cbsNext s cbsMul [cbsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof cbsCtx cbsNext 1 [cbsMul] cbsRet cbsMul [cbsRet] s
                   (cbsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (cbsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, cbsNext_error_a s j wb wc hlb hlc hla] at hrun
            exact absurd hrun (by simp)
        · match f' with
          | 0 => rw [runBlock_no_phi 0 cbsCtx cbsNext s cbsMul [cbsRet] rfl (by decide)] at hrun
                 simp [execBlock] at hrun
          | 1 => obtain ⟨e, he⟩ := runBlock_oof cbsCtx cbsNext 1 [cbsMul] cbsRet cbsMul [cbsRet] s
                   (cbsNextSEnd s wb wc) rfl rfl (by decide)
                   (by intro i hi; simp only [List.mem_singleton] at hi; subst hi; decide)
                   (cbsNext_thread s wb wc hlb hlc) (by decide)
                 rw [he] at hrun; exact absurd hrun (by simp)
          | (j+2) =>
            rw [show j+2 = 1+(j+1) from by omega, cbsNext_halts s j wb wc wa hlb hlc hla] at hrun
            exact absurd hrun (by simp)

/-- **Non-vacuity**: `runContext 10 cbsCtx vs` halts for every admitted state (callvalue zero).
    Chains `entry → next`, ending in `next`'s RETURN halt. -/
theorem cbsFn_halts (vs : VenomState) (hnh : vs.halted = false)
    (hcv : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0) :
    ∃ vs', runContext 10 cbsCtx vs = ExecResult.Halt vs' := by
  have h0 : runContext 10 cbsCtx vs
      = runBlocks 10 cbsCtx cbsFn { vs with prevBb := none, currentBb := "entry", instIdx := 0 } := by
    simp [runContext, runFunction, cbsCtx, cbsFn, lookupFunction, fnEntryLabel, cbsEntry]
  set s0 : VenomState := { vs with prevBb := none, currentBb := "entry", instIdx := 0 } with hs0
  have hnh0 : s0.halted = false := by simpa [hs0] using hnh
  have hcv0 : s0.callCtx.callvalue = EvmYul.UInt256.ofNat 0 := by simpa [hs0] using hcv
  set s1 : VenomState := jumpTo "next" (cbsEntrySEnd s0) with hs1
  have hentry : runBlock 9 cbsCtx cbsEntry s0 = ExecResult.OK s1 := by
    rw [show (9 : Nat) = 3 + (5 + 1) from by omega]; exact cbsEntry_runBlock s0 5 hnh0
  have hlk0 : lookupBlock s0.currentBb cbsFn.blocks = some cbsEntry := rfl
  have hnh1 : s1.halted = false := by rw [hs1]; simpa [jumpTo, updateVar] using hnh0
  have hstep0 : runBlocks 10 cbsCtx cbsFn s0 = runBlocks 9 cbsCtx cbsFn s1 :=
    runBlocks_step_of_block (fuel := 9) hlk0 hentry hnh1
  obtain ⟨ha1, hb1, hc1⟩ := cbsEntrySEnd_lookup s0
  rw [hcv0] at ha1 hb1
  have ha1' : lookupVar "a" s1 = some (EvmYul.UInt256.ofNat 0) := ha1
  have hb1' : lookupVar "b" s1 = some (EvmYul.UInt256.ofNat 0) := hb1
  have hc1' : lookupVar "c" s1 = some (cbsVal s0) := by
    rw [show lookupVar "c" s1 = lookupVar "c" (cbsEntrySEnd s0) from rfl, hc1]
  have hlk1 : lookupBlock s1.currentBb cbsFn.blocks = some cbsNext := rfl
  have hhalt := cbsNext_halts s1 6 (EvmYul.UInt256.ofNat 0) (cbsVal s0)
    (EvmYul.UInt256.ofNat 0) hb1' hc1' ha1'
  rw [show (1 : Nat) + (6 + 1) = 8 from by omega] at hhalt
  rw [h0, hstep0]
  exact ⟨_, runBlocks_haltDirect_of_block hlk1 hhalt⟩

set_option maxHeartbeats 4000000 in
/-- **A 0-input READ (COINBASE) capstone.** `codegen_correct` for
    `entry: %a=CALLVALUE ; %b=CALLVALUE ; %c=COINBASE ; JMP next` /
    `next: %e=MUL %b %c ; RETURN %e, %a`. `entry`'s COINBASE exercises `RegularStepG`'s generic 0-input
    read arm (`∃ out name fV fA`, `asmStep_coinbase_ok`) as a whole-function capstone — a bare `COINBASE`
    push (no operand `DUP`, so a 9-instruction program), leaving `c = cbsVal s` (the coinbase address,
    context-dependent). `next`'s MUL consumes the top two `[b, c]` (so `a` is never buried — no f1a
    reorder); `b = 0` ⇒ `e = 0` (`uint256_zero_mul`) empties the return window. `next` ends in a
    body-then-RETURN handled by `hsupplyW_regularReturnTo`; `entry` via `hsupplyW_regularJmp`. -/
theorem codegen_correct_cbsFn_recipeW {lo : AssocList String Nat} {vs : VenomState} {as : AsmState}
    (hvshalt : vs.halted = false) (hzero : vs.callCtx.callvalue = EvmYul.UInt256.ofNat 0)
    (hrel : venomAsmRel lo (initPlanState 0) vs as) (haspc : as.pc = 0) :
    (match runContext 10 cbsCtx vs with
     | ExecResult.Halt vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1 as = AsmResult.AsmHalt as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.RevertAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1 as = AsmResult.AsmRevert as' ∧ finalStateRel vs' as'
     | ExecResult.Abort AbortType.ExHaltAbort vs' => ∃ as', runAsm (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1.length (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).2 (asmResolve (executePlan (generateFnPlan cbsFn 0 0).get!.1)).1 as = AsmResult.AsmFault as' ∧ finalStateRel vs' as'
     | _ => True) := by
  have hfnready : ∀ bb ∈ cbsFn.blocks, ∀ inst ∈ bb.instructions, codegenReadyInst inst := by
    intro bb hbb inst hinst
    simp only [cbsFn, List.mem_cons, List.not_mem_nil, or_false] at hbb
    rcases hbb with rfl | rfl
    · simp only [cbsEntry, List.mem_cons, List.not_mem_nil, or_false] at hinst
